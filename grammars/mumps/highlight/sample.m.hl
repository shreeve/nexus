> SAMPLE ; Every token and context of M's editor colouring; read, not run
  ^^^^^^ label
         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
>  ;
   ^ comment
> EN(A,B) ; a label with formals
  ^^ label
    ^ punctuation
      ^ punctuation
        ^ punctuation
          ^^^^^^^^^^^^^^^^^^^^^^ comment
>  N X,Y S X=1,Y="say ""hi""" W X,!
   ^ keyword.control
      ^ punctuation
         ^ keyword.control
            ^ operator
             ^ constant.numeric
              ^ punctuation
                ^ operator
                 ^^^^^ string
                      ^^ string.escape
                        ^^ string
                          ^^ string.escape
                            ^ string
                              ^ keyword.control
                                 ^ punctuation
                                  ^ operator
>  S X1=2,A=X1_1,%B=X1 ; names with digits and %
   ^ keyword.control
       ^ operator
        ^ constant.numeric
         ^ punctuation
           ^ operator
              ^ operator
               ^ constant.numeric
                ^ punctuation
                   ^ operator
                       ^^^^^^^^^^^^^^^^^^^^^^^^^ comment
>  S:A>0 ^G(1,"a")=A+B I X=1 W "one",! E  W "other",!
   ^ keyword.control
    ^ punctuation
      ^ operator
       ^ constant.numeric
         ^^ type
           ^ punctuation
            ^ constant.numeric
             ^ punctuation
              ^^^ string
                 ^ punctuation
                  ^ operator
                    ^ operator
                       ^ keyword.control
                          ^ operator
                           ^ constant.numeric
                             ^ keyword.control
                               ^^^^^ string
                                    ^ punctuation
                                     ^ operator
                                       ^ keyword.control
                                          ^ keyword.control
                                            ^^^^^^^ string
                                                   ^ punctuation
                                                    ^ operator
>  Q:'$D(^G(1))  K ^G
   ^ keyword.control
    ^ punctuation
     ^ operator
      ^ punctuation
       ^ function.builtin
        ^ punctuation
         ^^ type
           ^ punctuation
            ^ constant.numeric
             ^^ punctuation
                 ^ keyword.control
                   ^^ type
>  F I=1:1:10 S X=X+I Q:X>20
   ^ keyword.control
      ^ operator
       ^ constant.numeric
        ^ punctuation
         ^ constant.numeric
          ^ punctuation
           ^^ constant.numeric
              ^ keyword.control
                 ^ operator
                   ^ operator
                      ^ keyword.control
                       ^ punctuation
                         ^ operator
                          ^^ constant.numeric
>  . W !,?5,"level one"
     ^ keyword.control
       ^ operator
        ^ punctuation
          ^ constant.numeric
           ^ punctuation
            ^^^^^^^^^^^ string
>  . . W $J(X,6,2),$E("abc",1,2),$P(Y,"^",2)
       ^ keyword.control
         ^ punctuation
          ^ function.builtin
           ^ punctuation
             ^ punctuation
              ^ constant.numeric
               ^ punctuation
                ^ constant.numeric
                 ^^^ punctuation
                    ^ function.builtin
                     ^ punctuation
                      ^^^^^ string
                           ^ punctuation
                            ^ constant.numeric
                             ^ punctuation
                              ^ constant.numeric
                               ^^^ punctuation
                                  ^ function.builtin
                                   ^ punctuation
                                     ^ punctuation
                                      ^^^ string
                                         ^ punctuation
                                          ^ constant.numeric
                                           ^ punctuation
>  S X=$H,Y=$ZH,Z=$T(EN+1^SAMPLE)
   ^ keyword.control
      ^ operator
       ^ punctuation
        ^ variable.special
         ^ punctuation
           ^ operator
            ^ punctuation
             ^^ variable.special
               ^ punctuation
                 ^ operator
                  ^ punctuation
                   ^ function.builtin
                    ^ punctuation
                       ^ operator
                        ^ label
                         ^^^^^^^ type
                                ^ punctuation
>  D TAG^SAMPLE,^SAMPLE G EN^SAMPLE
   ^ keyword.control
     ^^^ label
        ^^^^^^^ type
               ^ punctuation
                ^^^^^^^ type
                        ^ keyword.control
                          ^^ label
                            ^^^^^^^ type
>  S X=$$EXT(1)+$$EXT^SAMPLE(2)
   ^ keyword.control
      ^ operator
       ^^^^^ function
            ^ punctuation
             ^ constant.numeric
              ^ punctuation
               ^ operator
                ^^^^^ function
                     ^^^^^^^ type
                            ^ punctuation
                             ^ constant.numeric
                              ^ punctuation
>  I X?1.3N1"-"2A W "pattern" I X'?.E1"x" W "not"
   ^ keyword.control
      ^ operator
       ^^^^^^^^^^ constant.symbol
                  ^ keyword.control
                    ^^^^^^^^^ string
                              ^ keyword.control
                                 ^^ operator
                                   ^^^^^^ constant.symbol
                                          ^ keyword.control
                                            ^^^^^ string
>  S X=12+3.5-.5*1E3/2\3#4**2_"s",Y=007
   ^ keyword.control
      ^ operator
       ^^ constant.numeric
         ^ operator
          ^^^ constant.numeric
             ^ operator
              ^^ constant.numeric
                ^ operator
                 ^^^ constant.numeric
                    ^ operator
                     ^ constant.numeric
                      ^ operator
                       ^ constant.numeric
                        ^ operator
                         ^ constant.numeric
                          ^^ operator
                            ^ constant.numeric
                             ^ operator
                              ^^^ string
                                 ^ punctuation
                                   ^ operator
                                    ^^^ constant.numeric
>  I X'=1,X'<2,X'>3,X]Y,X]]Y,X']]Y,X[Y W 1
   ^ keyword.control
      ^^ operator
        ^ constant.numeric
         ^ punctuation
           ^^ operator
             ^ constant.numeric
              ^ punctuation
                ^^ operator
                  ^ constant.numeric
                   ^ punctuation
                     ^ operator
                       ^ punctuation
                         ^^ operator
                            ^ punctuation
                              ^^^ operator
                                  ^ punctuation
                                    ^ operator
                                       ^ keyword.control
                                         ^ constant.numeric
>  S @X=1,X=@Y@(2) I X=1!(Y=2)&'Z W 1
   ^ keyword.control
     ^ operator
       ^ operator
        ^ constant.numeric
         ^ punctuation
           ^^ operator
              ^ operator
               ^ punctuation
                ^ constant.numeric
                 ^ punctuation
                   ^ keyword.control
                      ^ operator
                       ^ constant.numeric
                        ^ operator
                         ^ punctuation
                           ^ operator
                            ^ constant.numeric
                             ^ punctuation
                              ^^ operator
                                  ^ keyword.control
                                    ^ constant.numeric
>  S X=$O(^$GLOBAL("^G")),Y=$G(^$JOB($J,"X"))
   ^ keyword.control
      ^ operator
       ^ punctuation
        ^ function.builtin
         ^^^ punctuation
            ^^^^^^ variable.special
                  ^ punctuation
                   ^^^^ string
                       ^^^ punctuation
                           ^ operator
                            ^ punctuation
                             ^ function.builtin
                              ^^^ punctuation
                                 ^^^ variable.special
                                    ^^ punctuation
                                      ^ variable.special
                                       ^ punctuation
                                        ^^^ string
                                           ^^ punctuation
>  W X S Y=1 ; X after W is a variable, coloured as XECUTE: a regex sees no parse
   ^ keyword.control
     ^ keyword.control
       ^ keyword.control
          ^ operator
           ^ constant.numeric
             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
> 1 Q
  ^ label
    ^ keyword.control
> %Z Q $ZV
  ^^ label
     ^ keyword.control
       ^ punctuation
        ^^ variable.special
> EXT(N) Q N*2
  ^^^ label
     ^ punctuation
       ^ punctuation
         ^ keyword.control
            ^ operator
             ^ constant.numeric
