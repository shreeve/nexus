# Every token and context of Rig's highlighting, for the editor grammars'
# goldens. It is read, not run: the last section holds what Rig rejects.

use std.hash
use std.text

extern zig "math.zig"
  pub fun sqrt(x: Float) -> Float

type Byte = U8
LIMIT = 1_000
pub PI = 3.141_592

enum Shape
  circle(radius: Int)
  rect(w: Int, h: Int)
  point

enum Status
  ok = 200
  missing = 404

obj Point
  x: Int = 0
  pub ?name: String = String("p")

  fun norm(?self) -> Int
    self.x * self.x

  sub shift(!self, by: Int)
    self.x += by

obj Handle
  fd: Int

  sub drop(!self)
    print("closed", self.fd)

obj Pair[T]
  left: T
  right: T

  fun first(?self) -> ?T from self
    ?self.left

called fun hot(n: Int) -> Int
  n *% 3 +% 1

inline fun twice(n: Int) -> Int
  n * 2

rarely sub report(msg: ?String)
  print("error:", msg)

fun numbers() -> Int
  a = 0xff + 0b1010 + 0o17 + 42
  b = 1.0e10 + .5 + 2e-3
  c = a -% 1 *% 2
  d = a +| 1 -| 2
  e = a << 2 >> 1 <<% 3
  f = (a & 7) | (a ^ 3)
  g = a.not() % 5 / 2
  a += 1
  a -= 1
  a *= 2
  a /= 2
  a %= 3
  a &= 7
  a |= 8
  a ^= 1
  a <<= 1
  a >>= 1
  a <<%= 1
  a +%= 1
  a -%= 1
  a *%= 1
  a +|= 1
  a -|= 1
  a + b.to_int() + c + d + e + f + g

fun strings() -> String
  s = "tab\tnewline\nquote\"backslash\\ hex\x41"
  t = 'single ''quoted'' text'
  e = ''
  f = ""
  u = String(s, t)
  u

fun ownership(p: ^Point, h: *Point, w: ~Point, xs: !List[Int], v: ?Point) -> Int
  q = +v
  r = <q
  !xs.push(1)
  n = v.x + xs.len
  if *w as strong
    n += strong.x
  if *<w as last
    n += last.x
  <r
  n

fun fallible(m: ?hash.Map[String, Int], k: ?String) -> Int!
  n = m.get(k) ?? 0
  x = text.parse_int("12")!
  y = m.get(k)?
  z = m.get("z") ?? return 0
  n + x + y + z

fun loops(xs: ?List[Int]) -> Int
  total = 0
  for x in xs
    if x < 0
      continue
    total += x if x > 0 else 0
  i = 0
  while i < 10 : i += 1
    total += i
  @outer for row in xs
    for col in xs
      if col == row
        break @outer
      total += 1 if col != row
  v = next() ?? continue
  total

fun closures(xs: !List[Int]) -> Int
  count = 0
  bump = |!count, n| count += n
  quiet = || print(1)
  sort.sort_by(!xs, |a, b| a < b)
  m = hash.Map[Int, Int].new(capacity: 16)
  grid = [3 of 0]
  tail = xs[1..]
  all = xs[..]
  count

fun shapes(s: ?Shape) -> Int
  match s
    .circle(r) => return 3 * r * r
    .rect(w, h) if w == h => return w * w
    .rect(w, h) => return w * h
    .point => return 0

sub resources()
  defer print("done")
  errdefer print("failed")
  new x = 1
  z =! x
  new y =! x * 2
  st: Status = .missing
  ok = true and not false or none == none
  b: Bool = st == .ok
  print(@size(Point), @align(Point), @name(Point), @variants(Status))
  raw
    pass
  print(ok, b, y, z)

test "area"
  print(shapes(.point))

sub main()
  print(LIMIT, PI, Byte.max)
  called = 3
  rarely = 1
  print(called + rarely)

# Below here, nothing compiles: these are tokens an editor still colours.

# Reserved words, keywords though no form uses them yet.
try async await const impl trait when where yield

# Rejected forms, lexed only so Rig can say why; shown as invalid.
p = 2 ** 3
q = a && b
x =!y
