# ==============================================================================
# rig.grammar — Rig lexer and parser grammar
# ==============================================================================
#
# Processed by Nexus 2.0 into src/parser.zig (generated by `zig build`). The
# @schema at the top of the parser section declares every IR node kind and
# its roles; Nexus checks every action against it and generates the IR
# accessors (`parser.ir`) the compiler reads the tree with.
#
# The generated BaseLexer only splits the source into raw tokens. The lexer
# rewriter in src/rig.zig then:
#
#   * turns indentation into INDENT / OUTDENT / NEWLINE, and joins lines
#     inside ( ) and [ ] (a newline there is plain whitespace), except in
#     a closure body that starts below its bar list, which is laid out in
#     blocks as anywhere else and ends with the bracket around it on a
#     line of its own;
#   * reads a reserved word (each is a lexer rule) as a name where it
#     names a member or a builtin: after `.` or `@`, before `:` inside
#     ( ), and in a member list before `:` or after `fun` / `sub`;
#   * joins a line that starts with `.` and a name, indented deeper than a
#     complete statement that opens no block, to that statement (a method
#     chain written down the page);
#   * classifies three contextual words: `new` is a keyword only at the
#     start of a statement before a name, `obj` only at the
#     start of a declaration (after any `pub`) before a name, `inline`,
#     `called`, and `rarely` only there before `fun` or `sub`, and `of` only after
#     a value directly inside [ ] (`[n of x]`); each is a name everywhere
#     else (the other contextual words are the parser's: see @keywords);
#   * marks a `..` whose next token is `]` as DOTDOT_OPEN, the end of an
#     open range (`xs[a..]`, `xs[..]`);
#   * marks an `@` as LABEL_AT, a label, when no `(` touches the name
#     after it and it stands where a statement starts or after `break` or
#     `continue` (`@outer for`, `break @outer (x)`); `@size(T)`, with the
#     `(` touching the name, is a builtin call. After a jump, `@name` is
#     always a label, and a `(` touching it is an error;
#   * classifies the tokens the parser cannot tell apart by its own
#     state, by position, never by spacing:
#
#       |+a, b|  ||  *|a|            closure bar list (vs bitwise `|`)
#       ?? return                    `??` before a jump (vs the operator)
#       while c : i += 1             a `while` step (vs a keyword argument's `:`)
#       a if c else b                ternary vs postfix guard `stmt if c`
#       if f() as a, b               the names `as` binds (vs a list's `,`)
#
#     A character that both starts and continues an operand (`-x` and
#     `a - b`, `f(x)` and `(x)`, `T?` and `?T`) is one token: the parser
#     tells the forms apart by where it stands. The rewriter only
#     checks the spacing: a prefix sigil touches its operand, a postfix
#     what it follows, and an infix operator has the same spacing on
#     both sides.
#
# The grammar has no LALR conflicts; see docs/INTERNALS.md (Conflicts policy).
# ==============================================================================

@lang = "rig"

@lexer

tokens
    # Literals
    ident           # identifier
    integer         # 0, 42, 1_000, 0xff, 0b1010, 0o17
    real            # 3.14, .5, 1.0e10, 2e-3
    string_sq       # 'single'
    string_dq       # "double"

    # Keywords, `true` first and `yield` last (src/rig.zig reads the range
    # as Rig's keywords). Every keyword but `new`, `obj`, `inline`,
    # `called`, and `rarely` is reserved, and is a lexer rule; those five
    # are classified by the rewriter.
    true
    false
    and
    as
    break
    catch
    continue
    defer
    drop
    else
    enum
    errdefer
    error
    extern
    for
    fun
    if
    in
    match
    new             # a keyword only at statement start (`new x = ...`)
    obj             # a keyword only at the start of a type declaration (`obj Point`)
    inline          # a keyword only before the `fun` or `sub` of a declaration
    rarely          # a keyword only before the `fun` or `sub` of a declaration
    called          # a keyword only before the `fun` or `sub` of a declaration
    not
    or
    pass
    pub
    raw
    return
    sub
    test
    try             # reserved; no form uses it
    type
    use
    while
    zig             # `extern zig "file.zig"`
    async           # reserved; no form uses it
    await           # reserved; no form uses it
    const           # reserved; no form uses it
    impl            # reserved; no form uses it
    trait           # reserved; no form uses it
    when            # reserved; no form uses it
    where           # reserved; no form uses it
    yield           # reserved; no form uses it

    # Operators
    plus            # +
    minus           # -
    star            # *
    slash           # /
    percent         # %
    plus_wrap       # +%  wrapping add
    minus_wrap      # -%  wrapping subtract
    star_wrap       # *%  wrapping multiply
    plus_sat        # +|  saturating add
    minus_sat       # -|  saturating subtract
    power           # ** (not a Rig operator; lexed so it can be rejected)
    eq              # ==
    ne              # !=
    lt              # <
    gt              # >
    le              # <=
    ge              # >=
    and_sym         # && (not a Rig operator; the rewriter rejects it)
    or_sym          # || (not a Rig operator; the rewriter rejects it)
    not_sym         # !
    question        # ?
    nullish         # ??
    bar             # |  bitwise or
    ampersand       # &
    caret           # ^
    tilde           # ~
    lshift          # <<
    lshift_wrap     # <<%  wrapping left shift
    rshift          # >>
    at              # @
    assign          # =
    fixed_assign    # =!  a binding that never changes (`x =! e`)
    plus_assign     # +=
    minus_assign    # -=
    star_assign     # *=
    slash_assign    # /=
    percent_assign  # %=
    amp_assign      # &=
    bar_assign      # |=
    caret_assign    # ^=
    lshift_assign   # <<=
    lshift_wrap_assign # <<%=
    rshift_assign   # >>=
    plus_wrap_assign   # +%=
    minus_wrap_assign  # -%=
    star_wrap_assign   # *%=
    plus_sat_assign    # +|=
    minus_sat_assign   # -|=

    # Punctuation
    lparen          # (
    rparen          # )
    lbracket        # [
    rbracket        # ]
    comma           # ,
    colon           # :
    arrow           # ->
    fat_arrow       # =>
    dot             # .
    dotdot          # ..

    # Layout (produced by the rewriter)
    indent
    outdent
    newline

    # Rewriter-classified tokens
    post_if         # if  postfix guard: `stmt if cond`
    ternary_if      # if  inline ternary: `a if cond else b`
    bar_capture     # |   closure bar list delimiter: `|+a, b|`
    bar_empty       # ||  an empty closure bar list: `|| print(1)`
    kwarg_name      # name directly followed by `:` inside ( )
    of              # of  after a value inside [ ]: a fill literal `[n of x]`
    dotdot_open     # ..  directly before `]`: an open range `xs[a..]`, `xs[..]`
    nullish_jump    # ??  directly before `return`, `break`, or `continue`
    step_colon      # :   the first `:` of a `while` header: its step
    as_comma        # ,   between the names `as` binds: `if f() as a, b`
    label_at        # @   before a name no `(` touches: a label, `@outer for`, `break @outer`

    # Misc
    comment
    eof
    err

# A token of any length keeps its category: a token over 65534 bytes has
# `len = 65535`, and its end is read through `tokenEnd` and `leafEnd`.
@longtokens

# ==============================================================================
# LEXER RULES
# ==============================================================================

'#' [^\n]*                                  → comment

"\\\n"                                      → skip         # line continuation
"\\\r\n"                                    → skip
"\r\n"                                      → newline
'\n'                                        → newline

# Strings hold no control characters: a tab or newline is written as an
# escape (`\t`, `\n`), which only double-quoted strings take.
'"' ([^"\\\x00-\x1f\x7f] | '\\' [^\x00-\x1f\x7f])* '"'  → string_dq
"'" ([^'\x00-\x1f\x7f] | "''")* "'"             → string_sq

# Numbers: `_` may separate digits; radix prefixes are lowercase, and a
# decimal number has no leading zero. Anything else that starts with a
# digit is one malformed-number error.
"0x" [0-9a-fA-F] ('_'? [0-9a-fA-F])*        → integer
"0b" [01] ('_'? [01])*                      → integer
"0o" [0-7] ('_'? [0-7])*                    → integer
('0' | [1-9] ('_'? [0-9])*)? '.' [0-9] ('_'? [0-9])* ([eE] [+-]? [0-9] ('_'? [0-9])*)? → real
('0' | [1-9] ('_'? [0-9])*) [eE] [+-]? [0-9] ('_'? [0-9])* → real
'0' | [1-9] ('_'? [0-9])*                   → integer
[0-9] [0-9a-zA-Z_]*                         → err

"<<%="                                      → lshift_wrap_assign
"<<="                                       → lshift_assign
"+%="                                       → plus_wrap_assign
"-%="                                       → minus_wrap_assign
"*%="                                       → star_wrap_assign
"+%"                                        → plus_wrap
"-%"                                        → minus_wrap
"*%"                                        → star_wrap
"+|="                                       → plus_sat_assign
"-|="                                       → minus_sat_assign
"+|"                                        → plus_sat
"-|"                                        → minus_sat
">>="                                       → rshift_assign
"**"                                        → power
"=="                                        → eq
"!="                                        → ne
"<="                                        → le
">="                                        → ge
"&&"                                        → and_sym
"||"                                        → or_sym
"=!"                                        → fixed_assign
"+="                                        → plus_assign
"-="                                        → minus_assign
"*="                                        → star_assign
"/="                                        → slash_assign
"%="                                        → percent_assign
"&="                                        → amp_assign
"|="                                        → bar_assign
"^="                                        → caret_assign
"->"                                        → arrow
"=>"                                        → fat_arrow
"??"                                        → nullish
".."                                        → dotdot
"<<%"                                       → lshift_wrap
"<<"                                        → lshift
">>"                                        → rshift

'+'                                         → plus
'-'                                         → minus
'*'                                         → star
'/'                                         → slash
'%'                                         → percent
'<'                                         → lt
'>'                                         → gt
'!'                                         → not_sym
'?'                                         → question
'|'                                         → bar
'&'                                         → ampersand
'^'                                         → caret
'~'                                         → tilde
'@'                                         → at
'='                                         → assign
'('                                         → lparen
')'                                         → rparen
'['                                         → lbracket
']'                                         → rbracket
','                                         → comma
':'                                         → colon
'.'                                         → dot

# Reserved words: a keyword rule ties with the identifier rule on its own
# text and wins by coming first; a longer word (`iffy`) is a name. `new`,
# `obj` and the contextual words (`of`, `unique`, `from`, `static`) lex
# as names, and the rewriter or the parser classifies them.
"true"                                      → true
"false"                                     → false
"and"                                       → and
"as"                                        → as
"break"                                     → break
"catch"                                     → catch
"continue"                                  → continue
"defer"                                     → defer
"drop"                                      → drop
"else"                                      → else
"enum"                                      → enum
"errdefer"                                  → errdefer
"error"                                     → error
"extern"                                    → extern
"for"                                       → for
"fun"                                       → fun
"if"                                        → if
"in"                                        → in
"match"                                     → match
"not"                                       → not
"or"                                        → or
"pass"                                      → pass
"pub"                                       → pub
"raw"                                       → raw
"return"                                    → return
"sub"                                       → sub
"test"                                      → test
"try"                                       → try
"type"                                      → type
"use"                                       → use
"while"                                     → while
"zig"                                       → zig
"async"                                     → async
"await"                                     → await
"const"                                     → const
"impl"                                      → impl
"trait"                                     → trait
"when"                                      → when
"where"                                     → where
"yield"                                     → yield

[a-zA-Z_][a-zA-Z0-9_]*                      → ident

.                                           → err

# ==============================================================================
# PARSER
# ==============================================================================

@parser

# ==============================================================================
# THE SEMANTIC IR
# ==============================================================================
#
# Every node the parser builds, one kind per line with its roles in slot
# order. Nexus checks every action below against this schema (each role
# filled with a value of its declared type, every value-bearing element
# used) and generates the `Tag` and `Role` enums and the `ir` accessors
# the compiler reads the tree with. A node always has all of its slots:
# `_` where an optional role (`?`) is absent. A `...role` takes the
# remaining children. See docs/INTERNALS.md (The semantic IR).
#
# Role types: `leaf` is a name or literal; `group` an untagged list (a
# parameter list); `tag(...)` a marker; `a|b` a node of one of those
# kinds; an untyped role takes a leaf or any node.

@schema
    # Declarations
    module                      ...decls
    use                         name alias:leaf?
    fun                         name:leaf tparams:group? params:group? returns? origins:group? keeps:group? body:block? owner? owner_params:group? mark:inline|called|rarely?
    sub                         name:leaf tparams:group? params:group? fails:tag(fails)? keeps:group? body:block? owner? owner_params:group? mark:inline|called|rarely?
    lambda                      captures:captures? params:group? body:block
    struct                      name:leaf unique:tag(unique)? ...members
    enum, errors                name:leaf ...members
    generic_struct              name:leaf tparams:group unique:tag(unique)? ...members
    generic_enum                name:leaf tparams:group ...members
    type                        name:leaf type
    test                        name:leaf body:block
    pub                         decl
    extern                      name:leaf type
    extern_fun                  name:leaf params:group? returns? origins:group? keeps:group?
    extern_sub                  name:leaf params:group? keeps:group?
    zig_extern                  file:leaf ...decls
    zig_const                   name:leaf type
    drop_decl                   params:group body:block
    inline, called, rarely                          # a function's marker
    labeled                     label:leaf stmt

    # Parameters, fields, and enum members
    ":"                         name:leaf type
    default                     name:leaf type value
    valued                      name:leaf value
    variant                     name:leaf params:group

    # Bindings: `op` is the binding kind (see BindingKind in src/rig.zig)
    set                         op:tag(fixed|shadow|shadow_fixed|"+="|"-="|"*="|"/="|"%="|"+%="|"-%="|"*%="|"+|="|"-|="|"&="|"|="|"^="|"<<="|"<<%="|">>=")? target type? value
    drop                        target @wrapper  # a name, or the (move e) whose value is dropped
    # `q, r = f()`: each target takes one of a call's results. The Parser
    # wrapper makes each target but `_` the binding `(set op t _
    # (result_part))` of the result in its position.
    destructure                 op:tag(fixed|shadow|shadow_fixed)? targets:group value
    result_part                 @wrapper
    results                     ...values        # `return a, b`: a function's several results
    pass

    # Control flow
    if                          cond then else?
    as                          value name:leaf
    as_results                  value names:group  # `if f() as a, b`
    while                       cond step? body:block else:block?
    for                         mode:tag(iter|read|write|move) var:leaf? index:leaf? source body:block else:block?
    match                       subject ...arms:arm
    arm                         pattern guard? body
    alt_pattern                 ...alts
    range_pattern               lo hi
    variant_pattern             name:leaf ...bindings
    enum_lit                    name:leaf
    return                      value?
    break                       value? label:leaf?
    continue                    label:leaf?
    defer, errdefer             body
    raw_block                   body:block
    propagate, propagate_none   value
    catch                       value name:leaf? handler
    block                       ...stmts

    # Closures: the Parser wrapper splits a bar list into captures and
    # parameters
    captures                    ...caps:cap_clone|cap_move|cap_weak|cap_read|cap_write @wrapper
    cap_clone, cap_move, cap_weak, cap_read, cap_write  name:leaf

    # Calls and access
    call                        callee ...args
    builtin                     name:leaf ...args
    member                      object name:leaf
    index                       object index
    inst                        object ...args
    array                       ...elems
    array_fill                  size value
    tuple                       ...elems         # `(a, b)`: parsed only to be rejected
    kwarg                       name:leaf value

    # Operators
    "+", "-", "*", "/", "%"     left right
    "+%", "-%", "*%"            left right
    "+|", "-|"                  left right
    "==", "!=", "<", ">", "<=", ">="  left right
    "&", "|", "^", "<<", "<<%", ">>"   left right
    "??", and, or               left right
    ".."                        left? right?
    neg, not                    operand

    # Ownership sigils (`~T`, `?T`, `!T`, `*T`, `^T` in type position are
    # the type kinds below, except `weak`, which is both)
    move, read, write, clone, share, weak, box  operand

    # Types
    optional, error_union, read_view, write_view, shared, boxed, slice  type
    generic_inst                name ...args
    array_type                  size type
    fun_type                    params:group? returns? fails:tag(fails)?
    results_type                ...types         # `-> (Int, Int)`: a function's results

@display
    # Tokens by what they read as in a message; every keyword and
    # operator as it is written.
    IDENT: "a name", INTEGER: "an integer", REAL: "a number"
    STRING_SQ: "a string", STRING_DQ: "a string"
    NEWLINE: "the end of the line", INDENT: "an indented block"
    OUTDENT: "the end of the block"
    POST_IF: "`if`", TERNARY_IF: "`if`", BAR_CAPTURE: "`|`", BAR_EMPTY: "`||`"
    KWARG_NAME: "a keyword argument"
    OF: "`of`", OBJ: "`obj`", INLINE: "`inline`", CALLED: "`called`", RARELY: "`rarely`", UNIQUE: "`unique`", FROM: "`from`", STATIC: "`static`", KEEPS: "`keeps`"
    DOTDOT_OPEN: "`..`", NULLISH_JUMP: "`??`", STEP_COLON: "`:`", AS_COMMA: "`,`", LABEL_AT: "`@`"
    TRUE: "`true`", FALSE: "`false`", AND: "`and`", AS: "`as`", BREAK: "`break`", CATCH: "`catch`"
    CONTINUE: "`continue`", DEFER: "`defer`", DROP: "`drop`", ELSE: "`else`", ENUM: "`enum`", ERRDEFER: "`errdefer`"
    ERROR: "`error`", EXTERN: "`extern`", FOR: "`for`", FUN: "`fun`", IF: "`if`", IN: "`in`"
    MATCH: "`match`", NEW: "`new`", NOT: "`not`", OR: "`or`", PASS: "`pass`", PUB: "`pub`"
    RAW: "`raw`", RETURN: "`return`", SUB: "`sub`", TEST: "`test`", TRY: "`try`"
    TYPE: "`type`", USE: "`use`", WHILE: "`while`", ZIG: "`zig`"
    ASYNC: "`async`", AWAIT: "`await`", CONST: "`const`", IMPL: "`impl`"
    TRAIT: "`trait`", WHEN: "`when`", WHERE: "`where`", YIELD: "`yield`"
    "=": "`=`", "+=": "`+=`", "-=": "`-=`", "*=": "`*=`", "/=": "`/=`", "%=": "`%=`"
    "&=": "`&=`", "|=": "`|=`", "^=": "`^=`", "<<=": "`<<=`", "<<%=": "`<<%=`", ">>=": "`>>=`", "=!": "`=!`"
    "+%=": "`+%=`", "-%=": "`-%=`", "*%=": "`*%=`", "+%": "`+%`", "-%": "`-%`", "*%": "`*%`"
    "+|=": "`+|=`", "-|=": "`-|=`", "+|": "`+|`", "-|": "`-|`"
    ":": "`:`", "->": "`->`", "(": "`(`", ")": "`)`", "[": "`[`"
    "]": "`]`", ",": "`,`", ".": "`.`", "..": "`..`", "=>": "`=>`", "~": "`~`"
    "@": "`@`", "==": "`==`", "!=": "`!=`", "<": "`<`", ">": "`>`", "<=": "`<=`"
    ">=": "`>=`", "??": "`??`", "|": "`|`", "^": "`^`", "&": "`&`", "<<": "`<<`", "<<%": "`<<%`"
    ">>": "`>>`", "+": "`+`", "-": "`-`", "*": "`*`", "/": "`/`", "%": "`%`"
    "!": "`!`", "?": "`?`"

@errors
    stmt: "a statement", block: "an indented block", type: "a type"
    expr: "an expression", tail: "an expression"
    value: "a value"
    field: "a parameter", member: "a member"
    pattern: "a pattern", arm: "a match arm", params: "a parameter list"
    unary: "an operand", step: "an assignment or a call"

# The tokens tolerant parsing (`parseTolerant`, which the language server
# uses) may insert to parse on past a syntax error: a missing name, block
# layout, and the end of a statement. The strict parse the compiler runs
# is unchanged.
@repair
    holes       IDENT
    structure   INDENT OUTDENT
    terminator  NEWLINE

# How editors colour Rig: `nexus --highlight all rig.grammar editors`
# writes editors/ from this (editors/README.md). Words the lang module
# classifies by place (`new`, `obj`, `of`, the markers) and the sigils,
# which it tells apart by spacing, are patterns with context here.
@highlight
    language            "Rig"
    scope-name          source.rig
    extensions          rig
    line-comment        "#"
    indent              line-start [ \t]* ("pub" [ \t]+)? ("called" | "rarely" | "inline" | "fun" | "sub" | "obj" | "enum" | "if" | "else" | "while" | "for" | "match" | "test" | "raw" | "extern" | "defer" | "errdefer") ([ \t(] [^\n]*)? line-end
    dedent              line-start [ \t]* "else"

    keyword             ("fun" | "sub") [ \t]+ function:([A-Za-z_] [A-Za-z0-9_]*)
    keyword             ("obj" | "enum" | "type") [ \t]+ type:([A-Za-z_] [A-Za-z0-9_]*)
    keyword             ("called" | "rarely" | "inline") after [ \t]+ ("fun" | "sub")
    keyword             line-start [ \t]* "new" after [ \t]+ [A-Za-z_]
    keyword             "of" before ' ' after ' '
    keyword.control     ("break" | "continue") [ \t]+ label:('@' [A-Za-z_] [A-Za-z0-9_]*)
    label               '@' [A-Za-z_] [A-Za-z0-9_]* after [ \t]+ ("for" | "while" | "match" | "raw")
    function.builtin    '@' [a-z_]+ after '('
    storage.modifier    [*] not before [A-Za-z0-9_)\]] after '<' [A-Za-z_(\[]
    storage.modifier    [<?!+^*~] not before [A-Za-z0-9_)\]] after [A-Za-z_(\[]
    storage.modifier    [!?] before [A-Za-z0-9_)\]] not after [A-Za-z0-9_(\[=?]
    variable.parameter  [A-Za-z_] [A-Za-z0-9_]* after ':' not before [A-Za-z0-9_.]
    type                [A-Z] [A-Za-z0-9_]* not before [A-Za-z0-9_]

    keyword.control     "if" "else" "while" "for" "in" "match" "return" "break" "continue"
                        "pass" "defer" "errdefer" "catch" "try" "await" "yield"
    keyword             "fun" "sub" "enum" "type" "use" "pub" "const" "extern" "zig" "test"
                        "raw" "drop" "error" "as" "async" "impl" "trait" "when" "where"
    keyword             ctx
    keyword.operator    "and" "or" "not"
    constant            "true" "false" "none"
    variable.special    "self"
    constant.numeric    INTEGER REAL
    string              STRING_DQ STRING_SQ
    string.escape       '\\' [^\x00-\x1f\x7f] within STRING_DQ
    string.escape       "''" within STRING_SQ
    comment             COMMENT
    invalid             "**" "&&"
    invalid             '=' [!] not after [ \t]
    operator            "+" "-" "*" "/" "%" "+%" "-%" "*%" "+|" "-|" "==" "!=" "<" ">" "<=" ">="
                        "!" "?" "??" "|" "&" "^" "~" "<<" "<<%" ">>" "=" "=!" "+=" "-=" "*=" "/=" "%="
                        "&=" "|=" "^=" "<<=" "<<%=" ">>=" "+%=" "-%=" "*%=" "+|=" "-|=" "->" "=>"
    punctuation         "(" ")" "[" "]" "," ":" "." ".." "@"

# `unique`, `from`, `static` and `keeps` lex as names, and the parser
# reads one as a keyword where its state takes the keyword: `unique` after
# an obj header's name or type parameters (`obj Random unique`), `from`
# after a function's result type (`-> ?Item from a`), `static` right after
# that `from`, and `keeps` at the end of a function's header (`sub
# watch(!self, s: ?String) keeps s`). Everywhere else each is a name.
@keywords
    ctx  unique from static keeps

@as IDENT = [ctx!]

# ==============================================================================
# PROGRAM STRUCTURE
# ==============================================================================

name     = IDENT

program! = [decls:body]                             → (module)

body     = stmt                                     → (1)
         | body NEWLINE stmt                        → (...1 3)
         | body NEWLINE                             → 1

block    = INDENT [stmts:body] OUTDENT              → (block)

stmt     = use
         | decl
         | extvar
         | ext_fun
         | ext_sub
         | zig_ext
         | LABEL_AT label:name stmt:stmt            → (labeled)
         | simple
         | simple POST_IF cond:value                → (if then:(block 1))

# A simple statement: an expression, a binding, `pass`, or a flow statement. Only these take a postfix guard (`return x if done`).
# A compound assignment's `op` is the tag its operator names (`+=`). A
# statement `<e` parses as the expression; the Parser wrapper makes it
# `(drop ...)` where its value is not used.
simple   = tail
         | assign
         | target:postfix "=!" value:tail           → (set op:fixed)
         | target:name ":" type:type "=" value:tail → (set)
         | target:name ":" type:type "=!" value:tail → (set op:fixed)
         | NEW target:name "=" value:tail           → (set op:shadow)
         | NEW target:name ":" type:type "=" value:tail → (set op:shadow)
         | NEW target:name "=!" value:tail          → (set op:shadow_fixed)
         | NEW target:name ":" type:type "=!" value:tail → (set op:shadow_fixed)
         | PASS                                     → (pass)
         | RETURN [value:tail]                      → (return)
         | RETURN rvals                             → (return value:(results ...2))
         | targets:dtargets "=" value:tail          → (destructure)
         | targets:dtargets "=" rvals               → (destructure value:(results ...3))
         | NEW targets:dtargets "=" value:tail      → (destructure op:shadow)
         | targets:dtargets "=!" value:tail         → (destructure op:fixed)
         | NEW targets:dtargets "=!" value:tail     → (destructure op:shadow_fixed)
         | BREAK [LABEL_AT label:name] [value:tail] → (break)
         | CONTINUE [LABEL_AT label:name]           → (continue)
         | DEFER body:(block | simple)              → (defer)
         | ERRDEFER body:(block | simple)           → (errdefer)
         | RAW body:block                           → (raw_block)

# `q, r = divmod(a, b)`: two or more targets, each a name or `_`. A
# field or element parses, so that the checker can reject it.
dtargets = postfix "," postfix                      → (1 3)
         | dtargets "," postfix                     → (...1 3)

# `return q, r`: a function's several results. Also the right side of
# `a, b = b, a`, which parses so that the checker can name `swap`.
rvals    = value "," value                          → (1 3)
         | rvals "," value                          → (...1 3)

assign   = target:postfix "="   value:tail          → (set)
         | target:postfix
           op:("+=" | "-=" | "*=" | "/=" | "%=" | "+%=" | "-%=" | "*%=" | "+|=" | "-|=" | "&=" | "|=" | "^=" | "<<=" | "<<%=" | ">>=")
           value:tail                               → (set)

# ==============================================================================
# DECLARATIONS
# ==============================================================================

decl     = defn
         | PUB decl:defn                            → (pub)
         | PUB decl:constant                        → (pub)

# A public module-level constant, `pub LIMIT = 4`. A `=!` parses too, so
# that the Parser wrapper can say a module-level binding needs none.
constant = target:name "=" value:tail               → (set)
         | target:name ":" type:type "=" value:tail → (set)
         | target:name "=!" value:tail              → (set op:fixed)
         | target:name ":" type:type "=!" value:tail → (set op:fixed)

defn     = fun | sub | method | enum | struct | errors | typedef | test

# `use geo`, `use geo as g`, `use checker.binder`, `use std.os as o`: a
# module named by its path from the program's root directory, or from
# the standard library's.
use      = USE name:mpath                           → (use)
         | USE name:mpath AS alias:name             → (use)

mpath    = name
         | object:mpath "." name:name               → (member)

# A function always writes its parameter list, even when empty
# (`sub main()`). Every definition parses without one, so that the
# Parser wrapper can reject it with the header to write.
#
# A marker before `fun` or `sub` asks for a speed, never a meaning:
# `inline` inlines the function at every call, `called` keeps every call
# a call, and `rarely` says it is rarely called, so it stays out of the
# code that calls it.
mark     = INLINE                                   → (inline)
         | CALLED                                   → (called)
         | RARELY                                   → (rarely)

fun      = [mark:mark] FUN name:name [tparams:tparams] [params:params] [returns:returns] [origins:origins] [keeps:keeps] body:block → (fun)
sub      = [mark:mark] SUB name:name [tparams:tparams] [params:params] [keeps:keeps] body:block → (sub)
         | [mark:mark] SUB name:name [tparams:tparams] [params:params] "!" [keeps:keeps] body:block → (sub fails:fails)  # `sub save(p: Page)!`

# A method declared outside its type's body, in the type's module:
# `fun Point.norm(?self) -> Float`, `fun Wrap[T].map[U](...)`, with the
# type's parameters named as its declaration names them. The Parser
# wrapper moves it into the body (`attachMethods`). A qualified owner,
# `fun geo.Point.m()`, parses only to be rejected.
method   = [mark:mark] FUN owner:name [owner_params:tparams] "." name:name [tparams:tparams] [params:params] [returns:returns] [origins:origins] [keeps:keeps] body:block → (fun)
         | [mark:mark] FUN owner:qowner "." name:name [tparams:tparams] [params:params] [returns:returns] [origins:origins] [keeps:keeps] body:block → (fun)
         | [mark:mark] SUB owner:name [owner_params:tparams] "." name:name [tparams:tparams] [params:params] [keeps:keeps] body:block → (sub)
         | [mark:mark] SUB owner:name [owner_params:tparams] "." name:name [tparams:tparams] [params:params] "!" [keeps:keeps] body:block → (sub fails:fails)
         | [mark:mark] SUB owner:qowner "." name:name [tparams:tparams] [params:params] [keeps:keeps] body:block → (sub)
         | [mark:mark] SUB owner:qowner "." name:name [tparams:tparams] [params:params] "!" [keeps:keeps] body:block → (sub fails:fails)

qowner   = object:name "." name:name                → (member)

returns  = "->" type                                → 2

# What a function's result views, after its type: some of its
# parameters (`-> ?Item from a, b`, `-> String from self`), or only what
# lives for the whole program (`-> String from static`).
origins  = FROM onames                              → (...2)
         | FROM STATIC                              → ()

onames   = name                                     → (1)
         | onames "," name                          → (...1 3)

# The lent parameters a function may keep, at the end of its header: it
# may store what each views in what its write receiver and write
# parameters lead to (`sub watch(!self, s: ?String) keeps s`; `keeps
# self` names the receiver).
keeps    = KEEPS onames                             → 2

params   = "(" fields ![","] ")"                     → (...2)
         | "(" ")"                                  → ()

# Compile-time parameters, in brackets after the declared name: a bare
# name is a type parameter, `name: Type` a compile-time value.
tparams  = "[" tfields ![","] "]"                    → (...2)

tfields  = tfield                                   → (1)
         | tfields "," tfield                       → (...1 3)

tfield   = name
         | name:name ":" type:type                  → (:)

# Written out rather than `L(field)`, which conflicts with a trailing
# comma.
fields   = field                                    → (1)
         | fields "," field                         → (...1 3)

# Parameters, struct fields, and enum variants share one shape.
field    = fname
         | name:fname ":" type:type                 → (:)
         | name:fname ":" type:type "=" value:expr  → (default)
         | "?" operand:fname                        → (read)       # `?self`
         | "!" operand:fname                        → (write)      # `!self`
         | "<" operand:fname                        → (move)       # `<self`

# Inside ( ) the rewriter turns a name followed by `:` into KWARG_NAME.
fname    = name | KWARG_NAME

enum     = ENUM name:name INDENT members:members OUTDENT     → (enum)
         | ENUM name:name tparams:tparams INDENT members:members OUTDENT
                                                    → (generic_enum)
errors   = ERROR name:name INDENT members:members OUTDENT    → (errors)
struct   = OBJ name:name INDENT members:members OUTDENT   → (struct)
         | OBJ name:name UNIQUE INDENT members:members OUTDENT
                                                    → (struct unique:unique)
         | OBJ name:name tparams:tparams INDENT members:members OUTDENT
                                                    → (generic_struct)
         | OBJ name:name tparams:tparams UNIQUE INDENT members:members OUTDENT
                                                    → (generic_struct unique:unique)

typedef  = TYPE name:name "=" type:type             → (type)

members  = member                                   → (1)
         | members NEWLINE member                   → (...1 3)
         | members NEWLINE                          → 1

member   = field
         | name:name "=" value:expr                 → (valued)     # `ok = 200`
         | name:name params:params                  → (variant)    # `circle(r: Int)`
         | fun
         | sub
         | DROP params:params body:block            → (drop_decl)  # `drop(!self)`
         | PUB decl:member                          → (pub)        # `pub len: Int`
         | "?" fname ":" type                       → (read operand:(: name:2 type:4))  # `pub ?len: Int`
         | "?" fname ":" type "=" expr              → (read operand:(default name:2 type:4 value:6))

test     = TEST name:(STRING_DQ | STRING_SQ) body:block → (test)

extvar   = EXTERN name:name ":" type:type           → (extern)

ext_fun  = EXTERN FUN name:name [params:params] [returns:returns] [origins:origins] [keeps:keeps] → (extern_fun)
ext_sub  = EXTERN SUB name:name [params:params] [keeps:keeps] → (extern_sub)

# Declarations the Zig file `file` implements (the standard library's
# only): a `fun` or `sub` without a body, whose file declares a Zig
# function of the type its signature lowers to, or a constant
# `name: T`, whose file declares a Zig constant of type `T` that Zig
# computes for the target it compiles for.
zig_ext  = EXTERN ZIG file:STRING_DQ INDENT decls:zdecls OUTDENT → (zig_extern)

zdecls   = zdecl                                    → (1)
         | zdecls NEWLINE zdecl                     → (...1 3)
         | zdecls NEWLINE                           → 1

zdecl    = zfun
         | zconst
         | PUB decl:zfun                            → (pub)
         | PUB decl:zconst                          → (pub)

zconst   = name:name ":" type:type                  → (zig_const)

zfun     = [mark:mark] FUN name:name [tparams:tparams] [params:params] [returns:returns] [origins:origins] [keeps:keeps] → (fun)
         | [mark:mark] SUB name:name [tparams:tparams] [params:params] [keeps:keeps] → (sub)
         | [mark:mark] SUB name:name [tparams:tparams] [params:params] "!" [keeps:keeps] → (sub fails:fails)

# ==============================================================================
# TYPES
# ==============================================================================
#
# The holding sigils `^`, `*` and `~` bind to the type after them,
# tighter than the suffixes: `^Node?` is an optional box, `*User?` an
# optional shared handle, and a box or handle of an optional is `^(T?)`,
# `*(User?)`. A view sigil applies to the whole type after
# it, suffixes included: `?User?` is a read view of an optional User. The
# element of a slice or array takes the suffixes too (`[]Int?`), and a
# function type takes none, so an optional of one is written in
# parentheses.

type     = "?" type:type                            → (read_view)
         | "!" type:type                            → (write_view)
         | ptype
         | tsuffix

# A prefix type that takes no suffix, alone or behind handles.
ptype    = "[" "]" type:type                        → (slice)
         | "[" size:dim "]" type:type               → (array_type)
         | FUN "(" [params:L(type)] ")" "->" returns:type → (fun_type)  # `fun(Int) -> Int`
         | SUB "(" [params:L(type)] ")"             → (fun_type)   # `sub(Int)`
         | SUB "(" [params:L(type)] ")" "!"         → (fun_type fails:fails)  # `sub(Int)!`
         | "*" type:ptype                           → (shared)     # `*fun(Int) -> Int`
         | "~" operand:ptype                        → (weak)
         | "^" type:ptype                           → (boxed)      # `^[4]Int`
         | "^" "?" type                             → (boxed type:(read_view type:3))  # `^?T`

tsuffix  = type:tsuffix "?"                         → (optional)
         | type:tsuffix "!"                         → (error_union)
         | thandle

thandle  = "*" type:thandle                         → (shared)
         | "~" operand:thandle                      → (weak)
         | "^" type:thandle                         → (boxed)
         | tatom

tatom    = tname
         | ERROR                                    # `error`: an error of any set
         | name:tname "[" args:types ![","] "]"      → (generic_inst)
         | "(" type ")"                             → 2
         | "(" type "," rtypes ![","] ")"           → (results_type 2 ...4)
         | "(" rnamed ![","] ")"                    → (results_type ...2)

# A function's results, `-> (Int, Int)`, after the first. Named results,
# `(q: Int, r: Int)`, parse so that the checker can reject them.
rtypes   = type                                     → (1)
         | rtypes "," type                          → (...1 3)

rnamed   = rnfield                                  → (1)
         | rnamed "," rnfield                       → (...1 3)

rnfield  = name:KWARG_NAME ":" type:type            → (:)

# A named type, of this module or another: `Point`, `geo.Point`. Its
# instance names it the same way: `Wrap[Int]`, `lib.Wrap[Int]`.
tname    = name
         | object:name "." name:name                → (member)

# Compile-time arguments; written out rather than `L(targ)`, which
# conflicts with a trailing comma.
types    = targ                                     → (1)
         | types "," targ                           → (...1 3)

# A compile-time argument in a type: a type, or a compile-time integer.
# A bare name is read as a type; the checker reads it as a value where
# the parameter is one. An integer or arithmetic is always a value.
targ     = type
         | INTEGER
         | "-" operand:INTEGER                      → (neg)
         | "(" INTEGER ")"                          → 2
         | cexp

# An array size: an integer, a name (a constant or a compile-time
# parameter), a module's constant, or arithmetic on them, any of them
# in parentheses. A negative integer parses, to be reported as out of
# range.
dim      = INTEGER
         | "-" operand:INTEGER                      → (neg)
         | "(" INTEGER ")"                          → 2
         | name
         | "(" name ")"                             → 2
         | object:name "." name:name                → (member)
         | cexp

# Arithmetic on compile-time integers, with at least one operator, so
# that a bare name stays a type. Operands are integers, names, module
# constants, and parenthesized arithmetic.
cexp     = cmulop
         | caddop
         | "(" cexp ")"                             → 2
caddop   = left:cadd "+" right:cmul                 → (+)
         | left:cadd "-" right:cmul                 → (-)
cadd     = caddop
         | cmul
cmulop   = left:cmul "*" right:cunit                → (*)
         | left:cmul "/" right:cunit                → (/)
         | left:cmul "%" right:cunit                → (%)
cmul     = cmulop
         | cunit
cunit    = INTEGER
         | name
         | object:name "." name:name                → (member)
         | "(" cexp ")"                             → 2

# ==============================================================================
# EXPRESSIONS
# ==============================================================================
#
#   tail    an expression, or a closure whose body is an assignment: a
#           statement, a match arm, and the right side of a binding,
#           `return`, and `break`.
#   expr    anything that yields a value, including block forms.
#   value   an expression without a block or closure: conditions, sources,
#           subjects, operands, ternary branches.

tail     = expr
         | cclosure

expr     = value
         | if
         | while
         | for
         | match
         | value:logic CATCH BAR_CAPTURE name:name BAR_CAPTURE handler:block → (catch)
         | closure

value    = then:logic TERNARY_IF cond:logic ELSE else:value → (if)
         | value:logic CATCH [BAR_CAPTURE name:name BAR_CAPTURE] handler:value → (catch)
         | value:logic CATCH [BAR_CAPTURE name:name BAR_CAPTURE] handler:jump → (catch)
         | left:logic NULLISH_JUMP right:jump        → (??)
         | logic

# A jump as the fallback of `??` or a `catch` handler: `get(k) ?? return
# none`, `parse(s) catch break @outer`. It takes the rest of the
# expression, so its left side is a whole `logic`, as `catch`'s is; the
# rewriter marks a `??` before a jump as NULLISH_JUMP. In a `while`
# header, the rewriter marks the `:` that starts the step as STEP_COLON,
# and a jump there may name a label (`while a ?? break @outer : i += 1`).
jump     = RETURN [value:value]                     → (return)
         | BREAK [LABEL_AT label:name] [value:value] → (break)
         | CONTINUE [LABEL_AT label:name]           → (continue)

logic    = left:logic OR right:conj                 → (or)
         | conj
conj     = left:conj AND right:neg                  → (and)
         | neg
neg      = NOT operand:neg                          → (not)
         | value:@infix AS name:name                → (as)
         | value:@infix AS names:anames             → (as_results)
         | @infix

# The names `as` binds from a call that gives several results; the
# rewriter marks a `,` after `as name` outside brackets as AS_COMMA.
anames   = name AS_COMMA name                       → (1 3)
         | anames AS_COMMA name                     → (...1 3)

# The rest of a parenthesized list, `(a, b)`, which parses only to be
# rejected: its own rule, so a list in brackets expects no `)`.
texprs   = expr                                     → (1)
         | texprs "," expr                          → (...1 3)

# Written out rather than `L(expr)`, which conflicts with a trailing
# comma.
exprs    = expr                                     → (1)
         | exprs "," expr                           → (...1 3)

# --- Control flow -------------------------------------------------------------

# `if e as name` / `while e as name`: `e` is an optional; the body runs
# with `name` bound to the value inside it. `as` binds tighter than
# `and`, so bindings and Bool conditions join into one condition:
# `if a as x and x > 0 and b as y`. The checker takes `as` only there.
if       = IF cond:value then:block [ELSE else:block] → (if)
         | IF cond:value then:block ELSE else:if    → (if)

while    = WHILE cond:value [STEP_COLON step:step] body:block [ELSE else:block] → (while)

# A `while` step runs after each iteration: an assignment, or a call,
# which may propagate its failure (the checker rejects other forms). A
# call's receiver may take `?`, `!`, or `<` (see the Parser wrapper).
step     = assign
         | postfix
         | "?" operand:postfix                      → (read)
         | "!" operand:postfix                      → (write)
         | "<" operand:postfix                      → (move)

# The Parser wrapper moves a `?xs` / `!xs` / `<xs` source sigil into the
# mode slot.
for      = FOR var:name ["," index:name] IN source:value body:block [ELSE else:block]
                                                    → (for mode:iter)
         | FOR source:value body:block [ELSE else:block]
                                                    → (for mode:iter var:_)

match    = MATCH subject:value INDENT arms:arms OUTDENT → (match)

arms     = arm                                      → (1)
         | arms NEWLINE arm                         → (...1 3)
         | arms NEWLINE                             → 1

# An arm's pattern may list alternatives (`1, 2 =>`) and take a guard
# (`.circle(r) if r > 0 =>`); the rewriter classifies an `if` after a
# pattern as POST_IF, as after a statement.
arm      = pattern:pats "=>" body:simple            → (arm)
         | pattern:pats POST_IF guard:value "=>" body:simple → (arm)
         | pattern:pats body:block                  → (arm)
         | pattern:pats POST_IF guard:value body:block → (arm)

pats     = pattern
         | alts:palts                               → (alt_pattern)

# Written out rather than `L(pattern)`, which conflicts with a trailing
# comma.
palts    = pattern "," pattern                      → (1 3)
         | palts "," pattern                        → (...1 3)

pattern  = patatom
         | lo:patatom ".." hi:patatom               → (range_pattern)

# A member of an error set is named with its set, `E.name`, or through
# its module, `m.E.name`. The module's set is its own rule rather than
# `tname`, whose lone name would need a second token of lookahead.
patatom  = name
         | object:name "." name:name                → (member)
         | object:pqual "." name:name               → (member)
         | INTEGER
         | "-" operand:INTEGER                      → (neg)
         | TRUE
         | FALSE
         | "." name:name                            → (enum_lit)
         | "." name:name "(" ")"                    → (variant_pattern)
         | "." name:name "(" bindings:pbinds ![","] ")" → (variant_pattern)

pqual    = object:name "." name:name                → (member)

# A payload field is bound by position (`.rect(w, h)`) or by name
# (`.rect(w: a)`); the checker rejects a pattern that mixes the two.
# Written out rather than `L(pbind)`, which conflicts with a trailing
# comma.
pbinds   = pbind                                    → (1)
         | pbinds "," pbind                         → (...1 3)

pbind    = name
         | name:KWARG_NAME ":" value:name           → (kwarg)

# --- Closures -----------------------------------------------------------------
#
# A closure starts with its bar list. An entry with a sigil is a capture;
# a bare name is a parameter, optionally typed:
#   |+x| clone (a copy, for a Copy value)   |<x| move   |~x| weak
#   |?x| lend to read   |!x| lend to write
#   |a, b| a + b      |+v, a: Int| v.set(a)      || print("tick")
# `*` before the bars makes an owned closure: `*|+v, a| v.set(a)`. The
# grammar puts every entry in `params`; the Parser wrapper moves the
# captures into `(captures ...)`.

closure  = lambda
         | "*" operand:lambda                       → (share)

lambda   = params:bars body:block                   → (lambda)
         | params:bars expr                         → (lambda body:(block 2))

# A closure whose inline body is an assignment (`|!t, n| t += n`).
cclosure = clambda
         | "*" operand:clambda                      → (share)

clambda  = params:bars assign                       → (lambda body:(block 2))

bars     = BAR_CAPTURE barents ![","] BAR_CAPTURE    → (...2)
         | BAR_EMPTY                                → ()

barents  = barent                                   → (1)
         | barents "," barent                       → (...1 3)

barent   = fname
         | name:fname ":" type:type                 → (:)
         | "+" name:name                            → (cap_clone)
         | "<" name:name                            → (cap_move)
         | "~" name:name                            → (cap_weak)
         | "?" name:name                            → (cap_read)
         | "!" name:name                            → (cap_write)


# ==============================================================================
# OPERANDS
# ==============================================================================

unary    = "-" operand:unary                        → (neg)
         | "<" operand:unary                        → (move)
         | "+" operand:unary                        → (clone)
         | "?" operand:unary                        → (read)
         | "!" operand:unary                        → (write)
         | "*" operand:unary                        → (share)
         | "~" operand:unary                        → (weak)
         | "^" operand:unary                        → (box)
         | postfix

postfix  = object:postfix "." name:name             → (member)
         | object:postfix "[" index:expr "]"        → (index)
         | object:postfix "[" index:open "]"        → (index)
         | object:postfix "[" args:targs "]"        → (inst)
         | callee:postfix "(" args:args ")"         → (call)
         | value:postfix "!"                        → (propagate)
         | value:postfix "?"                        → (propagate_none)
         | atom

# A slice's open range: `xs[a..]`, `xs[..b]`, `xs[..]`. The rewriter
# marks a `..` whose next token is `]` as DOTDOT_OPEN, so `xs[a == b..]`
# ends the expression before it; a `..` that starts an operand needs no
# mark, since no expression starts with one.
open     = left:expr DOTDOT_OPEN                    → (..)
         | ".." right:expr                          → (..)
         | DOTDOT_OPEN                              → (..)

args     = callargs                                 → 1
         | callargs ","                             → 1
         | callargs "," cclosure                    → (...1 3)
         | cclosure                                 → (1)
         |                                          → ()

# Two or more compile-time arguments (`Pair[Int, String]`); sema reads
# one (`Vec[Int]`, an `index`) as compile-time arguments or an index by
# what the object names.
targs    = expr ","                                 → (1)
         | expr "," expr                            → (1 3)
         | expr "," targs                           → (1 ...3)

callargs = callarg                                  → (1)
         | callargs "," callarg                     → (...1 3)

callarg  = name:KWARG_NAME ":" value:expr           → (kwarg)
         | expr

atom     = name
         | ERROR                                    # the type `error`, as a type argument: `List[error]()`
         | INTEGER
         | REAL
         | STRING_SQ
         | STRING_DQ
         | TRUE
         | FALSE
         | "." name:name                            → (enum_lit)
         | "@" name:name "(" args:args ")"          → (builtin)
         | "[" [elems:exprs] "]"                    → (array)
         | "[" elems:exprs "," "]"                  → (array)
         | "[" size:expr OF value:expr "]"          → (array_fill)  # `[n of 0]`
         | "(" expr ")"                             → 2
         | "(" cclosure ")"                         → 2
         | "(" expr "," texprs ![","] ")"           → (tuple 2 ...4)

# ==============================================================================
# INFIX OPERATORS (lowest precedence first; operands are `unary`)
# ==============================================================================

@infix unary
    "==" none, "!=" none, "<" none, ">" none, "<=" none, ">=" none
    "??" right
    ".." none
    "|"  left
    "^"  left
    "&"  left
    "<<" left, "<<%" left, ">>" left
