# A fallible function fails by returning a value of an error set; the
# caller's `catch` supplies the fallback.

error ParseError
  empty

fun parse_len(s: String) -> Int!
  if s == ""
    return ParseError.empty
  s.len

sub main()
  print(parse_len("abc") catch -1)
  print(parse_len("") catch -1)

# expect:
# 3
# -1
