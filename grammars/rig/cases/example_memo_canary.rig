# A Memo-shaped reactive fixture built from substrate pieces. A source
# keeps its value in a shared `Cell` and its listeners in another; `set`
# stores the value and calls each listener with it. `map` derives a new
# source that follows this one through a function; its listener holds
# the derived source weakly, so the chain does not keep itself alive.

type Listeners = List[*sub(Int)]

obj IntSource
  value: Cell[Int]
  listeners: Cell[Listeners]

  fun new(initial: Int) -> *IntSource
    *IntSource(value: Cell(initial), listeners: Cell(List()))

  fun get(?@) -> Int
    @value.get()

  sub subscribe(!@, listener: *sub(Int))
    !@listeners.push(<listener)

  # A Cell lends no view of the List inside it, so the list is swapped
  # out to be walked, and swapped back.
  sub set(!@, v: Int)
    !@value.set(v)
    listeners = (!@listeners).swap(List())
    for listener in ?listeners
      listener(v)
    _ = !@listeners.swap(<listeners)

  fun map(!@, f: *fun(Int) -> Int) -> *IntSource
    derived = IntSource.new(f(@get()))
    !@subscribe(*|~derived, +f, v|
      if *derived as d
        !d.set(f(v))
    )
    derived

sub main()
  count = IntSource.new(1)
  doubled = (!count).map(*|n| n * 2)
  squared = (!doubled).map(*|n| n * n)
  !squared.subscribe(*|n| print("squared", n))
  print(doubled.get(), squared.get())   # 2 4

  !count.set(3)                          # squared 36
  !count.set(5)                          # squared 100
  print(doubled.get(), squared.get())    # 10 100

# expect:
# 2 4
# squared 36
# squared 100
# 10 100
