# Inside a closure, choosing a captured resource with an if-expression
# is still a bare copy of the captured handle; it is rejected like
# `y = count`.

sub main()
  count: *Cell[Int] = *Cell(0)
  f = |+count|
    y = if true
      count
    else
      count
    print(y.get())
  f()
  f()

# error: 9:7: bare use of captured resource `count` in binding would smuggle the handle out of the closure environment; use `+count` to clone a fresh handle, or `~count` for a weak reference
# error: 11:7: bare use of captured resource `count` in binding would smuggle the handle out of the closure environment; use `+count` to clone a fresh handle, or `~count` for a weak reference
