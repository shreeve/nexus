# Inside a closure, choosing a captured resource with an if-expression
# is still a bare copy of the captured handle; it is rejected like
# `y = count`.

sub main()
  count: *Cell[Int] = *Cell(0)
  f = |+count|
    y = if true
      count
    else
      count
    print(y.get())
  f()
  f()

# error: 9:7: `count` is captured by the closure, which keeps it for every call, so a binding can't take it; write `+count` for another handle, or `~count` for a weak one
# error: 11:7: `count` is captured by the closure, which keeps it for every call, so a binding can't take it; write `+count` for another handle, or `~count` for a weak one
