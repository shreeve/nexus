# Type expressions in annotations.

obj Node
  value: Int

fun maybe(n: Int) -> Int?
  n

fun fallible(n: Int) -> Int!
  n

sub types(a: ?Node, b: !Node, c: *Node, d: ~Node, e: Node?, f: *Node?, g: *(Node?))
  print("types")

sub containers(v: List[Int], s: *Cell[List[*sub()]], c: *sub(Int), d: *sub(Int, ?String))
  print("containers")

sub sized(a: U8, b: I64, c: U64, d: F64, e: Bool, f: ?String)
  print("sized")

fun generic[T](x: T) -> T
  x

sub counted[n: Int, T](x: Int)
  print(x)

N = 2

obj Ring[T, n: Int]
  items: [n]T

sub arrays[n: Int](a: [n]Int, b: [N * 2 + 1][n]U8, c: Ring[Int, 4], d: Ring[Int, (N + 1) * 2])
  e = [n of 0]
  print(e)
