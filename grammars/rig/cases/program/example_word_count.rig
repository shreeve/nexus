# Counting words with a hash map. `ensure` puts 0 under a new word and
# lends the count to write, so one line counts every word. The map keeps
# words in the order they first appeared. The counts are then copied into
# a list and ordered with std.sort; `sort_by` keeps equal counts in that
# order.

use std.sort
use std.text

obj Count
  word: ?String
  n: Int

sub main()
  line = "the cat and the dog and the bird"
  seen = Map[?String, Int].new()
  for w in text.words(line)
    c = (!seen).ensure(w, 0)
    c += 1
  print(seen.len, seen.get("the") ?? 0, seen.get("fish") ?? 0)

  counts: List[Count] = List()
  for e in ?seen.items()
    !counts.push(Count(word: e.key, n: e.value))
  sort.sort_by(!counts, |a, b| a.n > b.n)
  for c in ?counts
    print(c.word, c.n)

# expect:
# 5 3 0
# the 3
# and 2
# cat 1
# dog 1
# bird 1
