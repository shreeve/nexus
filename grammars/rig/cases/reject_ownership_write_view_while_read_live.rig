# A write view cannot be taken while a read view of the same value
# is live: used later.

struct User
  name: String

sub rename(u: !User)
  print("rename")

sub main()
  user = User(name: "Steve")
  r = ?user
  rename(!user)
  print(r.name)

# error: cannot lend `user` to write while a read loan is live
