# Every ownership sigil in expression position, plus the binding forms.
# A `!` or `<` before a method call moves onto its receiver.

struct Node
  value: Int

sub consume(n: Node)
  print(n.value)

sub inspect(n: ?Node)
  print(n.value)

sub touch(n: !Node)
  print(n.value)

struct Log
  lines: Vec[Int]

  sub add(!self, n: Int)
    !self.lines.push(n)

  fun close(<self) -> Int
    self.lines.len

sub main()
  a = Node(value: 1)
  inspect(?a)
  touch(!a)
  b = <a
  consume(<b)

  s = *Node(value: 2)
  t = +s
  w = ~t
  <s

  log = Log(lines: Vec())
  !log.add(1)
  !log.add(2)
  (!log).add(3)
  print(<log.close())

  const fixed = 10
  const typed: Int = fixed
  x = 1
  new x = x + 1
  new x: Int = x + typed
  new const x = x + 1
  y = <x

  raw
    p: I32 = @intCast(y)
    print(p)
