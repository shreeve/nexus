# A type may refer to itself through a shared handle or a Vec.

struct Node
  n: Int
  next: *Node?

struct Tree
  n: Int
  kids: Vec[*Tree]

fun sum(t: ?*Tree) -> Int
  total = t.n
  for k in ?t.kids
    total += sum(?k)
  total

sub main()
  a = *Node(n: 1, next: none)
  b = *Node(n: 2, next: +a)
  print(b.n, a.n)
  leaf1 = *Tree(n: 3, kids: Vec())
  leaf2 = *Tree(n: 4, kids: Vec())
  kids: Vec[*Tree] = Vec()
  !kids.push(<leaf1)
  !kids.push(<leaf2)
  root = *Tree(n: 5, kids: <kids)
  print(sum(?root))

# expect:
# 2 1
# 12
