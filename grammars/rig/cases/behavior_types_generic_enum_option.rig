# A generic enum `Option[T]`: the variant payload `value: T` is checked
# against the expected `Option[Int]`, and a match selects the arm.

enum Option[T]
  some(value: T)
  empty

sub main()
  o: Option[Int] = .some(value: 5)
  match o
    .some(v) => print(v)
    .empty => print("nothing")

# expect:
# 5
