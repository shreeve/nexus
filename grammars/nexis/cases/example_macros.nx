; examples/macros.nx — macros: functions that run when the code is
; compiled, take their arguments unevaluated as data, and return the code
; that takes their place. Syntax-quote (`) writes that code as a template.
;
;   bin/nexis run examples/macros.nx

; ~ (unquote) puts a value into the template, ~@ (unquote-splicing)
; puts in the elements of a list.
(defmacro unless [test & body]
  `(if ~test nil (do ~@body)))

(prn (unless false :ran) (unless true :skipped))

; macroexpand-1 shows what a call becomes.
(prn (macroexpand-1 '(unless (empty? xs) (println "work") :done)))

; Because the arguments are not evaluated first, a macro decides whether
; and how often each one runs.
(unless true (println "this never prints"))

; Other symbols in a template are qualified with their namespace (loop
; becomes nexis.core/loop), so the expansion means the same wherever it
; lands. A name ending in # is an auto-gensym: a fresh symbol in each
; expansion, so the macro's locals cannot capture the caller's.
(defmacro with-retries
  "Runs body, retrying up to n times while it throws; the last try's
  error propagates."
  [n & body]
  `(loop [attempt# 1]
     (let [[ok# value#] (try [true (do ~@body)]
                             (catch any e#
                               (if (< attempt# ~n) [false] (throw e#))))]
       (if ok# value# (recur (inc attempt#))))))

; A flaky operation: fails twice, then succeeds.
(def calls (atom 0))
(defn flaky []
  (if (< (swap! calls inc) 3)
    (throw :not-yet)
    :finally-worked))

(prn (with-retries 5 (flaky)) @calls)
(reset! calls 0)
(prn (try (with-retries 2 (flaky)) (catch :not-yet e [:gave-up-with e])))

; The macro body is ordinary code run at compile time: here it turns
; the list of checks into [quoted-name test] pairs for the expansion.
(defmacro when-valid
  "Evaluates body with name bound to value when every check, a predicate
  of name, holds; else returns a map of the checks that failed."
  [[name value] checks & body]
  `(let [~name ~value
         failed# (vec (remove (fn [[_# ok#]] ok#)
                              ~(mapv (fn [check] [(list 'quote check) (list check name)])
                                     checks)))]
     (if (empty? failed#)
       (do ~@body)
       {:invalid ~name :failed (mapv first failed#)})))

(prn (when-valid [n 42] [integer? pos? even?] (* n 2)))
(prn (when-valid [n -3] [integer? pos? even?] (* n 2)))
