; examples/defmacro.nx — user-defined macros via defmacro.
;
; A user macro is a fn that runs at COMPILE TIME, takes
; unevaluated arg Forms as data, and returns a Form that
; replaces the call site. These macros use syntax-quote to
; build their output (`/`~`/`~@`); collection-manipulation
; fns like cons/first/rest are host builtins in the stdlib.
;
; defmacro mechanics:
;   - The macro fn body is evaluated at expansion time in a
;     fresh sub-VM that shares the user's namespace and
;     interner (so macros can def Vars, intern symbols, etc.).
;   - Macros defined earlier in the same compilation unit
;     are visible to subsequent forms.
;   - Lexical bindings shadow macros (let-bound `when` is a
;     local, not a macro invocation).

(defmacro unless [test body]
  `(if ~test nil ~body))

(defmacro my-when [test & body]
  `(if ~test (do ~@body) nil))

; A symbol inside syntax-quote qualifies to its namespace, so a
; binding introduced by a macro is written `x#`: the auto-gensym
; stays bare and is fresh per expansion.
(defmacro safe-div [a b]
  `(if (< 0 ~b) (let [x# (/ ~a ~b)] x#) :div-by-zero))

(println (safe-div 6 3) (safe-div 1 0))

(println (my-when (unless false true)
  :all-the-macros-work
  :and-the-do-block-returns-this-last-one))
