; examples/shapes.nx — protocols and records. A protocol names a set of
; functions; a record is a map with a type that can implement them; and
; extend-protocol teaches a protocol to types that already exist.
;
;   bin/nexis run examples/shapes.nx   (examples/shapes-app.nx splits it
;                                       into namespaces)

(defprotocol Shape
  (area [shape] "The area of the shape.")
  (describe [shape] "A short description."))

; Inside a record's methods its fields are locals.
(defrecord Circle [radius]
  Shape
  (area [_] (* 3.14159 radius radius))
  (describe [_] (str "a circle of radius " radius)))

(defrecord Rect [width height]
  Shape
  (area [_] (* width height))
  (describe [_] (str "a " width "x" height " rectangle")))

; Built-in kinds can implement a protocol too: here a number is the side
; of a square, a string is a label with no area, and nil is nothing.
(extend-protocol Shape
  :fixnum
  (area [n] (* n n))
  (describe [n] (str "a square of side " n))

  :string
  (area [_] 0)
  (describe [s] (str "the label " (pr-str s)))

  nil
  (area [_] 0)
  (describe [_] "nothing"))

(def shapes [(->Circle 1) (->Rect 3 4) 5 "north" nil])

(doseq [s shapes]
  (println (format "%-24s area %.2f" (describe s) (double (area s)))))

(println "total area:" (format "%.2f" (reduce + (map area shapes))))

; satisfies? asks whether a value's type implements a protocol.
(prn (map #(satisfies? Shape %) [(->Rect 1 1) 7 :keyword]))

; ->Rect takes the fields in order; map->Rect takes a map.
(def r (map->Rect {:width 2 :height 5}))
(prn r (= r (->Rect 2 5)) (instance? Rect r))

; A record is still a map: keywords, assoc, keys and update all work,
; and the result is still a Rect.
(prn (:width r) (keys r))
(prn (assoc r :color :blue))
(prn (area (update r :width * 10)))
