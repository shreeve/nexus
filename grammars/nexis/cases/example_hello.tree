(program
  (list
    `(`
    (symbol `defn`)
    (symbol `greet`)
    (string `"A greeting for one name."`)
    (vector `[` (symbol `name`) `]`)
    (list `(` (symbol `str`) (string `"Hello, "`) (symbol `name`) (string `"!"`) `)`)
    `)`)
  (list
    `(`
    (symbol `println`)
    (list
      `(`
      (symbol `greet`)
      (list
        `(`
        (symbol `or`)
        (list `(` (symbol `first`) (symbol `*command-line-args*`) `)`)
        (string `"world"`)
        `)`)
      `)`)
    `)`))
