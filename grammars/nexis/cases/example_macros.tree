                  (symbol `mapv`)
                  (list
                    `(`
                    (symbol `fn`)
                    (vector `[` (symbol `check`) `]`)
                    (vector
                      `[`
                      (list `(` (symbol `list`) (quote `'` (symbol `quote`)) (symbol `check`) `)`)
                      (list `(` (symbol `list`) (symbol `check`) (symbol `name`) `)`)
                      `]`)
                    `)`)
                  (symbol `checks`)
                  `)`))
              `)`)
            `)`)
          `]`)
        (list
          `(`
          (symbol `if`)
          (list `(` (symbol `empty?`) (symbol `failed#`) `)`)
          (list `(` (symbol `do`) (unquote-splicing `~@` (symbol `body`)) `)`)
          (map
            `{`
            (keyword `:invalid`)
            (unquote `~` (symbol `name`))
            (keyword `:failed`)
            (list `(` (symbol `mapv`) (symbol `first`) (symbol `failed#`) `)`)
            `}`)
          `)`)
        `)`))
    `)`)
  (list
    `(`
    (symbol `prn`)
    (list
      `(`
      (symbol `when-valid`)
