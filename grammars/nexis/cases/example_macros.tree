          (symbol `unless`)
          (list `(` (symbol `empty?`) (symbol `xs`) `)`)
          (list `(` (symbol `println`) (string `"work"`) `)`)
          (keyword `:done`)
          `)`))
      `)`)
    `)`)
  (list
    `(`
    (symbol `unless`)
    (symbol `true`)
    (list `(` (symbol `println`) (string `"this never prints"`) `)`)
    `)`)
  (list
    `(`
    (symbol `defmacro`)
    (symbol `with-retries`)
    (string
      `"Runs body, retrying up to n times while it throws; the last try's\n  error propagates."`)
    (vector `[` (symbol `n`) (symbol `&`) (symbol `body`) `]`)
    (syntax-quote
      `\``
      (list
        `(`
        (symbol `loop`)
        (vector `[` (symbol `attempt#`) (int `1`) `]`)
        (list
          `(`
          (symbol `let`)
          (vector
            `[`
            (vector `[` (symbol `ok#`) (symbol `value#`) `]`)
            (list
              `(`
              (symbol `try`)
              (vector
                `[`
                (symbol `true`)
                (list `(` (symbol `do`) (unquote-splicing `~@` (symbol `body`)) `)`)
                `]`)
              (list
                `(`
                (symbol `catch`)
                (symbol `any`)
                (symbol `e#`)
                (list
                  `(`
                  (symbol `if`)
                  (list `(` (symbol `<`) (symbol `attempt#`) (unquote `~` (symbol `n`)) `)`)
                  (vector `[` (symbol `false`) `]`)
                  (list `(` (symbol `throw`) (symbol `e#`) `)`)
                  `)`)
                `)`)
              `)`)
            `]`)
          (list
            `(`
            (symbol `if`)
            (symbol `ok#`)
            (symbol `value#`)
            (list `(` (symbol `recur`) (list `(` (symbol `inc`) (symbol `attempt#`) `)`) `)`)
            `)`)
          `)`)
        `)`))
    `)`)
  (list `(` (symbol `def`) (symbol `calls`) (list `(` (symbol `atom`) (int `0`) `)`) `)`)
  (list
    `(`
    (symbol `defn`)
    (symbol `flaky`)
    (vector `[` `]`)
    (list
      `(`
      (symbol `if`)
      (list
        `(`
        (symbol `<`)
        (list `(` (symbol `swap!`) (symbol `calls`) (symbol `inc`) `)`)
        (int `3`)
        `)`)
      (list `(` (symbol `throw`) (keyword `:not-yet`) `)`)
      (keyword `:finally-worked`)
      `)`)
    `)`)
  (list
    `(`
    (symbol `prn`)
    (list `(` (symbol `with-retries`) (int `5`) (list `(` (symbol `flaky`) `)`) `)`)
    (deref `@` (symbol `calls`))
    `)`)
  (list `(` (symbol `reset!`) (symbol `calls`) (int `0`) `)`)
  (list
    `(`
    (symbol `prn`)
    (list
      `(`
      (symbol `try`)
      (list `(` (symbol `with-retries`) (int `2`) (list `(` (symbol `flaky`) `)`) `)`)
      (list
        `(`
        (symbol `catch`)
        (keyword `:not-yet`)
        (symbol `e`)
        (vector `[` (keyword `:gave-up-with`) (symbol `e`) `]`)
        `)`)
      `)`)
    `)`)
  (list
    `(`
    (symbol `defmacro`)
    (symbol `when-valid`)
    (string
      `"Evaluates body with name bound to value when every check, a predicate\n  of name, holds; else returns a map of the checks that failed."`)
    (vector
      `[`
      (vector `[` (symbol `name`) (symbol `value`) `]`)
      (symbol `checks`)
      (symbol `&`)
      (symbol `body`)
      `]`)
    (syntax-quote
      `\``
      (list
        `(`
        (symbol `let`)
        (vector
          `[`
          (unquote `~` (symbol `name`))
          (unquote `~` (symbol `value`))
          (symbol `failed#`)
          (list
            `(`
            (symbol `vec`)
            (list
              `(`
              (symbol `remove`)
              (list
                `(`
                (symbol `fn`)
                (vector `[` (vector `[` (symbol `_#`) (symbol `ok#`) `]`) `]`)
                (symbol `ok#`)
                `)`)
              (unquote
                `~`
                (list
