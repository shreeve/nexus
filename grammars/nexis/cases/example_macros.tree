(program
  (list
    `(`
    (symbol `defmacro`)
    (symbol `unless`)
    (vector `[` (symbol `test`) (symbol `&`) (symbol `body`) `]`)
    (syntax-quote
      `\``
      (list
        `(`
        (symbol `if`)
        (unquote `~` (symbol `test`))
        (symbol `nil`)
        (list `(` (symbol `do`) (unquote-splicing `~@` (symbol `body`)) `)`)
        `)`))
    `)`)
  (list
    `(`
