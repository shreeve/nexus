; examples/hello.nx — the first program: a function, a string, a print.
;
;   bin/nexis run examples/hello.nx         prints Hello, world!
;   bin/nexis run examples/hello.nx Ada     prints Hello, Ada!

(defn greet
  "A greeting for one name."
  [name]
  (str "Hello, " name "!"))

; *command-line-args* holds the words after the file name, or nil
; when there are none.
(println (greet (or (first *command-line-args*) "world")))
