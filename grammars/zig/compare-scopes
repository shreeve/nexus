#!/bin/bash
# Compares the names zig.grammar's @lsp resolves (the index the language
# server `nexus --editor` writes keeps, scopes.zig) with the compiler's
# own name resolution (std.zig.AstGen of the Zig that runs this script,
# which must be 0.17.0), input by input: every definition the index makes
# in a scope chain, and every use it resolves to one, is renamed to a name
# of its own, and AstGen must accept the renamed file as it accepts the
# file; a use the index leaves unresolved must be a primitive or `_`.
#
# Usage:
#   grammars/zig/compare-scopes [options] (DIR|FILE|--list LIST)...
#
#   DIR             every *.zig file under DIR
#   --list LIST     the paths in LIST, one per line
#   --show          name each input on which the two agree
#   -O MODE         optimize mode of the tool (default safe)
#
# The tool is built in .zig-cache/nexus-grammars/zig-scopes/ beside the
# server this checkout's bin/nexus writes (run `zig build` first). Inputs
# AstGen rejects are not compared. It prints one line per disagreement
# and a summary of the counts; it exits 1 when there is any.

set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../.." && pwd)
OUT="$ROOT/.zig-cache/nexus-grammars/zig-scopes"
MODE=safe TOOL_ARGS=()
LIST="$OUT/list.txt"
mkdir -p "$OUT"
: >"$LIST.new"
while [[ $# -gt 0 ]]; do
    case $1 in
        --list) cat "$2" >>"$LIST.new"; shift ;;
        --show) TOOL_ARGS+=(--show) ;;
        -O) MODE=$2; shift ;;
        -h|--help) awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
        -*) echo "unknown option $1" >&2; exit 2 ;;
        *)
            if [[ -d $1 ]]; then
                find "$(cd "$1" && pwd)" -name '*.zig' -type f | LC_ALL=C sort >>"$LIST.new"
            elif [[ -f $1 ]]; then
                echo "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")" >>"$LIST.new"
            else
                echo "no such file or directory: $1" >&2; exit 2
            fi ;;
    esac
    shift
done
mv "$LIST.new" "$LIST"
[[ -s $LIST ]] || { echo "no input files" >&2; exit 2; }

# Build: write the server's files, compile the tool beside them.
NEXUS="$ROOT/bin/nexus"
[[ -x $NEXUS ]] || { echo "$NEXUS not found: run zig build" >&2; exit 2; }
(cd "$HERE" && "$NEXUS" --editor --lang zig.zig zig.grammar "$OUT") >"$OUT/gen.log" 2>&1 || { cat "$OUT/gen.log" >&2; exit 2; }
cp "$HERE/tools/compare_scopes.zig" "$OUT/server/src/"
(cd "$OUT/server/src" && zig build-exe -O "$MODE" compare_scopes.zig -femit-bin=../compare_scopes --cache-dir "$ROOT/.zig-cache/nexus-grammars/zig") \
    >"$OUT/compile.log" 2>&1 || { cat "$OUT/compile.log" >&2; exit 2; }

exec "$OUT/server/compare_scopes" ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"} --list "$LIST"
