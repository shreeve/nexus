# nexus.grammar: the @parser section of a Nexus grammar file, described in
# Nexus's own format (self-hosting).
#
# Nexus generates its frontend parser (src/frontend/parser.zig) from this
# file, with src/frontend/lang.zig as the @lang module. The frontend turns
# the text after `@parser` into the S-expression tree documented below,
# which src/frontend/lower.zig lowers into the grammar IR. The lexer wrapper
# in lang.zig handles layout, comments, labels, contextual keywords, and
# action scanning; see its header for the token stream this grammar reads.
#
# -----------------------------------------------------------------------------
# Canonical S-expression schema (the contract with the lowerer)
# -----------------------------------------------------------------------------
#
# SRC is a source leaf; `_` is nil. Trailing nil children are omitted from
# every list (the frontend is a schema-less grammar), so a shape written
# `(t A B?)` has one or two children.
#
#     (grammar ENTRY ...)                   one ENTRY per directive or rule
#
# --- Directives ---
#
#     (lang      STRING)
#     (conflicts INTEGER)                   `@conflicts = N` (legacy count)
#     (manifest  CONFLICT ...)              `@conflicts` block
#     (as        TOKEN VIA AS_ENTRY ...)    VIA: _ or IDENT (the `via` function)
#     (op        OP_MAP ...)
#     (errors    NAME_PAIR ...)
#     (display   NAME_PAIR ...)
#     (infix     IDENT LEVEL ...)
#     (schema    KIND_DECL ...)
#     (tags      NAME ...)                  NAME: IDENT, TOKEN or STRING
#     (trivia    NAME ...)
#     (repair    REPAIR_LINE ...)
#
#     CONFLICT:    (conflict KIND CRULE OVER? COUNT? REASON?)
#                  KIND: IDENT (shift|reduce); OVER: _ or CRULE;
#                  COUNT: INTEGER; REASON: COMMENT
#     CRULE:       (crule LHS SYM ...)      SYM: IDENT, TOKEN, STRING or EPSILON
#     AS_ENTRY:    (as_entry PERM IDENT VIA?)   PERM: _ or perm (`name!`)
#     OP_MAP:      (op_map STRING STRING)
#     NAME_PAIR:   (name_pair KEY STRING)   KEY: LABEL (`name:`) or STRING
#     LEVEL:       (level INFIX_OP ...)
#     INFIX_OP:    (infix_op STRING ASSOC)  ASSOC: left, right, none or IDENT
#     KIND_DECL:   (kind_decl (kinds NAME ...) (roles ROLE ...) SIDES? WRAPPER?)
#                  SIDES: _ or (sides IDENT ...); WRAPPER: wrapper
#     ROLE:        (role REST NAME TYPE? OPT?)   REST: _ or rest; OPT: opt
#     TYPE:        (type ATOM ...)          ATOM: IDENT, STRING, or
#                  (tagset IDENT VALUE ...)  for `tag(a|b)`
#     REPAIR_LINE: (repair_line IDENT NAME ...)
#
# --- Rules ---
#
#     (rule RULE_NAME ALT ...)              always >= 1 alternative
#     RULE_NAME: (start SRC) for `name!`, (name SRC) otherwise
#     ALT:       (alt HINT ELEMENTS ACTION? OPTOUT?)
#                HINT: _, reduce (`<`) or shift (`>`); ELEMENTS: a list;
#                ACTION: _ or an action; OPTOUT: STRING (`~ "reason"`)
#
# --- Elements ---
#
#     (ref SRC)  (tok SRC)  (lit SRC)  (at_ref SRC)
#     (list_req TOKEN LIST_INNER)           L(...)
#     (group KIND BODY ...)                 KIND: _ `( )`, opt `[ ]`, many `[X ...]`
#     (quantified ELEMENT QUANT)            X? X* X+
#     (skip ELEMENT)  (skip_q ELEMENT QUANT)
#     (exclude STRING)                      X "c"
#     (label LABEL ELEMENT)                 role:X, and (A | B):role
#
#     BODY is a list of ELEMENTs; QUANT is (opt), (zero_plus) or (one_plus).
#     LIST_INNER: (plain ITEM) (opt_items_nosep ITEM)
#                 (sep_items ITEM SEP) (opt_items ITEM SEP)
#
# --- Actions ---
#
#     (pos INTEGER)                         → N
#     (null)                                → _
#     (node WORD ITEM ...)                  (tag ...)
#     (list ITEM ...)                       (...) without a head tag
#     (keep INTEGER ITEM ...)               (!N ...): headed by element N
#
#     ITEM: VALUE, or (named LABEL VALUE)   role:value
#     VALUE: (pos N) (spread N) (symid N) (null) (tag WORD) or a nested
#            node / list / keep
#
# Every lowering entry point accepts exactly these shapes; anything else is
# a hard error with a source position.
# -----------------------------------------------------------------------------

@lexer

tokens
    ident
    token
    label
    kw_x
    kw_list
    string
    integer
    word
    eq
    pipe
    union
    arrow
    question
    star
    plus
    lparen
    rparen
    lbracket
    rbracket
    langle
    rangle
    comma
    colon
    bang
    tilde
    dots
    at
    epsilon
    newline
    cont
    next_alt
    comment
    kw_nil
    kw_lang
    kw_conflicts
    kw_as
    kw_op
    kw_errors
    kw_display
    kw_infix
    kw_schema
    kw_tags
    kw_trivia
    kw_repair
    kw_wrapper
    kw_via
    kw_over
    kw_left
    kw_right
    kw_none
    eof
    err

# Whitespace (spaces and tabs only; the wrapper handles line breaks)
[ \t\r]+                                    → skip

# Comments
'#' [^\n]*                                  → comment

'\n'                                        → newline

# Arrows (the Unicode arrow is scanned by the wrapper)
"->"                                        → arrow

# Punctuation
'='                                         → eq
'|'                                         → pipe
'?'                                         → question
'*'                                         → star
'+'                                         → plus
'('                                         → lparen
')'                                         → rparen
'['                                         → lbracket
']'                                         → rbracket
'<'                                         → langle
'>'                                         → rangle
','                                         → comma
':'                                         → colon
'!'                                         → bang
'~'                                         → tilde
'@'                                         → at

"..."                                       → dots

# Strings (double-quoted with backslash escapes)
'"' ([^"\\\n] | '\\' .)* '"'                → string

[0-9]+                                      → integer

# Words (classified by the wrapper: ident, token, label, keywords)
[a-zA-Z_][a-zA-Z0-9_]*                      → ident

.                                           → err

@parser

@lang = "lang"
@conflicts = 0

# ===========================================================================
# Top level: entries separated by line breaks
# ===========================================================================

grammar! = body                             → 1

body     = entries                          → (grammar ...1)
         |                                  → (grammar)

entries  = entry                            → (1)
         | entries NEWLINE entry            → (...1 3)
         | entries NEWLINE                  → 1

entry    = directive
         | production

# ===========================================================================
# Directives
# ===========================================================================

directive = "@" KW_LANG "=" STRING          → (lang 4)
          | "@" KW_CONFLICTS "=" INTEGER    → (conflicts 4)
          | "@" KW_CONFLICTS conflict_lines → (manifest ...3)
          | "@" KW_AS as_body               → (as ...3)
          | "@" KW_OP "=" "[" op_items "]"  → (op ...5)
          | "@" KW_ERRORS name_pairs        → (errors ...3)
          | "@" KW_DISPLAY name_pairs       → (display ...3)
          | "@" KW_INFIX IDENT infix_rows   → (infix 3 ...4)
          | "@" KW_SCHEMA schema_lines      → (schema ...3)
          | "@" KW_TAGS name_list           → (tags ...3)
          | "@" KW_TRIVIA name_list         → (trivia ...3)
          | "@" KW_REPAIR repair_lines      → (repair ...3)

# --- @conflicts block: `kind lhs → rhs [over lhs → rhs] count # reason` ---

conflict_lines = CONT conflict_line                 → (2)
               | conflict_lines CONT conflict_line  → (...1 3)

conflict_line = IDENT crule INTEGER COMMENT                 → (conflict 1 2 _ 3 4)
              | IDENT crule INTEGER                         → (conflict 1 2 _ 3)
              | IDENT crule KW_OVER crule INTEGER COMMENT   → (conflict 1 2 4 5 6)
              | IDENT crule KW_OVER crule INTEGER           → (conflict 1 2 4 5)

crule     = IDENT ARROW csyms               → (crule 1 ...3)

csyms     = csym                            → (1)
          | csyms csym                      → (...1 2)

csym      = IDENT
          | TOKEN
          | STRING
          | EPSILON

# --- @as TOKEN [via fn] = [group[!] [via fn], ...] ---

as_body  = as_token "=" "[" as_list "]"                 → (1 _ ...4)
         | as_token KW_VIA IDENT "=" "[" as_list "]"    → (1 3 ...6)

as_token = IDENT
         | TOKEN

as_list  = as_entry                         → (1)
         | as_list "," as_entry             → (...1 3)

as_entry = IDENT "!"                        → (as_entry perm 1)
         | IDENT                            → (as_entry _ 1)
         | IDENT "!" KW_VIA IDENT           → (as_entry perm 1 4)
         | IDENT KW_VIA IDENT               → (as_entry _ 1 3)

# --- @op = [ "lit" → "token", ... ] (line breaks inside brackets are blanks) ---

op_items = op_item                          → (1)
         | op_items op_item                 → (...1 2)
         | op_items ","                     → 1

op_item  = STRING ARROW STRING              → (op_map 1 3)

# --- @errors / @display: `key: "name"` pairs, inline or on indented lines ---

name_pairs = pair_line                      → 1
           | CONT pair_line                 → 2
           | name_pairs CONT pair_line      → (...1 ...3)

pair_line  = name_pair                      → (1)
           | pair_line "," name_pair        → (...1 3)
           | pair_line ","                  → 1

name_pair  = LABEL STRING                   → (name_pair 1 2)
           | STRING ":" STRING              → (name_pair 1 3)

# --- @infix base, then one indented line per precedence level ---

infix_rows = CONT infix_row                 → (2)
           | infix_rows CONT infix_row      → (...1 3)

infix_row  = infix_ops                      → (level ...1)

infix_ops  = infix_op                       → (1)
           | infix_ops "," infix_op         → (...1 3)

infix_op   = STRING KW_LEFT                 → (infix_op 1 2)
           | STRING KW_RIGHT                → (infix_op 1 2)
           | STRING KW_NONE                 → (infix_op 1 2)
           | STRING IDENT                   → (infix_op 1 2)

# --- @schema: one indented line per kind (or comma-separated kinds) ---

schema_lines = CONT kind_decl               → (2)
             | schema_lines CONT kind_decl  → (...1 3)

kind_decl  = kind_names roles                           → (kind_decl 1 2)
           | kind_names roles "|" side_names            → (kind_decl 1 2 4)
           | kind_names roles "@" KW_WRAPPER            → (kind_decl 1 2 _ wrapper)
           | kind_names roles "|" side_names "@" KW_WRAPPER → (kind_decl 1 2 4 wrapper)

kind_names = kind_name                      → (kinds 1)
           | kind_names "," kind_name       → (...1 3)

kind_name  = IDENT
           | STRING

roles      =                                → (roles)
           | roles role                     → (...1 2)

role       = IDENT                          → (role _ 1)
           | IDENT "?"                      → (role _ 1 _ opt)
           | LABEL role_type                → (role _ 1 2)
           | LABEL role_type "?"            → (role _ 1 2 opt)
           | "..." IDENT                    → (role rest 2)
           | "..." LABEL role_type          → (role rest 2 3)

role_type  = type_atom                      → (type 1)
           | role_type UNION type_atom      → (...1 3)

type_atom  = IDENT
           | STRING
           | IDENT "(" tag_values ")"       → (tagset 1 ...3)

tag_values = tag_value                      → (1)
           | tag_values UNION tag_value     → (...1 3)

tag_value  = IDENT
           | STRING

side_names = IDENT                          → (sides 1)
           | side_names IDENT               → (...1 2)

# --- @tags / @trivia: names on the directive line and indented lines ---

name_list  = name_items                     → 1
           | CONT name_items                → 2
           | name_list CONT name_items      → (...1 ...3)

name_items = name_item                      → (1)
           | name_items name_item           → (...1 2)

name_item  = IDENT
           | TOKEN
           | STRING

# --- @repair: `holes TOKEN ...` / `structure TOKEN ...` lines ---

repair_lines = CONT repair_line             → (2)
             | repair_lines CONT repair_line → (...1 3)

repair_line  = IDENT name_items             → (repair_line 1 ...2)

# ===========================================================================
# Productions
#
#   rule_name "=" alternative
#     | alternative                 (a line starting with `|`: next_alt)
#
# An indented line that does not start with `|` continues the current
# alternative (its pattern or its action).
# ===========================================================================

production = rule_name "=" alts             → (rule 1 ...3)

rule_name  = IDENT "!"                      → (start 1)
           | IDENT                          → (name 1)
           | TOKEN "!"                      → (start 1)
           | TOKEN                          → (name 1)

alts       = alt_line                       → (1)
           | alts "|" alt_line              → (...1 3)
           | alts NEXT_ALT alt_line         → (...1 3)

alt_line   = elements                                       → (alt _ 1)
           | elements "<"                                   → (alt reduce 1)
           | elements ">"                                   → (alt shift 1)
           | elements ARROW action                          → (alt _ 1 3)
           | elements "<" ARROW action                      → (alt reduce 1 4)
           | elements ">" ARROW action                      → (alt shift 1 4)
           | elements ARROW action "~" STRING               → (alt _ 1 3 5)
           | elements "<" ARROW action "~" STRING           → (alt reduce 1 4 6)
           | elements ">" ARROW action "~" STRING           → (alt shift 1 4 6)

elements   =                                → ()
           | elements element               → (...1 2)
           | elements CONT                  → 1

element    = LABEL labelable                → (label 1 2)
           | group_paren ":" IDENT          → (label 3 1)
           | labelable
           | "!" primary quantifier         → (skip_q 2 3)
           | "!" primary                    → (skip 2)
           | KW_X STRING                    → (exclude 2)

labelable  = primary quantifier             → (quantified 1 2)
           | primary

primary    = IDENT                          → (ref 1)
           | TOKEN                          → (tok 1)
           | STRING                         → (lit 1)
           | KW_LIST "(" list_inner ")"     → (list_req 1 3)
           | "@" IDENT                      → (at_ref 2)
           | "@" KW_INFIX                   → (at_ref 2)
           | group_paren
           | "[" bracket_body "]"           → 2

group_paren = "(" alt_group ")"             → (group _ ...2)

bracket_body = alt_group "..."              → (group many ...1)
             | alt_group "," "..."          → (group many ...1)
             | alt_group                    → (group opt ...1)

list_inner = list_item                      → (plain 1)
           | list_item "?"                  → (opt_items_nosep 1)
           | list_item "," sep_term         → (sep_items 1 3)
           | list_item "?" "," sep_term     → (opt_items 1 4)

list_item  = IDENT
           | TOKEN

sep_term   = STRING
           | TOKEN

alt_group  = alt_elem                       → (1)
           | alt_group "|" alt_elem         → (...1 3)

alt_elem   = element                        → (1)
           | alt_elem element               → (...1 2)

quantifier = "?"                            → (opt)
           | "*"                            → (zero_plus)
           | "+"                            → (one_plus)

# ===========================================================================
# Actions
# ===========================================================================

action     = INTEGER                        → (pos 1)
           | KW_NIL                         → (null)
           | sexp

sexp       = "(" WORD items ")"             → (node 2 ...3)
           | "(" "!" INTEGER items ")"      → (keep 3 ...4)
           | "(" items_nohead ")"           → (list ...2)

items_nohead =                              → ()
             | first_item items             → (1 ...2)

items      =                                → ()
           | items item                     → (...1 2)

first_item = LABEL value                    → (named 1 2)
           | plain_value

item       = LABEL value                    → (named 1 2)
           | value

value      = plain_value
           | WORD                           → (tag 1)

plain_value = INTEGER                       → (pos 1)
            | "..." INTEGER                 → (spread 2)
            | "~" INTEGER                   → (symid 2)
            | KW_NIL                        → (null)
            | sexp
