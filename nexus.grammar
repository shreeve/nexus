# nexus.grammar: the @parser section of a Nexus grammar file, described in
# Nexus's own format (self-hosting).
#
# Nexus generates its frontend parser (src/frontend/parser.zig) from this
# file, with src/frontend/lang.zig as the @lang module. The frontend turns
# the text after `@parser` into the S-expression tree documented below,
# which src/frontend/lower.zig lowers into the grammar IR. The lexer wrapper
# in lang.zig handles layout, comments, labels, contextual keywords, and
# action scanning; see its header for the token stream this grammar reads.
#
# The tree the frontend builds is declared by the @schema block below: one
# kind per line with its roles in slot order. It is the contract with
# lower.zig, which accepts exactly those shapes (every list has all of its
# slots; `_` where an optional role is absent) and reports anything else as
# a hard error with a source position.

@lexer

tokens
    ident
    token
    label
    kw_x
    kw_list
    string
    integer
    word
    eq
    pipe
    union
    arrow
    question
    star
    plus
    lparen
    rparen
    lbracket
    rbracket
    langle
    rangle
    comma
    colon
    bang
    tilde
    dots
    at
    rule_text
    newline
    cont
    next_alt
    comment
    kw_nil
    kw_lang
    kw_conflicts
    kw_as
    kw_op
    kw_errors
    kw_display
    kw_infix
    kw_schema
    kw_tags
    kw_trivia
    kw_repair
    kw_wrapper
    kw_via
    kw_over
    kw_left
    kw_right
    kw_none
    eof
    err

# Whitespace (spaces and tabs only; the wrapper handles line breaks)
[ \t\r]+                                    → skip, skip

# Comments
'#' [^\n]*                                  → comment

'\n'                                        → newline

# Arrows (the Unicode arrow is scanned by the wrapper)
"->"                                        → arrow

# Punctuation
'='                                         → eq
'|'                                         → pipe
'?'                                         → question
'*'                                         → star
'+'                                         → plus
'('                                         → lparen
')'                                         → rparen
'['                                         → lbracket
']'                                         → rbracket
'<'                                         → langle
'>'                                         → rangle
','                                         → comma
':'                                         → colon
'!'                                         → bang
'~'                                         → tilde
'@'                                         → at

"..."                                       → dots

# Strings (double-quoted with backslash escapes)
'"' ([^"\\\n] | '\\' .)* '"'                → string

[0-9]+                                      → integer

# Words (classified by the wrapper: ident, token, label, keywords)
[a-zA-Z_][a-zA-Z0-9_]*                      → ident

.                                           → err

@parser

@lang = "lang"

# ===========================================================================
# The tree
# ===========================================================================

@schema
    grammar          ...entries

    # Directives
    lang             name:leaf
    conflicts        count:leaf
    manifest         ...entries:conflict
    conflict         kind:leaf rule:leaf over:leaf? count:leaf reason:leaf?
    as               token:leaf via:leaf? ...groups:as_entry
    as_entry         perm:tag(perm)? group:leaf via:leaf?
    op               ...maps:op_map
    op_map           lit:leaf token:leaf
    errors, display  ...pairs:name_pair
    name_pair        key:leaf name:leaf
    infix            base:leaf ...levels:level
    level            ...ops:infix_op
    infix_op         op:leaf assoc:leaf
    schema           ...decls:kind_decl
    kind_decl        kinds:kinds roles:roles sides:sides? wrapper:tag(wrapper)?
    kinds, sides     ...names:leaf
    roles            ...roles:role
    role             rest:tag(rest)? name:leaf type:type? opt:tag(opt)?
    type             ...atoms
    tagset           tag:leaf ...values:leaf
    tags, trivia     ...names:leaf
    repair           ...lines:repair_line
    repair_line      class:leaf ...names:leaf

    # Rules
    rule             name:start|name ...alts:alt
    start, name      id:leaf
    alt              hint:leaf? elements:group action:pos|null|"node"|list|keep? optout:leaf?

    # Pattern elements
    ref, tok, lit, at_ref      name:leaf
    list_req                   keyword:leaf inner:plain|opt_items_nosep|sep_items|opt_items
    plain, opt_items_nosep     item:leaf
    sep_items, opt_items       item:leaf sep:leaf
    group                      kind:tag(many|opt)? ...bodies:group
    quantified, skip_q         element quant:opt|zero_plus|one_plus
    skip                       element
    exclude                    char:leaf
    label                      name:leaf element
    opt, zero_plus, one_plus

    # Actions
    pos, spread, symid         n:leaf
    null
    tag                        word:leaf
    named                      role:leaf value
    node                       head:leaf ...items
    list                       ...items
    keep                       n:leaf ...items

# ===========================================================================
# Top level: entries separated by line breaks
# ===========================================================================

grammar! = entries                          → (grammar ...1)
         |                                  → (grammar)

entries  = entry                            → (1)
         | entries NEWLINE entry            → (...1 3)
         | entries NEWLINE                  → 1

entry    = directive
         | production

# ===========================================================================
# Directives
# ===========================================================================

directive = "@" KW_LANG "=" name:STRING                 → (lang)
          | "@" KW_CONFLICTS "=" count:INTEGER          → (conflicts)
          | "@" KW_CONFLICTS entries:conflict_lines     → (manifest)
          | "@" KW_AS as_body                           → 3
          | "@" KW_OP "=" "[" maps:op_items "]"         → (op)
          | "@" KW_ERRORS pairs:name_pairs              → (errors)
          | "@" KW_DISPLAY pairs:name_pairs             → (display)
          | "@" KW_INFIX base:IDENT levels:infix_rows   → (infix)
          | "@" KW_SCHEMA decls:schema_lines            → (schema)
          | "@" KW_TAGS names:name_list                 → (tags)
          | "@" KW_TRIVIA names:name_list               → (trivia)
          | "@" KW_REPAIR lines:repair_lines            → (repair)

# --- @conflicts block: `kind lhs → rhs [over lhs → rhs] count # reason` ---
#
# The lexer wrapper splits each entry line: the kind word, the rule text
# (verbatim, in whatever symbol syntax the conflict report prints), `over`
# and a second rule text, the count, and the rationale comment.

conflict_lines = CONT conflict_line                 → (2)
               | conflict_lines CONT conflict_line  → (...1 3)

conflict_line = kind:IDENT rule:RULE_TEXT [KW_OVER over:RULE_TEXT] count:INTEGER reason:COMMENT?
                                                    → (conflict)

# --- @as TOKEN [via fn] = [group[!] [via fn], ...] ---

as_body  = token:(IDENT | TOKEN) [KW_VIA via:IDENT] "=" "[" groups:as_list "]"
                                                    → (as)

as_list  = as_entry                                 → (1)
         | as_list "," as_entry                     → (...1 3)

as_entry = group:IDENT [KW_VIA via:IDENT]           → (as_entry)
         | group:IDENT "!" [KW_VIA via:IDENT]       → (as_entry perm:perm)

# --- @op = [ "lit" → "token", ... ] (line breaks inside brackets are blanks) ---

op_items = op_item                                  → (1)
         | op_items op_item                         → (...1 2)
         | op_items ","                             → 1

op_item  = lit:STRING ARROW token:STRING            → (op_map)

# --- @errors / @display: `key: "name"` pairs, inline or on indented lines ---

name_pairs = pair_line                              → 1
           | CONT pair_line                         → 2
           | name_pairs CONT pair_line              → (...1 ...3)

pair_line  = name_pair                              → (1)
           | pair_line "," name_pair                → (...1 3)
           | pair_line ","                          → 1

name_pair  = key:LABEL name:STRING                  → (name_pair)
           | key:STRING ":" name:STRING             → (name_pair)

# --- @infix base, then one indented line per precedence level ---

infix_rows = CONT infix_row                         → (2)
           | infix_rows CONT infix_row              → (...1 3)

infix_row  = ops:infix_ops                          → (level)

infix_ops  = infix_op                               → (1)
           | infix_ops "," infix_op                 → (...1 3)

infix_op   = op:STRING assoc:(KW_LEFT | KW_RIGHT | KW_NONE | IDENT)
                                                    → (infix_op)

# --- @schema: one indented line per kind (or comma-separated kinds) ---

schema_lines = CONT kind_decl                       → (2)
             | schema_lines CONT kind_decl          → (...1 3)

kind_decl  = kind_names role_list                   → (kind_decl kinds:(kinds ...1) roles:(roles ...2))
           | kind_names role_list "|" side_names    → (kind_decl kinds:(kinds ...1) roles:(roles ...2)
                                                                 sides:(sides ...4))
           | kind_names role_list "@" KW_WRAPPER    → (kind_decl kinds:(kinds ...1) roles:(roles ...2)
                                                                 wrapper:wrapper)
           | kind_names role_list "|" side_names "@" KW_WRAPPER
                                                    → (kind_decl kinds:(kinds ...1) roles:(roles ...2)
                                                                 sides:(sides ...4) wrapper:wrapper)

kind_names = kind_name                              → (1)
           | kind_names "," kind_name               → (...1 3)

kind_name  = IDENT
           | STRING

role_list  =                                        → ()
           | role_list role                         → (...1 2)

role       = name:IDENT                             → (role)
           | name:IDENT "?"                         → (role opt:opt)
           | name:LABEL type:role_type              → (role)
           | name:LABEL type:role_type "?"          → (role opt:opt)
           | "..." name:IDENT                       → (role rest:rest)
           | "..." name:LABEL type:role_type        → (role rest:rest)

role_type  = type_atoms                             → (type ...1)

type_atoms = type_atom                              → (1)
           | type_atoms UNION type_atom             → (...1 3)

type_atom  = IDENT
           | STRING
           | tag:IDENT "(" values:tag_values ")"    → (tagset)

tag_values = tag_value                              → (1)
           | tag_values UNION tag_value             → (...1 3)

tag_value  = IDENT
           | STRING

side_names = IDENT                                  → (1)
           | side_names IDENT                       → (...1 2)

# --- @tags / @trivia: names on the directive line and indented lines ---

name_list  = name_items                             → 1
           | CONT name_items                        → 2
           | name_list CONT name_items              → (...1 ...3)

name_items = name_item                              → (1)
           | name_items name_item                   → (...1 2)

name_item  = IDENT
           | TOKEN
           | STRING

# --- @repair: `holes TOKEN ...` / `structure TOKEN ...` lines ---

repair_lines = CONT repair_line                     → (2)
             | repair_lines CONT repair_line        → (...1 3)

repair_line  = class:IDENT names:name_items         → (repair_line)

# ===========================================================================
# Productions
#
#   rule_name "=" alternative
#     | alternative                 (a line starting with `|`: next_alt)
#
# An indented line that does not start with `|` continues the current
# alternative (its pattern or its action).
# ===========================================================================

production = name:rule_name "=" alts:alts           → (rule)

rule_name  = id:(IDENT | TOKEN) "!"                 → (start)
           | id:(IDENT | TOKEN)                     → (name)

alts       = alt_line                               → (1)
           | alts "|" alt_line                      → (...1 3)
           | alts NEXT_ALT alt_line                 → (...1 3)

alt_line   = elements:elements hint:("<" | ">")? [ARROW action:action]
                                                    → (alt)
           | elements:elements hint:("<" | ">")? ARROW action:action "~" optout:STRING
                                                    → (alt)

elements   =                                        → ()
           | elements element                       → (...1 2)
           | elements CONT                          → 1

element    = name:LABEL element:labelable           → (label)
           | element:group_paren ":" name:IDENT     → (label)
           | labelable
           | "!" element:primary quant:quantifier   → (skip_q)
           | "!" element:primary                    → (skip)
           | KW_X char:STRING                       → (exclude)

labelable  = element:primary quant:quantifier       → (quantified)
           | primary

primary    = name:IDENT                             → (ref)
           | name:TOKEN                             → (tok)
           | name:STRING                            → (lit)
           | keyword:KW_LIST "(" inner:list_inner ")"
                                                    → (list_req)
           | "@" name:(IDENT | KW_INFIX)            → (at_ref)
           | group_paren
           | "[" bracket_body "]"                   → 2

group_paren = "(" alt_group ")"                     → (group _ ...2)

bracket_body = alt_group "..."                      → (group many ...1)
             | alt_group "," "..."                  → (group many ...1)
             | alt_group                            → (group opt ...1)

list_inner = item:list_item                         → (plain)
           | item:list_item "?"                     → (opt_items_nosep)
           | item:list_item "," sep:sep_term        → (sep_items)
           | item:list_item "?" "," sep:sep_term    → (opt_items)

list_item  = IDENT
           | TOKEN

sep_term   = STRING
           | TOKEN

alt_group  = alt_elem                               → (1)
           | alt_group "|" alt_elem                 → (...1 3)

alt_elem   = element                                → (1)
           | alt_elem element                       → (...1 2)

quantifier = "?"                                    → (opt)
           | "*"                                    → (zero_plus)
           | "+"                                    → (one_plus)

# ===========================================================================
# Actions
# ===========================================================================

action     = n:INTEGER                              → (pos)
           | KW_NIL                                 → (null)
           | sexp

sexp       = "(" head:WORD items:items ")"          → (node)
           | "(" "!" n:INTEGER items:items ")"      → (keep)
           | "(" items_nohead ")"                   → (list ...2)

items_nohead =                                      → ()
             | first_item items                     → (1 ...2)

items      =                                        → ()
           | items item                             → (...1 2)

first_item = role:LABEL value:value                 → (named)
           | plain_value

item       = role:LABEL value:value                 → (named)
           | value

value      = plain_value
           | word:WORD                              → (tag)

plain_value = n:INTEGER                             → (pos)
            | "..." n:INTEGER                       → (spread)
            | "~" n:INTEGER                         → (symid)
            | KW_NIL                                → (null)
            | sexp
