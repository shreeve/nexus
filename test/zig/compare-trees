#!/bin/bash
# Compares the tree the parser generated from test/zig/zig.grammar builds
# with the tree std.zig.Ast.parse builds (the Zig that runs this script,
# which must be 0.17.0), input by input, node for node: both are printed
# in one canonical form (the grammar's @schema, with spans) and compared
# as text. trees.zig lists the rules that map one onto the other.
#
# Usage:
#   test/zig/compare-trees [options] (DIR|FILE|--list LIST|--inline FILE)...
#
#   DIR             every *.zig file under DIR
#   --list LIST     the paths in LIST, one per line (paths may hold spaces)
#   --inline FILE   the sources given as string literals to testCanonical,
#                   testTransform, testError and checkAgainstOracle in FILE
#                   (lib/std/zig/parser_test.zig, parser_fuzz.zig)
#   --dump DIR      write both canonical forms of each differing input to
#                   DIR (N.nexus, N.std)
#   --fuzz N        compare on N inputs made by token edits of the given
#                   ones (--seed S, default 0), as compare-accept does
#   --show          print the canonical form of each input whose trees agree
#   -O MODE         optimize mode of the tool (default ReleaseSafe)
#
# The tool is built in .zig-cache/nexus-test/zig-trees/ from this
# checkout's bin/nexus (run `zig build` first). Inputs that either parser
# rejects are not compared (compare-accept compares those). It prints one
# line per input whose trees differ, with the first differing line of
# each side, and a summary; it exits 1 when any input differs.

set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../.." && pwd)
OUT="$ROOT/.zig-cache/nexus-test/zig-trees"
MODE=ReleaseSafe TOOL_ARGS=()
LIST="$OUT/list.txt"
mkdir -p "$OUT"
: >"$LIST.new"
while [[ $# -gt 0 ]]; do
    case $1 in
        --list) cat "$2" >>"$LIST.new"; shift ;;
        --inline) TOOL_ARGS+=(--inline "$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"); shift ;;
        --dump) mkdir -p "$2"; TOOL_ARGS+=(--dump "$(cd "$2" && pwd)"); shift ;;
        --show) TOOL_ARGS+=(--show) ;;
        --fuzz) TOOL_ARGS+=(--fuzz "$2"); shift ;;
        --seed) TOOL_ARGS+=(--seed "$2"); shift ;;
        -O) MODE=$2; shift ;;
        -h|--help) awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
        -*) echo "unknown option $1" >&2; exit 2 ;;
        *)
            if [[ -d $1 ]]; then
                find "$(cd "$1" && pwd)" -name '*.zig' -type f | LC_ALL=C sort >>"$LIST.new"
            elif [[ -f $1 ]]; then
                echo "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")" >>"$LIST.new"
            else
                echo "no such file or directory: $1" >&2; exit 2
            fi ;;
    esac
    shift
done
mv "$LIST.new" "$LIST"
[[ -s $LIST || ${#TOOL_ARGS[@]} -gt 0 ]] || { echo "no input files" >&2; exit 2; }

# Build: generate the parser, compile the tool next to it.
NEXUS="$ROOT/bin/nexus"
[[ -x $NEXUS ]] || { echo "$NEXUS not found: run zig build" >&2; exit 2; }
(cd "$HERE" && "$NEXUS" zig.grammar "$OUT/parser.zig") >"$OUT/gen.log" 2>&1 || { cat "$OUT/gen.log" >&2; exit 2; }
cp "$HERE/zig.zig" "$HERE/trees.zig" "$HERE/tools/compare_trees.zig" "$HERE/tools/inputs.zig" "$OUT/"
(cd "$OUT" && zig build-exe -O "$MODE" compare_trees.zig -femit-bin=compare_trees --cache-dir "$ROOT/.zig-cache/nexus-test/zig") \
    >"$OUT/compile.log" 2>&1 || { cat "$OUT/compile.log" >&2; exit 2; }

exec "$OUT/compare_trees" ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"} --list "$LIST"
