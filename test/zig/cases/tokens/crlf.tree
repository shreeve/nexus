(tokens
  (doc_comment `/// doc comment`)
  (container_doc_comment `//! container doc comment`)
  (keyword_const `const`)
  (identifier `s`)
  (equal `=`)
  (multiline_string_literal_line `\\\\multiline`)
  (multiline_string_literal_line `\\\\line`)
  (semicolon `;`)
  (keyword_pub `pub`)
  (keyword_fn `fn`)
  (identifier `main`)
  (l_paren `(`)
  (r_paren `)`)
  (identifier `void`)
  (l_brace `{`)
  (r_brace `}`)
  (identifier `x`)
  (identifier `y`)
  (identifier `z`)
  (invalid `// a stray CR then CRLF\r\r`))
