# The features the client asks for: the server advertises those it has
# of them (hover, definition and type definition, completion), logs a
# name that is no feature's (`folds`), and answers a request of another
# feature as one it does not advertise.
initialize root main.tally features hover,definition,completion,folds
open main.tally
hover main.tally 4:5
tokens main.tally
format main.tally
