# tally.grammar: Tally, the language of the editor suite. `nexus --editor`
# writes its VS Code extension and language server, which the suite builds
# three times: in full/, with full/hooks.zig (every function of the
# language written, in place of the names @lsp declares); in names/, with
# the hooks.zig `--editor` writes, so the names come from @lsp alone; and
# in stub/, with that hooks.zig and the grammar without @lsp (stub/without),
# so the grammar gives only what its syntax does. Each directory's sessions
# are replayed against its server, on the files of project/ (test/lib/lsp).

@lexer

tokens
    ident, number, string, comment, newline
    kw_fn, kw_let, kw_use, kw_return
    assign, plus, minus, star, lparen, rparen, lbrace, rbrace, comma, dot
    eof, err

'#' [^\n]*                  → comment
'"' [^"\n]* '"'             → string
'\n'                        → newline
"fn"                        → kw_fn
"let"                       → kw_let
"use"                       → kw_use
"return"                    → kw_return
'='                         → assign
'+'                         → plus
'-'                         → minus
'*'                         → star
'('                         → lparen
')'                         → rparen
'{'                         → lbrace
'}'                         → rbrace
','                         → comma
'.'                         → dot
[0-9]+                      → number
[a-z_] [a-z_0-9]*           → ident
.                           → err

@parser

@schema
    module          ...stmts
    use             name:leaf
    let             name:leaf value
    fn              name:leaf params:params body:block
    params          ...names:leaf
    return          value
    block           ...stmts
    name            id:leaf
    num, str        value:leaf
    member          object name:leaf
    call            callee ...args
    "+", "-", "*"   left right

# A file's names: its functions, `let`s and `use`s, in any order; a
# function's parameters, then a block's `let`s, each from its definition
# on. `use lib` imports lib.tally, beside the file; a name after `.` is a
# member of what is before it: a `use`'s file, or what a `let`'s value is.
# A function's name and its parameters are coloured as such, and so is
# each name of them, in any file.
@lsp
    scope       module unordered
    scope       fn block
    define      fn.name         function  outer  doc:leading  detail:..body
    define      params.names    variable
    define      let.name        variable  value:value  doc:leading
    define      use.name        module
    use         IDENT
    import      use.name        file "{}.tally"
    member      member.name     of:object
    builtin     "print"
    doc         COMMENT strip "#"
    undefined   warning
    color       fn.name         function  declaration
    color       params.names    variable.parameter  declaration

@display
    IDENT: "a name", NEWLINE: "end of line"

@errors
    expr: "an expression"

@messages
    after  IDENT "(" expr IDENT         → "expected ',' between arguments, got {got}"

@trivia COMMENT

@repair
    holes       IDENT
    terminator  NEWLINE

@highlight
    language            "Tally"
    scope-name          source.tally
    extensions          tally
    line-comment        "#"
    indent              '{' [ \t]* line-end
    dedent              line-start [ \t]* '}'

    keyword             "fn" [ \t]+ function:([a-z_] [a-z_0-9]*)
    keyword             "fn" "let" "use"
    keyword.control     "return"
    operator            "=" "+" "-" "*"
    punctuation         "(" ")" "{" "}" "," "."
    constant.numeric    NUMBER
    string              STRING
    comment             COMMENT
    invalid             ERR

program! = body                                 → (module ...1)

body     = line                                 → (1)
         | body NEWLINE line                    → (...1 3)

line     = stmt
         |                                      → _

stmt     = KW_USE IDENT                         → (use 2)
         | KW_LET IDENT "=" expr                → (let 2 4)
         | KW_FN IDENT "(" [L(IDENT)] ")" block → (fn 2 (params ...4) 6)
         | KW_RETURN expr                       → (return 2)
         | expr

block    = "{" body "}"                         → (block ...2)

expr     = @infix

atom     = IDENT                                → (name 1)
         | NUMBER                               → (num 1)
         | STRING                               → (str 1)
         | atom "." IDENT                       → (member 1 3)
         | atom "(" [L(expr)] ")"               → (call 1 ...3)
         | "(" expr ")"                         → 2

@infix atom
    "+" left, "-" left
    "*" left
