package nexus-local.nexus-tally "Tally (Nexus)" 0.1.0; contributes languages, grammars, configuration, semanticTokenTypes, semanticTokenScopes
activate
createOutputChannel Tally (Nexus)
client 1: new nexus-tally Tally (Nexus)
  server {"run":{"command":"<ext>/bin/tally-lsp","args":[]},"debug":{"command":"<ext>/bin/tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":""},"outputChannel":"<channel Tally (Nexus)>"}
client 1: start
client 1: running
activated
# a workspace's server.path is never the server, trusted or not
workspace setting nexus-tally.server.path = "/workspace/says/run-me-too"
client 1: stop
client 2: new nexus-tally Tally (Nexus)
  server {"run":{"command":"<ext>/bin/tally-lsp","args":[]},"debug":{"command":"<ext>/bin/tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":""},"outputChannel":"<channel Tally (Nexus)>"}
client 2: start
client 2: running
workspace setting nexus-tally.server.path = "/untrusted/run-me"
client 2: stop
client 3: new nexus-tally Tally (Nexus)
  server {"run":{"command":"<ext>/bin/tally-lsp","args":[]},"debug":{"command":"<ext>/bin/tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":""},"outputChannel":"<channel Tally (Nexus)>"}
client 3: start
client 3: running
# the user's own setting is the server
user setting nexus-tally.server.path = "/opt/tally/bin/tally-lsp"
client 3: stop
client 4: new nexus-tally Tally (Nexus)
  server {"run":{"command":"/opt/tally/bin/tally-lsp","args":[]},"debug":{"command":"/opt/tally/bin/tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":""},"outputChannel":"<channel Tally (Nexus)>"}
client 4: start
client 4: running
user setting nexus-tally.server.path = ""
client 4: stop
client 5: new nexus-tally Tally (Nexus)
  server {"run":{"command":"<ext>/bin/tally-lsp","args":[]},"debug":{"command":"<ext>/bin/tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":""},"outputChannel":"<channel Tally (Nexus)>"}
client 5: start
client 5: running
deactivate
client 5: stop
dispose channel Tally (Nexus)
