  server {"run":{"command":"tally-lsp","args":[]},"debug":{"command":"tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":"","modules":{},"check":[],"checkTimeout":5000,"features":["semanticTokens","folding","check"]},"outputChannel":"<channel Tally (Nexus)>"}
