  server {"run":{"command":"tally-lsp","args":[]},"debug":{"command":"tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":"","modules":{},"check":["zig","build-obj","-fno-emit-bin","${file}"],"checkTimeout":5000,"features":["semanticTokens","folding","check"]},"outputChannel":"<channel Tally (Nexus)>"}
client 4: start
client 4: running
