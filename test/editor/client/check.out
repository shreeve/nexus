  server {"run":{"command":"tally-lsp","args":[]},"debug":{"command":"tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":"","modules":{},"check":["zig","build-obj","-fno-emit-bin","${file}"],"checkTimeout":5000,"features":["diagnostics","semanticTokens","folding","selection","symbols","hover","definition","references","rename","completion","signature","formatting","check"]},"outputChannel":"<channel Tally (Nexus)>"}
client 3: start
client 3: running
user setting nexus-tally.features = ["semanticTokens","folding","check"]
client 3: stop
