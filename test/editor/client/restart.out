package nexus-local.nexus-tally "Tally (Nexus)" 0.1.0; contributes languages, grammars, configuration, semanticTokenTypes, semanticTokenScopes
activate
createOutputChannel Tally (Nexus)
client 1: new nexus-tally Tally (Nexus)
  server {"run":{"command":"tally-lsp","args":[]},"debug":{"command":"tally-lsp","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":"","modules":{},"check":[],"checkTimeout":60000,"features":["diagnostics","semanticTokens","folding","selection","symbols","hover","definition","references","rename","completion","signature","formatting","check"]},"outputChannel":"<channel Tally (Nexus)>"}
client 1: start
client 1: running
activated
setting editor.fontSize changed
# two changes together: one restart
user setting nexus-tally.server.path = "/opt/one"
user setting nexus-tally.server.root = "/b.tally"
client 1: stop
client 2: new nexus-tally Tally (Nexus)
  server {"run":{"command":"/opt/one","args":[]},"debug":{"command":"/opt/one","args":[]}}
  options {"documentSelector":[{"scheme":"file","language":"tally"},{"scheme":"untitled","language":"tally"}],"initializationOptions":{"root":"/b.tally","modules":{},"check":[],"checkTimeout":60000,"features":["diagnostics","semanticTokens","folding","selection","symbols","hover","definition","references","rename","completion","signature","formatting","check"]},"outputChannel":"<channel Tally (Nexus)>"}
client 2: start
client 2: running
# a change while a client starts: the next restart waits for it
user setting nexus-tally.server.path = "/opt/two"
client 2: stop
