# generated-has: pub const Parser
#
# A grammar without @lang generates a parser that compiles and runs, and
# exports the same `Parser` name as every other grammar.
#
# Today: the generated parser reads `self.lexer.base.aux`, which only
# exists on a lang Lexer wrapper: "no field named 'base'" (basic, features
# and lit_tags have the same failure). Without @lang there is also no
# `Parser` alias, only `BaseParser`.
# (architecture.md Appendix A; SPEC §8.2)

@lexer
tokens
    ident
    integer
    eq
    newline
    eof
    err
'='                                         → eq
'\n'                                        → newline
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser

program! = body                             → (module ...1)
body     = stmt                             → (1)
         | body NEWLINE stmt                → (...1 3)
         | body NEWLINE                     → 1
stmt     = IDENT "=" INTEGER                → (set 1 3)
