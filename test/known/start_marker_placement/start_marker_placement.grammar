# A start symbol that is also used recursively parses the same language at
# every level.
#
# Today: the start marker is prepended to the first rule of `nest` (here the
# first [opt] expansion), so a nested `nest` cannot use that rule: `()`
# parses, `(())` fails with a ParseError.
# (architecture.md §1.6.4 and §6 item 3; SPEC §8.5)

@lexer
tokens
    lparen
    rparen
    eof
    err
'('                                         → lparen
')'                                         → rparen
.                                           → err

@parser
@lang = "start_marker_placement"

nest! = "(" [nest] ")"                      → (n 2)
