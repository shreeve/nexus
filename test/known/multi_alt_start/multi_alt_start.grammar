# A start symbol with several alternatives parses every alternative.
#
# Today: the start marker is prepended only to the first rule of `top`, so
# only `IDENT` is reachable; `42` fails with a ParseError.
# (architecture.md Appendix A: multi.grammar; SPEC §8.1)

@lexer
tokens
    ident
    integer
    eof
    err
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@lang = "multi_alt_start"

top! = IDENT                                → (id 1)
     | INTEGER                              → (num 1)
