; examples/quoted-list.nx — quoted compound collections.
;
; A quoted list is data: every element is quoted too (symbols and
; keywords interned), and the compiler folds the whole list into one
; constant of the routine (`bin/nexis disasm` shows it as
; `load-const (point x y)`).
;
; Syntax-quote `\`(a ~b)` and splicing `~@xs` build their lists at
; run time instead (see syntax-quote.nx).

(defn point [x y] (quote (point x y)))

; Result: the data list (point x y) — NOT a call. quote
; preserves the structural form as a runtime list value.
(println (point 3 4))
