# A choice position whose chosen alternative has several elements cannot be used as a value.
# error: choice_multi_position.grammar:30:13:
# error: position 1 is a choice whose chosen alternative has several elements
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
[ \t]+                                      → skip
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
program! = (IDENT "+" | INTEGER)            → (p 1)
