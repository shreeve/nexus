# A token no rule makes has no text to match.
# error: no lexer rule matches the text of INDENT
@lexer
tokens
    word, string, number, arrow, indent, eof, err
'"' ([^"\\\n] | '\\' .)* '"' → string
[0-9]+ → number
"->" [a-z] → arrow, rewind(2)
[a-z]+ → word
'\n' → skip, skip
. → err
@parser
@keywords
    cmd  caseless  S[ET]
@as WORD = [cmd!]
@highlight
    language "T"
    scope-name source.t
    extensions t
    keyword INDENT

list! = item*
item = WORD | STRING | NUMBER | ARROW | SET
