# An @infix operator is a node kind in schema mode; it must be declared.
# error: schema_infix_undeclared.grammar:45:8:
# error: rule '@infix': undeclared kind '+'
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
[ \t]+                                      → skip
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@schema
    module   ...stmts
    set      target:name value
    name     id:leaf
    num      value:leaf

program! = stmts                            → (module ...1)
stmts    = stmt                             → (1)
         | stmts NEWLINE stmt               → (...1 3)
name     = IDENT                            → (name 1)
expr     = @infix
atom     = name                             → 1
         | INTEGER                          → (num 1)
stmt     = name "=" expr                  → (set 1 3)

@infix atom
    "+" left
