# A @messages line starts with `at` or `after`.
# error: messages_bad_kind.grammar:20:5:
# error: a @messages line starts with `at` or `after`, not 'before'
@lexer

tokens
    ident, number, kw_if, eq, semi, eof, err

'\n'                        → skip, skip
'='                         → eq
';'                         → semi
"if"                        → kw_if
[a-z]+                      → ident
[0-9]+                      → number
.                           → err

@parser

@messages
    before IDENT "=" SEMI           → "a value goes after '='"

prog! = stmt+                          → (prog ...1)
stmt  = IDENT "=" expr ";"             → (set 1 3)
      | KW_IF expr ";"                 → (if 2)
expr! = IDENT | NUMBER
