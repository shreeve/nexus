# An example the parser rejects before its last token keys on nothing.
# error: messages_fails_early.grammar:20:14:
# error: the parser fails here, before the example's last token
@lexer

tokens
    ident, number, kw_if, eq, semi, eof, err

'\n'                        → skip, skip
'='                         → eq
';'                         → semi
"if"                        → kw_if
[a-z]+                      → ident
[0-9]+                      → number
.                           → err

@parser

@messages
    at IDENT IDENT "=" SEMI         → "x"

prog! = stmt+                          → (prog ...1)
stmt  = IDENT "=" expr ";"             → (set 1 3)
      | KW_IF expr ";"                 → (if 2)
expr! = IDENT | NUMBER
