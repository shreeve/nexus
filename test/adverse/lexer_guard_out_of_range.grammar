# `pre` is a byte count (0..255): a guard value outside that range is
# rejected where it is written.
# error: lexer_guard_out_of_range.grammar:8:17:
# error: value 300 for 'pre' is out of range (0..255)
@lexer
tokens
    t, u, eof, err
'a'     @ pre > 300             → t
'a'                             → u
.                               → err

@parser
top! = ERR → 1
