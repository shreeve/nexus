# A directive-level `via` names the lookup of one group.
# error: as_shared_via.grammar:30:15:
# error: names the lookup of a single group
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
# (spaces and tabs are consumed by the lexer as leading whitespace)
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@as IDENT via kwAs = [kw, other]

program! = IDENT                            → (p 1)
