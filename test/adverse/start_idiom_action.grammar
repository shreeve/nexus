# `x! = x` only declares a start symbol; it cannot carry a node action.
# error: start_idiom_action.grammar:31:9:
# error: `x! = x` only declares x a start symbol
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
[ \t]+                                      → skip
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
top! = IDENT                                → (t 1)
expr! = expr                                → (wrap 1)
expr = INTEGER
