# The parser grammar writes the token lparen both as "(" and as LPAREN.
# Tokens are bound to terminals before the LR stage, so that error is
# reported, not a misleading "has no effect" on the `X "("` hint (to LR,
# "(" and LPAREN would be two terminals with no conflict between them).
# error: x_hint_literal_and_name.grammar:22:10:
# error: "(" and LPAREN are the same token (lparen)
@lexer
tokens
    ident
    lparen
    rparen
    eof
    err
'\n'                                        → skip, skip
'('                                         → lparen
')'                                         → rparen
[a-z]+                                      → ident
.                                           → err
@parser
exprs! = expr+                              → (exprs ...1)
expr   = IDENT X "("                        → (var 1)
       | IDENT "(" expr RPAREN              → (call 1 3)
       | LPAREN expr RPAREN                 → 2
