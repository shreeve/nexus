# A label fills a role, so the action must build a schema node.
# error: schema_label_no_node.grammar:44:16:
# error: label 'value' fills a role, but the action builds no schema node
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
# (spaces and tabs are consumed by the lexer as leading whitespace)
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@schema
    module   ...stmts
    set      target:name value
    name     id:leaf
    num      value:leaf
    call     callee:leaf ...args

program! = stmts                            → (module ...1)
stmts    = stmt                             → (1)
         | stmts NEWLINE stmt               → (...1 3)
name     = IDENT                            → (name 1)
expr     = name                             → 1
         | INTEGER                          → (num 1)
         | IDENT "(" expr ")"               → (call 1 3)
stmt     = "(" value:expr ")"             → 2
