# Regions do not nest.
# error: STRING is a region (an entry is `within` it), and regions do not nest
@lexer
tokens
    word, string, number, arrow, indent, eof, err
'"' ([^"\\\n] | '\\' .)* '"' → string
[0-9]+ → number
"->" [a-z] → arrow, rewind(2)
[a-z]+ → word
'\n' → skip, skip
. → err
@parser
@keywords
    cmd  caseless  S[ET]
@as WORD = [cmd!]
@highlight
    language "T"
    scope-name source.t
    extensions t
    string STRING within STRING

list! = item*
item = WORD | STRING | NUMBER | ARROW | SET
