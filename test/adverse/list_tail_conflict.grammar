# A list followed by an optional item of its own kind is ambiguous: the
# conflict is reported like any other (it must be declared in @conflicts),
# never resolved silently inside the list's expansion.
# error: list_tail_conflict.grammar:21:1:
# error: undeclared conflict: reduce IDENT* → IDENT* IDENT over IDENT? → IDENT
@lexer
tokens
    ident
    comma
    star
    eof
    err
','                                         → comma
'*'                                         → star
[a-z]+                                      → ident
.                                           → err

@parser
@lang = "list_tail_conflict"

top! = IDENT* IDENT?                        → (top ...1 2)
