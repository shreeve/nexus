# A guard is the text of the token the parser cannot take, the last one.
# error: messages_guard_not_last.grammar:20:14:
# error: only the last element of an example takes a guard
@lexer

tokens
    ident, number, kw_if, eq, semi, eof, err

'\n'                        → skip, skip
'='                         → eq
';'                         → semi
"if"                        → kw_if
[a-z]+                      → ident
[0-9]+                      → number
.                           → err

@parser

@messages
    at IDENT("x") "=" SEMI          → "x"

prog! = stmt+                          → (prog ...1)
stmt  = IDENT "=" expr ";"             → (set 1 3)
      | KW_IF expr ";"                 → (if 2)
expr! = IDENT | NUMBER
