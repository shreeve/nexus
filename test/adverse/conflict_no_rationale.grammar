# Every @conflicts entry needs a rationale comment.
# error: conflict_no_rationale.grammar:31:5:
# error: conflict entry needs a `# rationale` comment
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
[ \t]+                                      → skip
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@conflicts
    shift  program → IDENT   1

program! = IDENT                            → (p 1)
