# A choice between fixed texts carries a value: which one matched. Left
# unused, `x + y` and `x : y` would build the same node.
# error: schema_coverage_choice.grammar:26:8:
# error: element 2 (("+" | ":")) carries a value the action does not use
@lexer
tokens
    ident
    integer
    plus
    colon
    comma
    eq
    eof
    err
'+'                                         → plus
':'                                         → colon
','                                         → comma
'='                                         → eq
[0-9]+                                      → integer
[a-z]+                                      → ident
.                                           → err

@parser
@schema
    t l:leaf r:leaf
top! = IDENT ("+" | ":") IDENT             → (t 1 3)
