# An action builds a kind @schema does not declare; the inventory is printed.
# error: schema_undeclared_kind.grammar:46:12:
# error: undeclared kind 'assign'
# error: ready to paste
# error:     assign target value
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
[ \t]+                                      → skip
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@schema
    module   ...stmts
    set      target:name value
    name     id:leaf
    num      value:leaf
    call     callee:leaf ...args

program! = stmts                            → (module ...1)
stmts    = stmt                             → (1)
         | stmts NEWLINE stmt               → (...1 3)
name     = IDENT                            → (name 1)
expr     = name                             → 1
         | INTEGER                          → (num 1)
         | IDENT "(" expr ")"               → (call 1 3)
stmt     = name "=" expr                  → (assign target:1 value:3)
         | name "+" expr                  → (set 1 3)
