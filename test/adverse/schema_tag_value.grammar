# A tag(...) role takes only its listed values.
# error: schema_tag_value.grammar:44:12:
# error: role 'op' takes one of plus|minus, not 'times'
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
[ \t]+                                      → skip
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@schema
    module   ...stmts
    set      op:tag(plus|minus)? target:name value
    name     id:leaf
    num      value:leaf
    call     callee:leaf ...args

program! = stmts                            → (module ...1)
stmts    = stmt                             → (1)
         | stmts NEWLINE stmt               → (...1 3)
name     = IDENT                            → (name 1)
expr     = name                             → 1
         | INTEGER                          → (num 1)
         | IDENT "(" expr ")"               → (call 1 3)
stmt     = name "+" expr                  → (set times 1 3)
