# outer steps out of a scope: the kind must be one, or be held by one.
# error: lsp_outer_no_scope.grammar:42:32:
# error: outer: 'let' is no scope kind and no role of a scope kind holds it, so it has no scope to step out of
@lexer

tokens
    ident, number, comment, newline, kw_let, kw_fn, eq, plus, minus
    lbrace, rbrace, lparen, rparen, comma, eof, err

'#' [^\n]*                  → comment
'\n'                        → newline
"let"                       → kw_let
"fn"                        → kw_fn
'='                         → eq
'+'                         → plus
'-'                         → minus
'{'                         → lbrace
'}'                         → rbrace
'('                         → lparen
')'                         → rparen
','                         → comma
[0-9]+                      → number
[a-z]+                      → ident
.                           → err

@parser

@schema
    prog        ...stmts
    let         name:leaf value | eq
    fn          name:leaf params:group? body:block
    block       ...stmts
    name        id:leaf
    num         value:leaf base:tag(dec)
    neg         sign:tag(minus) value
    call        name:leaf ...args

@trivia COMMENT

@lsp
    scope    num
    define   let.name variable outer
    use      IDENT

prog!  = body                               → (prog ...1)

body   = stmt                               → (1)
       | body NEWLINE stmt                  → (...1 3)

stmt   = KW_LET IDENT eq:"=" expr           → (let 2 4)
       | KW_FN IDENT "(" [L(IDENT)] ")" block
                                            → (fn 2 4 6)
       | expr

block  = "{" body "}"                       → (block ...2)

expr   = IDENT                              → (name 1)
       | NUMBER                             → (num 1 dec)
       | "-" expr                           → (neg minus 2)
       | IDENT "(" [L(expr)] ")"            → (call 1 ...3)
