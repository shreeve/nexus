# A message may use {got} and {expected}; any other placeholder is an error.
# error: messages_unknown_placeholder.grammar:20:64:
# error: unknown placeholder `{token}` (a message may use {got} and {expected})
@lexer

tokens
    ident, number, kw_if, eq, semi, eof, err

'\n'                        → skip, skip
'='                         → eq
';'                         → semi
"if"                        → kw_if
[a-z]+                      → ident
[0-9]+                      → number
.                           → err

@parser

@messages
    at IDENT "=" SEMI               → "expected a value, got {token}"

prog! = stmt+                          → (prog ...1)
stmt  = IDENT "=" expr ";"             → (set 1 3)
      | KW_IF expr ";"                 → (if 2)
expr! = IDENT | NUMBER
