# Two messages for one parser state and token: the parser cannot choose.
# error: messages_same_key.grammar:21:5:
# error: this message and the one at 20:5 are for the same parser state and token; the parser cannot tell them apart
@lexer

tokens
    ident, number, kw_if, eq, semi, eof, err

'\n'                        → skip, skip
'='                         → eq
';'                         → semi
"if"                        → kw_if
[a-z]+                      → ident
[0-9]+                      → number
.                           → err

@parser

@messages
    at IDENT "=" SEMI               → "a value goes after '='"
    at IDENT "=" ";"                → "expected a value"

prog! = stmt+                          → (prog ...1)
stmt  = IDENT "=" expr ";"             → (set 1 3)
      | KW_IF expr ";"                 → (if 2)
expr! = IDENT | NUMBER
