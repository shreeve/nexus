# A rest role must be the last role.
# error: schema_rest_not_last.grammar:35:17:
# error: rest role `...args` must be the last role
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
[ \t]+                                      → skip
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@schema
    module   ...stmts
    set      target:name value
    name     id:leaf
    num      value:leaf
    call     ...args callee:leaf

program! = stmts                            → (module ...1)
stmts    = stmt                             → (1)
         | stmts NEWLINE stmt               → (...1 3)
name     = IDENT                            → (name 1)
expr     = name                             → 1
         | INTEGER                          → (num 1)
         | IDENT "(" expr ")"               → (call 1 3)
stmt     = name "=" expr                  → (set 1 3)
