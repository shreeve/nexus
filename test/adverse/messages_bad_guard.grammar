# A guard's text must be one the lexer gives the token: `if` is KW_IF, never IDENT.
# error: messages_bad_guard.grammar:20:30:
# error: the lexer never gives IDENT the text "if"
@lexer

tokens
    ident, number, kw_if, eq, semi, eof, err

'\n'                        → skip, skip
'='                         → eq
';'                         → semi
"if"                        → kw_if
[a-z]+                      → ident
[0-9]+                      → number
.                           → err

@parser

@messages
    at IDENT "=" IDENT IDENT("if")  → "x"

prog! = stmt+                          → (prog ...1)
stmt  = IDENT "=" expr ";"             → (set 1 3)
      | KW_IF expr ";"                 → (if 2)
expr! = IDENT | NUMBER
