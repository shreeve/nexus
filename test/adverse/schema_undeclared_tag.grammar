# A tag literal in an untyped role must be declared.
# error: schema_undeclared_tag.grammar:46:12:
# error: undeclared tag 'weird'
# error: @tags weird
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
# (spaces and tabs are consumed by the lexer as leading whitespace)
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@schema
    module   ...stmts
    set      target:name value
    name     id:leaf
    num      value:leaf
    call     callee:leaf ...args

program! = stmts                            → (module ...1)
stmts    = stmt                             → (1)
         | stmts NEWLINE stmt               → (...1 3)
name     = IDENT                            → (name 1)
expr     = name                             → 1
         | INTEGER                          → (num 1)
         | IDENT "(" expr ")"               → (call 1 3)
stmt     = name "=" expr                  → (set 1 3)
         | name "+" expr                  → (call 1 weird 3) ~ "testing tags"
