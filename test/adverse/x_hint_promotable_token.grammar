# A one-byte lexer rule that produces the token `@as` promotes: the
# parser's symbol for that token depends on the state, so an `X "%"` hint
# naming it is a located error.
# error: x_hint_promotable_token.grammar:22:10:
# error: X "%" on expr → IDENT names ident, the token @as promotes
@lexer
tokens
    ident
    lparen
    rparen
    eof
    err
'\n'                                        → skip, skip
'%'                                         → ident
'('                                         → lparen
')'                                         → rparen
[a-z]+                                      → ident
.                                           → err
@parser
@as IDENT = [kw]
exprs! = expr+                              → (exprs ...1)
expr   = IDENT X "%"                        → (var 1)
       | IDENT LPAREN expr RPAREN           → (call 1 3)
       | LPAREN expr RPAREN                 → 2
