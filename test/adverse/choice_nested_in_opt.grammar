# A choice inside a [...] group is not supported.
# error: choice_nested_in_opt.grammar:30:24:
# error: a choice inside a [...] group is not supported
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
# (spaces and tabs are consumed by the lexer as leading whitespace)
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
program! = IDENT ["+" (IDENT | INTEGER)]    → (p 1)
