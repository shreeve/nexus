# `over` belongs to reduce entries.
# error: conflict_shift_over.grammar:31:35:
# error: a `shift` entry names one rule; `over` belongs to `reduce` entries
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
# (spaces and tabs are consumed by the lexer as leading whitespace)
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@conflicts
    shift  program → IDENT over program → INTEGER   1   # nonsense

program! = IDENT                            → (p 1)
