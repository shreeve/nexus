# @tags extends the schema's Tag enum; it needs an @schema.
# error: tags_without_schema.grammar:30:7:
# error: @tags lists extra schema tags; it needs an @schema
@lexer
tokens
    ident
    integer
    newline
    eq
    colon
    lparen
    rparen
    comma
    plus
    eof
    err
# (spaces and tabs are consumed by the lexer as leading whitespace)
'\n'                                        → newline
'='                                         → eq
':'                                         → colon
'('                                         → lparen
')'                                         → rparen
','                                         → comma
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@tags flag

program! = IDENT                            → (p 1)
