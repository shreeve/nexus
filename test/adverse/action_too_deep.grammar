# Action nodes nested deeper than the limit are a located error, not a
# stack overflow (the frontend counts the parentheses).
# error: action_too_deep.grammar:24:241:
# error: nested too deeply: at most 64 levels of ( ) and [ ]
@lexer
tokens
    ident
    integer
    plus
    colon
    comma
    eq
    eof
    err
'+'                                         → plus
':'                                         → colon
','                                         → comma
'='                                         → eq
[0-9]+                                      → integer
[a-z]+                                      → ident
.                                           → err

@parser
top! = IDENT                                → (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t (t 1))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
