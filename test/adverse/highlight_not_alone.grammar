# `not` goes with `after` or `before`.
# error: `not` is followed by `after` or `before`
@lexer
tokens
    word, string, number, arrow, indent, eof, err
'"' ([^"\\\n] | '\\' .)* '"' → string
[0-9]+ → number
"->" [a-z] → arrow, rewind(2)
[a-z]+ → word
'\n' → skip, skip
. → err
@parser
@keywords
    cmd  caseless  S[ET]
@as WORD = [cmd!]
@highlight
    language "T"
    scope-name source.t
    extensions t
    keyword "set" not "x"

list! = item*
item = WORD | STRING | NUMBER | ARROW | SET
