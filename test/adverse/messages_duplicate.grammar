# The same message twice for one key is a duplicate.
# error: messages_duplicate.grammar:21:5:
# error: duplicate message: the one at 20:5 is for the same parser state and token
@lexer

tokens
    ident, number, kw_if, eq, semi, eof, err

'\n'                        → skip, skip
'='                         → eq
';'                         → semi
"if"                        → kw_if
[a-z]+                      → ident
[0-9]+                      → number
.                           → err

@parser

@messages
    at IDENT "=" SEMI               → "a value goes after '='"
    at prog!: IDENT "=" SEMI        → "a value goes after '='"

prog! = stmt+                          → (prog ...1)
stmt  = IDENT "=" expr ";"             → (set 1 3)
      | KW_IF expr ";"                 → (if 2)
expr! = IDENT | NUMBER
