#!/bin/bash
# Generate a parser from a grammar with a given Nexus binary and compile it,
# together with the grammar's @lang module files, into the tree driver
# (test/lib/driver.zig).
#
# Usage:
#   test/lib/build-grammar NEXUS GRAMMAR OUTDIR [-O mode] [LANGFILE...]
#
# OUTDIR receives parser.zig, the lang files, driver.zig, the `driver`
# binary, gen.log (generator output) and compile.log; everything else in it
# is removed first, so a lang file deleted from a suite is never compiled
# from an earlier run's copy. Exit status:
#   0 built   10 generation failed   11 compile failed   2 usage
#
# The generator runs in the grammar's directory (as `nexus g.grammar out`),
# like the golden checks do, with $NEXUS_FLAGS (if set) as extra options.
# Generation fails if the generator exits non-zero, crashes, or writes no
# parser. The compile is skipped when its inputs (every .zig file in
# OUTDIR, the mode and the compiler) are byte for byte those of the
# previous successful compile, recorded in OUTDIR/.inputs.

set -uo pipefail

[[ $# -ge 3 ]] || { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 2; }
NEXUS=$1 GRAMMAR=$2 OUT=$3
shift 3
MODE=Debug
if [[ "${1:-}" == "-O" ]]; then MODE=$2; shift 2; fi

LIB=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$LIB/../.." && pwd)
CACHE=${NEXUS_TEST_ZIG_CACHE:-$ROOT/.zig-cache/nexus-test/zig}

case $NEXUS in /*) ;; *) NEXUS="$(pwd)/$NEXUS" ;; esac
mkdir -p "$OUT" "$CACHE"
OUT=$(cd "$OUT" && pwd)
find "$OUT" -mindepth 1 -maxdepth 1 ! -name driver ! -name .inputs -exec rm -rf {} +

gdir=$(dirname "$GRAMMAR")
gname=$(basename "$GRAMMAR")
# shellcheck disable=SC2086 # NEXUS_FLAGS: extra generator options, split on spaces
(cd "$gdir" && "$NEXUS" ${NEXUS_FLAGS:-} "$gname" "$OUT/parser.zig") >"$OUT/gen.log" 2>&1
rc=$?
if [[ $rc -ne 0 || ! -s "$OUT/parser.zig" ]]; then
    echo "exit $rc" >>"$OUT/gen.log"
    rm -f "$OUT/driver" "$OUT/.inputs"
    exit 10
fi

for f in "$@"; do
    case $(basename "$f") in parser.zig|driver.zig) continue ;; esac # ours
    cp "$f" "$OUT/"
done
cp "$LIB/driver.zig" "$OUT/driver.zig"

(
    cd "$OUT" || exit 1
    echo "$MODE $(command -v zig) $(zig version)"
    for f in *.zig; do printf '\n%s %s\n' "$f" "$(wc -c <"$f")"; cat "$f"; done
) >"$OUT/.inputs.new"
if [[ -x "$OUT/driver" ]] && cmp -s "$OUT/.inputs" "$OUT/.inputs.new"; then
    rm "$OUT/.inputs.new"
    : >"$OUT/compile.log"
    exit 0
fi
rm -f "$OUT/driver" "$OUT/.inputs"
# A shared cache dir: Zig reuses what it compiled for other suites.
(cd "$OUT" && zig build-exe -O "$MODE" driver.zig -femit-bin=driver --cache-dir "$CACHE") >"$OUT/compile.log" 2>&1 || exit 11
mv "$OUT/.inputs.new" "$OUT/.inputs"
exit 0
