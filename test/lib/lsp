#!/usr/bin/env python3
"""Replay a session against a language server and print what it answers.

Usage:
  test/lib/lsp SERVER ROOT SESSION

SERVER is a language server `nexus --editor` wrote, built; ROOT the
directory of the files the session names; SESSION a file of commands, one
a line (`#` starts a comment):

  initialize [utf-8] [root FILE] [folder] [module NAME=FILE]... [quiet]
             [features A,B,...] [timeout MS] [check JSON]
                                   the first command: the client's options
                                     (`folder`: ROOT is the workspace's
                                     folder; `module`: NAME's file in the
                                     `modules` option; `features`: the
                                     `features` option, `-` for none;
                                     `timeout`: `checkTimeout`; `check`,
                                     last: the rest of the line, a JSON
                                     list, the `check` option, each word
                                     that starts with `./` or `../`
                                     relative to SESSION's directory);
                                     `quiet` prints nothing of the result
  open FILE                        didOpen with FILE's text, or with the
                                     `| ` lines after it; a FILE that starts
                                     with `untitled:` is an unsaved document
  change FILE                      didChange; the new text is the lines
  | text                             after it that start with `| `
  edit FILE L:C-L:C "text"         didChange of that range to the JSON
                                     string's text
  save FILE                        didSave
  close FILE                       didClose
  tokens FILE                      semanticTokens/full
  folds FILE                       foldingRange
  symbols FILE                     documentSymbol
  format FILE                      formatting
  hover FILE L:C                   hover (and the other requests at a
  definition FILE L:C                position: L and C count from 1, C in
  typeDefinition FILE L:C            the session's encoding)
  references FILE L:C
  highlight FILE L:C               documentHighlight
  signature FILE L:C               signatureHelp
  completion FILE L:C
  selection FILE L:C               selectionRange
  rename FILE L:C NAME
  request METHOD FILE              any method, with just the document
  wait NAME                        wait (10 s at most) for the file NAME in
                                     the directory $LSP_TMP names
  exit                             exit without shutdown: the last command

A notification followed by ` &` does not wait for what it asks for.

Each command is printed after `> `, then what came back: a request's
result or error, the diagnostics a notification published, or the status
`exit` ended the server with. Ranges print as `L:C-L:C`, URIs and the
paths in other notifications relative to ROOT, semantic tokens as
`L:C len scope [modifier ...]` (from the legend `initialize` returned),
and a list one item a line. A session
without `exit` ends with shutdown and exit; the server must then exit 0.

The server runs with LSP_TMP, a directory of its own, in its environment.
A check command that writes its process id to a file there named `pid...`
leads its process group: once the server has exited, no process of that
group may run.
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time


def main():
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    server, root, session = sys.argv[1:]
    root = os.path.abspath(root)
    s = Session(server, root, os.path.dirname(os.path.abspath(session)))
    lines = open(session).read().split("\n")
    i = 0
    try:
        while i < len(lines):
            line = lines[i].strip()
            i += 1
            if not line or line.startswith("#"):
                continue
            body = []
            while i < len(lines) and lines[i].startswith("|"):
                body.append(lines[i][2:])
                i += 1
            print("> " + line)
            if s.exited:
                raise Failure("a command after exit")
            wait = not line.endswith(" &")
            s.command(line.rstrip(" &").split(), "\n".join(body) + "\n" if body else None, wait)
        if not s.exited:
            s.finish()
        s.no_checks_left()
    except Failure as f:
        print("!! " + str(f))
        s.kill()
        sys.exit(1)
    finally:
        shutil.rmtree(s.tmp, ignore_errors=True)


class Failure(Exception):
    pass


class Session:
    def __init__(self, server, root, here):
        self.root = root
        self.here = here
        self.tmp = tempfile.mkdtemp(prefix="nexus-lsp-")
        env = dict(os.environ, LSP_TMP=self.tmp)
        self.proc = subprocess.Popen([server], stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env)
        self.next_id = 1
        self.legend = []
        self.modifiers = []
        self.versions = {}
        self.exited = False
        self.timer = threading.Timer(30, self.proc.kill)
        self.timer.start()

    def kill(self):
        self.timer.cancel()
        self.proc.kill()
        for pid in self.check_pids():
            try:
                os.killpg(pid, signal.SIGKILL)
            except OSError:
                pass

    def check_pids(self):
        pids = []
        for name in sorted(os.listdir(self.tmp)):
            if name.startswith("pid"):
                text = open(os.path.join(self.tmp, name)).read().strip()
                if text:
                    pids.append(int(text))
        return pids

    def no_checks_left(self):
        """Once the server has exited, no process of a check's group runs
        (a group being stopped gets 5 s to go)."""
        for pid in self.check_pids():
            deadline = time.time() + 5
            while True:
                try:
                    os.killpg(pid, 0)
                except ProcessLookupError:
                    break
                except PermissionError:
                    pass
                if time.time() > deadline:
                    raise Failure("the check's process group %d still runs" % pid)
                time.sleep(0.05)

    def uri(self, path):
        return path if path.startswith("untitled:") else "file://" + os.path.join(self.root, path)

    def send(self, msg):
        body = json.dumps(msg).encode()
        try:
            self.proc.stdin.write(b"Content-Length: %d\r\n\r\n" % len(body) + body)
            self.proc.stdin.flush()
        except BrokenPipeError:
            raise Failure("the server closed its input")

    def receive(self):
        length = None
        while True:
            header = self.proc.stdout.readline()
            if not header:
                raise Failure("the server closed its output")
            header = header.decode().strip()
            if not header:
                break
            name, _, value = header.partition(":")
            if name.lower() == "content-length":
                length = int(value)
        if length is None:
            raise Failure("a message without Content-Length")
        return json.loads(self.proc.stdout.read(length))

    def notify(self, method, params):
        self.send({"jsonrpc": "2.0", "method": method, "params": params})

    def request(self, method, params):
        id = self.next_id
        self.next_id += 1
        self.send({"jsonrpc": "2.0", "id": id, "method": method, "params": params})
        while True:
            msg = self.receive()
            if msg.get("id") == id and "method" not in msg:
                return msg
            self.show_notification(msg)

    def show_notification(self, msg):
        if msg.get("method") == "textDocument/publishDiagnostics":
            p = msg["params"]
            print("diagnostics %s%s" % (self.path(p["uri"]), "" if p["diagnostics"] else " none"))
            for d in p["diagnostics"]:
                print("  " + dump(self.render(d)))
        else:
            print("notification " + dump(self.render(msg)).replace(self.root + "/", ""))

    def path(self, uri):
        prefix = "file://" + self.root + "/"
        return uri[len(prefix):] if uri.startswith(prefix) else uri

    def render(self, v):
        """Ranges as `L:C-L:C`, locations as `FILE L:C-L:C`, URIs as paths."""
        if isinstance(v, dict):
            if set(v) == {"start", "end"} and isinstance(v["start"], dict):
                a, b = v["start"], v["end"]
                return "%d:%d-%d:%d" % (a["line"] + 1, a["character"] + 1, b["line"] + 1, b["character"] + 1)
            if set(v) == {"uri", "range"}:
                return "%s %s" % (self.path(v["uri"]), self.render(v["range"]))
            out = {}
            for k, x in v.items():
                if k == "changes" and isinstance(x, dict):
                    x = {self.path(u): e for u, e in x.items()}
                out[k] = self.render(x)
            return out
        if isinstance(v, list):
            return [self.render(x) for x in v]
        if isinstance(v, str) and v.startswith("file://"):
            return self.path(v)
        return v

    def doc(self, path):
        return {"textDocument": {"uri": self.uri(path)}}

    def lc(self, lc):
        line, _, col = lc.partition(":")
        return {"line": int(line) - 1, "character": int(col) - 1}

    def at(self, path, lc):
        line, _, col = lc.partition(":")
        p = self.doc(path)
        p["position"] = {"line": int(line) - 1, "character": int(col) - 1}
        return p

    def command(self, words, body, wait=True):
        cmd, args = words[0], words[1:]
        if cmd == "initialize":
            params = {"capabilities": {}, "initializationOptions": {}}
            if "check" in args:
                at = args.index("check")
                check = json.loads(" ".join(args[at + 1 :]))
                args = args[:at]
                params["initializationOptions"]["check"] = [
                    os.path.normpath(os.path.join(self.here, w)) if isinstance(w, str) and w.startswith(("./", "../")) else w
                    for w in check
                ]
            if "features" in args:
                names = args[args.index("features") + 1]
                params["initializationOptions"]["features"] = [] if names == "-" else names.split(",")
            if "timeout" in args:
                params["initializationOptions"]["checkTimeout"] = int(args[args.index("timeout") + 1])
            if "utf-8" in args:
                params["capabilities"]["general"] = {"positionEncodings": ["utf-8", "utf-16"]}
            if "root" in args:
                params["initializationOptions"]["root"] = os.path.join(self.root, args[args.index("root") + 1])
            if "folder" in args:
                params["workspaceFolders"] = [{"uri": "file://" + self.root, "name": "root"}]
            for i, a in enumerate(args):
                if a == "module":
                    name, _, file = args[i + 1].partition("=")
                    params["initializationOptions"].setdefault("modules", {})[name] = os.path.join(self.root, file)
            msg = self.request("initialize", params)
            legend = msg["result"]["capabilities"].get("semanticTokensProvider", {}).get("legend", {})
            self.legend = legend.get("tokenTypes", [])
            self.modifiers = legend.get("tokenModifiers", [])
            self.notify("initialized", {})
            if "quiet" not in args:
                self.show(msg)
        elif cmd == "open":
            text = body if body is not None else open(os.path.join(self.root, args[0]), encoding="utf-8", newline="").read()
            self.versions[args[0]] = 1
            self.notify("textDocument/didOpen", {"textDocument": {"uri": self.uri(args[0]), "languageId": "tally", "version": 1, "text": text}})
        elif cmd == "change":
            if body is None:
                raise Failure("change needs its new text on `| ` lines")
            self.versions[args[0]] += 1
            p = self.doc(args[0])
            p["textDocument"]["version"] = self.versions[args[0]]
            p["contentChanges"] = [{"text": body}]
            self.notify("textDocument/didChange", p)
        elif cmd == "edit":
            start, _, end = args[1].partition("-")
            text = json.loads(" ".join(args[2:]))
            self.versions[args[0]] += 1
            p = self.doc(args[0])
            p["textDocument"]["version"] = self.versions[args[0]]
            p["contentChanges"] = [{"range": {"start": self.lc(start), "end": self.lc(end)}, "text": text}]
            self.notify("textDocument/didChange", p)
        elif cmd == "save":
            self.notify("textDocument/didSave", self.doc(args[0]))
        elif cmd == "close":
            self.notify("textDocument/didClose", self.doc(args[0]))
        elif cmd in DOCUMENT:
            self.show(self.request(DOCUMENT[cmd], self.doc(args[0])), tokens=cmd == "tokens")
        elif cmd in POSITION:
            p = self.at(args[0], args[1])
            if cmd == "references":
                p["context"] = {"includeDeclaration": True}
            elif cmd == "selection":
                p["positions"] = [p.pop("position")]
            elif cmd == "rename":
                p["newName"] = args[2]
            self.show(self.request(POSITION[cmd], p))
        elif cmd == "request":
            self.show(self.request(args[0], self.doc(args[1])))
        elif cmd == "wait":
            deadline = time.time() + 10
            while not os.path.exists(os.path.join(self.tmp, args[0])):
                if time.time() > deadline:
                    raise Failure("no %s in LSP_TMP" % args[0])
                time.sleep(0.02)
        elif cmd == "exit":
            self.notify("exit", None)
            self.proc.stdin.close()
            rest = self.proc.stdout.read()
            code = self.proc.wait()
            self.timer.cancel()
            self.exited = True
            if rest:
                raise Failure("output after exit: %r" % rest[:200])
            print("exited %d" % code)
        else:
            raise Failure("unknown command " + cmd)
        if cmd in ("open", "change", "edit", "save", "close") and wait:
            self.sync()

    def sync(self):
        """Wait for what a notification sent: `nexus/idle` is answered once
        every analysis asked for has finished and published, and the
        server answers in order, so it handled the notification first."""
        self.request("nexus/idle", {})

    def show(self, msg, tokens=False):
        if "error" in msg:
            print("error %d %s" % (msg["error"]["code"], msg["error"]["message"]))
            return
        result = msg["result"]
        if tokens and result is not None:
            result = self.tokens(result["data"])
        elif isinstance(result, dict) and isinstance(result.get("items"), list):
            result = result["items"]
        result = self.render(result)
        if isinstance(result, list):
            if not result:
                print("[]")
            for x in result:
                print("  " + (x if tokens else dump(x)))
        else:
            print(dump(result))

    def tokens(self, data):
        out = []
        line = col = 0
        for i in range(0, len(data), 5):
            dl, dc, n, t, mods = data[i : i + 5]
            line += dl
            col = col + dc if dl == 0 else dc
            names = [m for b, m in enumerate(self.modifiers) if mods & (1 << b)]
            out.append(" ".join(["%d:%d %d %s" % (line + 1, col + 1, n, self.legend[t])] + names))
        return out

    def finish(self):
        self.show_tail(self.request("shutdown", None))
        self.notify("exit", None)
        self.proc.stdin.close()
        rest = self.proc.stdout.read()
        code = self.proc.wait()
        self.timer.cancel()
        if rest:
            raise Failure("output after exit: %r" % rest[:200])
        if code != 0:
            raise Failure("the server exited %d" % code)

    def show_tail(self, msg):
        if "error" in msg:
            raise Failure("shutdown: " + msg["error"]["message"])


DOCUMENT = {
    "tokens": "textDocument/semanticTokens/full",
    "folds": "textDocument/foldingRange",
    "symbols": "textDocument/documentSymbol",
    "format": "textDocument/formatting",
}

POSITION = {
    "hover": "textDocument/hover",
    "definition": "textDocument/definition",
    "typeDefinition": "textDocument/typeDefinition",
    "references": "textDocument/references",
    "highlight": "textDocument/documentHighlight",
    "signature": "textDocument/signatureHelp",
    "completion": "textDocument/completion",
    "selection": "textDocument/selectionRange",
    "rename": "textDocument/rename",
}


def dump(v):
    return v if isinstance(v, str) else json.dumps(v, sort_keys=True, separators=(",", ":"))


if __name__ == "__main__":
    main()
