%include "base.lamp"
# A comment with "quotes" and if
pub fun area(width: Int, height: Int) -> Int {
  return width * height
}

fun scale(x: real) -> real {
  while x <= 10 { x <<= 1 }
  if x < 2 and not done { x = x + 3.25 } else { x = 7 }
  return x
}

