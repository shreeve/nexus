{
  "name": "nexus-nexis",
  "displayName": "nexis (Nexus)",
  "description": "nexis: highlighting and its language server.",
  "version": "0.1.0",
  "publisher": "nexus-local",
  "license": "UNLICENSED",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:nexis"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server is the one the user's own settings name, never a workspace's.",
      "restrictedConfigurations": ["nexus-nexis.server.path"]
    }
  },
  "dependencies": {"vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "nexis",
      "aliases": ["nexis"],
      "extensions": ["nx"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nexis",
      "scopeName": "source.nexis",
      "path": "./syntaxes/nexis.tmLanguage.json"
    }],
    "configuration": {
      "title": "nexis (Nexus)",
      "properties": {
        "nexus-nexis.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The language server: a path, or a name on `PATH`, from user settings only. Empty: the extension's own `bin/nexis-lsp`, else `nexis-lsp` on `PATH`."
        },
        "nexus-nexis.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes; a relative path is relative to the first workspace folder. Empty: the file opened or saved."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "superType": "keyword", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "superType": "keyword", "description": "@highlight keyword.operator"},
      {"id": "constant", "superType": "enumMember", "description": "@highlight constant"},
      {"id": "constantNumeric", "superType": "number", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "superType": "enumMember", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "superType": "string", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "superType": "function", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "superType": "keyword", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "superType": "parameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "superType": "variable", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "nexis",
      "scopes": {
        "keyword": ["keyword.other.nexis"],
        "keywordControl": ["keyword.control.nexis"],
        "keywordOperator": ["keyword.operator.word.nexis"],
        "constant": ["constant.language.nexis"],
        "constantNumeric": ["constant.numeric.nexis"],
        "constantSymbol": ["constant.other.symbol.nexis"],
        "string": ["string.quoted.nexis"],
        "stringEscape": ["constant.character.escape.nexis"],
        "comment": ["comment.nexis"],
        "operator": ["keyword.operator.nexis"],
        "punctuation": ["punctuation.nexis"],
        "type": ["entity.name.type.nexis"],
        "function": ["entity.name.function.nexis"],
        "functionBuiltin": ["support.function.nexis"],
        "label": ["entity.name.label.nexis"],
        "storageModifier": ["storage.modifier.nexis"],
        "variableParameter": ["variable.parameter.nexis"],
        "variableSpecial": ["variable.language.nexis"],
        "invalid": ["invalid.illegal.nexis"]
      }
    }]
  }
}
