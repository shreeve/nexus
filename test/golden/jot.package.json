{
  "name": "nexus-jot",
  "displayName": "Jot (Nexus)",
  "description": "Jot: highlighting and its language server.",
  "version": "0.1.0",
  "publisher": "nexus-local",
  "license": "UNLICENSED",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:jot"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server and its check are the ones the user's own settings name, never a workspace's; the check runs only in a trusted workspace.",
      "restrictedConfigurations": ["nexus-jot.server.path", "nexus-jot.server.check"]
    }
  },
  "scripts": {"vscode:prepublish": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js"},
  "devDependencies": {"esbuild": "0.28.2", "vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "jot",
      "aliases": ["Jot"],
      "extensions": ["jot"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "jot",
      "scopeName": "source.jot",
      "path": "./syntaxes/jot.tmLanguage.json"
    }],
    "configuration": {
      "title": "Jot (Nexus)",
      "properties": {
        "nexus-jot.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The language server: a path, or a name on `PATH`, from user settings only. Empty: the extension's own `bin/jot-lsp`, else `jot-lsp` on `PATH`."
        },
        "nexus-jot.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes; a relative path is relative to the first workspace folder. Empty: each file's own program."
        },
        "nexus-jot.server.check": {
          "type": "array",
          "items": {"type": "string"},
          "default": [],
          "scope": "machine",
          "markdownDescription": "A command that checks the program when a file opens or is saved, as its words, from user settings only and run only in a trusted workspace: `${file}` is the file's path and `${root}` the program's root. Each line of its output `PATH:LINE:COL: error: MESSAGE` (or `warning:`) is a diagnostic, and each `note:` line a note of the one before it. Empty: no check."
        },
        "nexus-jot.server.checkTimeout": {
          "type": "integer",
          "default": 60000,
          "minimum": 1,
          "markdownDescription": "The milliseconds a check may run before it is stopped."
        },
        "nexus-jot.features": {
          "type": "array",
          "items": {"type": "string", "enum": ["diagnostics", "semanticTokens", "folding", "selection", "symbols", "hover", "definition", "references", "rename", "completion", "signature", "formatting", "check"]},
          "uniqueItems": true,
          "default": ["diagnostics", "semanticTokens", "folding", "selection", "symbols", "hover", "definition", "references", "rename", "completion", "signature", "formatting", "check"],
          "markdownDescription": "The features the language server serves, of those it has. Beside another language server for the language, the features the other lacks, such as `[\"semanticTokens\", \"folding\", \"selection\", \"check\"]`."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "superType": "keyword", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "superType": "keyword", "description": "@highlight keyword.operator"},
      {"id": "constant", "superType": "enumMember", "description": "@highlight constant"},
      {"id": "constantNumeric", "superType": "number", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "superType": "enumMember", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "superType": "string", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "superType": "function", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "superType": "keyword", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "superType": "parameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "superType": "variable", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "jot",
      "scopes": {
        "keyword": ["keyword.other.jot"],
        "keywordControl": ["keyword.control.jot"],
        "keywordOperator": ["keyword.operator.word.jot"],
        "constant": ["constant.language.jot"],
        "constantNumeric": ["constant.numeric.jot"],
        "constantSymbol": ["constant.other.symbol.jot"],
        "string": ["string.quoted.jot"],
        "stringEscape": ["constant.character.escape.jot"],
        "comment": ["comment.jot"],
        "operator": ["keyword.operator.jot"],
        "punctuation": ["punctuation.jot"],
        "type": ["entity.name.type.jot"],
        "function": ["entity.name.function.jot"],
        "functionBuiltin": ["support.function.jot"],
        "label": ["entity.name.label.jot"],
        "storageModifier": ["storage.modifier.jot"],
        "variableParameter": ["variable.parameter.jot"],
        "variableSpecial": ["variable.language.jot"],
        "invalid": ["invalid.illegal.jot"]
      }
    }]
  }
}
