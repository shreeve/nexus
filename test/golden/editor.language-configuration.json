{
  "comments": {"lineComment": "#"},
  "brackets": [["(", ")"], ["{", "}"]],
  "autoClosingPairs": [{"open": "(", "close": ")"}, {"open": "{", "close": "}"}],
  "surroundingPairs": [["(", ")"], ["{", "}"]],
  "indentationRules": {
    "increaseIndentPattern": "\\{[\\x09 ]*$",
    "decreaseIndentPattern": "^[\\x09 ]*\\}"
  }
}
