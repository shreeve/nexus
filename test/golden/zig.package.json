{
  "name": "vscode-zig",
  "displayName": "Zig",
  "description": "Zig: highlighting and its language server. Generated by nexus v2.3.0 from zig.grammar.",
  "version": "0.1.0",
  "publisher": "zig",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:zig"],
  "dependencies": {"vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "zig",
      "aliases": ["Zig"],
      "extensions": ["zig", "zon"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "zig",
      "scopeName": "source.zig",
      "path": "./syntaxes/zig.tmLanguage.json"
    }],
    "configuration": {
      "title": "Zig",
      "properties": {
        "zig.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language server: a path, or a name on `PATH`. Empty: the extension's own `bin/zig-lsp`, else `zig-lsp` on `PATH`."
        },
        "zig.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes. Empty: the file opened or saved."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "description": "@highlight keyword.operator"},
      {"id": "constant", "description": "@highlight constant"},
      {"id": "constantNumeric", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "zig",
      "scopes": {
        "keyword": ["keyword.other.zig"],
        "keywordControl": ["keyword.control.zig"],
        "keywordOperator": ["keyword.operator.word.zig"],
        "constant": ["constant.language.zig"],
        "constantNumeric": ["constant.numeric.zig"],
        "constantSymbol": ["constant.other.symbol.zig"],
        "string": ["string.quoted.zig"],
        "stringEscape": ["constant.character.escape.zig"],
        "comment": ["comment.zig"],
        "operator": ["keyword.operator.zig"],
        "punctuation": ["punctuation.zig"],
        "type": ["entity.name.type.zig"],
        "function": ["entity.name.function.zig"],
        "functionBuiltin": ["support.function.zig"],
        "label": ["entity.name.label.zig"],
        "storageModifier": ["storage.modifier.zig"],
        "variableParameter": ["variable.parameter.zig"],
        "variableSpecial": ["variable.language.zig"],
        "invalid": ["invalid.illegal.zig"]
      }
    }]
  }
}
