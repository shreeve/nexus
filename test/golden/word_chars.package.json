{
  "name": "vscode-mint",
  "displayName": "Mint",
  "description": "Mint: highlighting and its language server. Generated by nexus v2.3.0 from word_chars.grammar.",
  "version": "0.1.0",
  "publisher": "mint",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:mint"],
  "dependencies": {"vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "mint",
      "aliases": ["Mint"],
      "extensions": ["mint"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "mint",
      "scopeName": "source.mint",
      "path": "./syntaxes/mint.tmLanguage.json"
    }],
    "configuration": {
      "title": "Mint",
      "properties": {
        "mint.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language server: a path, or a name on `PATH`. Empty: the extension's own `bin/mint-lsp`, else `mint-lsp` on `PATH`."
        },
        "mint.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes. Empty: the file opened or saved."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "description": "@highlight keyword.operator"},
      {"id": "constant", "description": "@highlight constant"},
      {"id": "constantNumeric", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "mint",
      "scopes": {
        "keyword": ["keyword.other.mint"],
        "keywordControl": ["keyword.control.mint"],
        "keywordOperator": ["keyword.operator.word.mint"],
        "constant": ["constant.language.mint"],
        "constantNumeric": ["constant.numeric.mint"],
        "constantSymbol": ["constant.other.symbol.mint"],
        "string": ["string.quoted.mint"],
        "stringEscape": ["constant.character.escape.mint"],
        "comment": ["comment.mint"],
        "operator": ["keyword.operator.mint"],
        "punctuation": ["punctuation.mint"],
        "type": ["entity.name.type.mint"],
        "function": ["entity.name.function.mint"],
        "functionBuiltin": ["support.function.mint"],
        "label": ["entity.name.label.mint"],
        "storageModifier": ["storage.modifier.mint"],
        "variableParameter": ["variable.parameter.mint"],
        "variableSpecial": ["variable.language.mint"],
        "invalid": ["invalid.illegal.mint"]
      }
    }]
  }
}
