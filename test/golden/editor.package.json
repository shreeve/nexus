{
  "name": "vscode-tally",
  "displayName": "Tally",
  "description": "Tally: highlighting and its language server. Generated by nexus v2.3.0 from tally.grammar.",
  "version": "0.1.0",
  "publisher": "tally",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:tally"],
  "dependencies": {"vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "tally",
      "aliases": ["Tally"],
      "extensions": ["tally"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "tally",
      "scopeName": "source.tally",
      "path": "./syntaxes/tally.tmLanguage.json"
    }],
    "configuration": {
      "title": "Tally",
      "properties": {
        "tally.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language server: a path, or a name on `PATH`. Empty: the extension's own `bin/tally-lsp`, else `tally-lsp` on `PATH`."
        },
        "tally.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes. Empty: the file opened or saved."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "description": "@highlight keyword.operator"},
      {"id": "constant", "description": "@highlight constant"},
      {"id": "constantNumeric", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "tally",
      "scopes": {
        "keyword": ["keyword.other.tally"],
        "keywordControl": ["keyword.control.tally"],
        "keywordOperator": ["keyword.operator.word.tally"],
        "constant": ["constant.language.tally"],
        "constantNumeric": ["constant.numeric.tally"],
        "constantSymbol": ["constant.other.symbol.tally"],
        "string": ["string.quoted.tally"],
        "stringEscape": ["constant.character.escape.tally"],
        "comment": ["comment.tally"],
        "operator": ["keyword.operator.tally"],
        "punctuation": ["punctuation.tally"],
        "type": ["entity.name.type.tally"],
        "function": ["entity.name.function.tally"],
        "functionBuiltin": ["support.function.tally"],
        "label": ["entity.name.label.tally"],
        "storageModifier": ["storage.modifier.tally"],
        "variableParameter": ["variable.parameter.tally"],
        "variableSpecial": ["variable.language.tally"],
        "invalid": ["invalid.illegal.tally"]
      }
    }]
  }
}
