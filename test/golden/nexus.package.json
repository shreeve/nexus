{
  "name": "vscode-nexus",
  "displayName": "Nexus grammar",
  "description": "Nexus grammar: highlighting and its language server. Generated by nexus v2.3.0 from nexus.grammar.",
  "version": "0.1.0",
  "publisher": "nexus",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:nexus"],
  "dependencies": {"vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "nexus",
      "aliases": ["Nexus grammar"],
      "extensions": ["grammar"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nexus",
      "scopeName": "source.nexus",
      "path": "./syntaxes/nexus.tmLanguage.json"
    }],
    "configuration": {
      "title": "Nexus grammar",
      "properties": {
        "nexus.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language server: a path, or a name on `PATH`. Empty: the extension's own `bin/nexus-lsp`, else `nexus-lsp` on `PATH`."
        },
        "nexus.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes. Empty: the file opened or saved."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "description": "@highlight keyword.operator"},
      {"id": "constant", "description": "@highlight constant"},
      {"id": "constantNumeric", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "nexus",
      "scopes": {
        "keyword": ["keyword.other.nexus"],
        "keywordControl": ["keyword.control.nexus"],
        "keywordOperator": ["keyword.operator.word.nexus"],
        "constant": ["constant.language.nexus"],
        "constantNumeric": ["constant.numeric.nexus"],
        "constantSymbol": ["constant.other.symbol.nexus"],
        "string": ["string.quoted.nexus"],
        "stringEscape": ["constant.character.escape.nexus"],
        "comment": ["comment.nexus"],
        "operator": ["keyword.operator.nexus"],
        "punctuation": ["punctuation.nexus"],
        "type": ["entity.name.type.nexus"],
        "function": ["entity.name.function.nexus"],
        "functionBuiltin": ["support.function.nexus"],
        "label": ["entity.name.label.nexus"],
        "storageModifier": ["storage.modifier.nexus"],
        "variableParameter": ["variable.parameter.nexus"],
        "variableSpecial": ["variable.language.nexus"],
        "invalid": ["invalid.illegal.nexus"]
      }
    }]
  }
}
