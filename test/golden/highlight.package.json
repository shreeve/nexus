{
  "name": "vscode-lamp",
  "displayName": "Lamp",
  "description": "Lamp: highlighting and its language server. Generated by nexus v2.3.0 from highlight.grammar.",
  "version": "0.1.0",
  "publisher": "lamp",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:lamp"],
  "dependencies": {"vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "lamp",
      "aliases": ["Lamp"],
      "extensions": ["lamp", "lmp"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "lamp",
      "scopeName": "source.lamp",
      "path": "./syntaxes/lamp.tmLanguage.json"
    }],
    "configuration": {
      "title": "Lamp",
      "properties": {
        "lamp.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language server: a path, or a name on `PATH`. Empty: the extension's own `bin/lamp-lsp`, else `lamp-lsp` on `PATH`."
        },
        "lamp.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes. Empty: the file opened or saved."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "description": "@highlight keyword.operator"},
      {"id": "constant", "description": "@highlight constant"},
      {"id": "constantNumeric", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "lamp",
      "scopes": {
        "keyword": ["keyword.other.lamp"],
        "keywordControl": ["keyword.control.lamp"],
        "keywordOperator": ["keyword.operator.word.lamp"],
        "constant": ["constant.language.lamp"],
        "constantNumeric": ["constant.numeric.lamp"],
        "constantSymbol": ["constant.other.symbol.lamp"],
        "string": ["string.quoted.lamp"],
        "stringEscape": ["constant.character.escape.lamp"],
        "comment": ["comment.lamp"],
        "operator": ["keyword.operator.lamp"],
        "punctuation": ["punctuation.lamp"],
        "type": ["entity.name.type.lamp"],
        "function": ["entity.name.function.lamp"],
        "functionBuiltin": ["support.function.lamp"],
        "label": ["entity.name.label.lamp"],
        "storageModifier": ["storage.modifier.lamp"],
        "variableParameter": ["variable.parameter.lamp"],
        "variableSpecial": ["variable.language.lamp"],
        "invalid": ["invalid.illegal.lamp"]
      }
    }]
  }
}
