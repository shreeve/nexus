{
  "name": "vscode-mumps",
  "displayName": "M",
  "description": "M: highlighting and its language server. Generated by nexus v2.3.0 from mumps.grammar.",
  "version": "0.1.0",
  "publisher": "mumps",
  "engines": {"vscode": "^1.82.0"},
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:mumps"],
  "dependencies": {"vscode-languageclient": "9.0.1"},
  "contributes": {
    "languages": [{
      "id": "mumps",
      "aliases": ["M"],
      "extensions": ["m"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "mumps",
      "scopeName": "source.mumps",
      "path": "./syntaxes/mumps.tmLanguage.json"
    }],
    "configuration": {
      "title": "M",
      "properties": {
        "mumps.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language server: a path, or a name on `PATH`. Empty: the extension's own `bin/mumps-lsp`, else `mumps-lsp` on `PATH`."
        },
        "mumps.server.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "The file the program starts from, which the server analyzes. Empty: the file opened or saved."
        }
      }
    },
    "semanticTokenTypes": [
      {"id": "keywordControl", "description": "@highlight keyword.control"},
      {"id": "keywordOperator", "description": "@highlight keyword.operator"},
      {"id": "constant", "description": "@highlight constant"},
      {"id": "constantNumeric", "description": "@highlight constant.numeric"},
      {"id": "constantSymbol", "description": "@highlight constant.symbol"},
      {"id": "stringEscape", "description": "@highlight string.escape"},
      {"id": "punctuation", "description": "@highlight punctuation"},
      {"id": "functionBuiltin", "description": "@highlight function.builtin"},
      {"id": "storageModifier", "description": "@highlight storage.modifier"},
      {"id": "variableParameter", "description": "@highlight variable.parameter"},
      {"id": "variableSpecial", "description": "@highlight variable.special"},
      {"id": "invalid", "description": "@highlight invalid"}
    ],
    "semanticTokenScopes": [{
      "language": "mumps",
      "scopes": {
        "keyword": ["keyword.other.mumps"],
        "keywordControl": ["keyword.control.mumps"],
        "keywordOperator": ["keyword.operator.word.mumps"],
        "constant": ["constant.language.mumps"],
        "constantNumeric": ["constant.numeric.mumps"],
        "constantSymbol": ["constant.other.symbol.mumps"],
        "string": ["string.quoted.mumps"],
        "stringEscape": ["constant.character.escape.mumps"],
        "comment": ["comment.mumps"],
        "operator": ["keyword.operator.mumps"],
        "punctuation": ["punctuation.mumps"],
        "type": ["entity.name.type.mumps"],
        "function": ["entity.name.function.mumps"],
        "functionBuiltin": ["support.function.mumps"],
        "label": ["entity.name.label.mumps"],
        "storageModifier": ["storage.modifier.mumps"],
        "variableParameter": ["variable.parameter.mumps"],
        "variableSpecial": ["variable.language.mumps"],
        "invalid": ["invalid.illegal.mumps"]
      }
    }]
  }
}
