#!/bin/bash
# Nexus test suite. See test/README.md for the layout and file formats.
#
# Usage:
#   ./test/run [options] [filter...]
#
#   filter      only run tests whose id contains one of these substrings;
#               ids look like mumps/label_dots, rig/known/..., gen/ruby,
#               sexp/nexus, determinism/ruby, adverse/no_arrow,
#               known/multi_alt_start, unit/mumps, unit/nexus, bootstrap,
#               tools/diff, docs/GRAMMAR/L42-calc (see test/README.md)
#   -v          also list passing and known-failing tests
#   -j N        parallel jobs (default: CPU count)
#   --update    rewrite goldens (test/golden/*, cases/*.tree) from the
#               current generator; never touches known/ trees
#
# Exit status is 1 if any test fails or a known-failing test starts
# passing (move it out of its known/ directory when that happens), and 2
# on a usage error, when no test id matches the filters, or when another
# test/run is running in this checkout.

set -uo pipefail

cd "$(dirname "$0")/.."
ROOT=$(pwd)
NEXUS="$ROOT/bin/nexus"
LIB="$ROOT/test/lib"
OUTROOT="$ROOT/.zig-cache/nexus-test"
DOCS_OUT=.zig-cache/nexus-test/docs
PANIC_RE='Segmentation fault|panic:|panic at|reached unreachable|index out of bounds|Bus error|Illegal instruction|Abort trap'
POS_RE='\.grammar:[0-9]+:[0-9]+: error'
TIMEOUT=${NEXUS_TEST_TIMEOUT:-60}

# -----------------------------------------------------------------------------
# Suites: a directory holding one grammar (test/<name>/ or test/known/<name>/),
# its @lang module files, optional test.conf, and cases/ + known/ inputs.
# -----------------------------------------------------------------------------

# suite_conf <dir>: sets GRAMMAR LANG_FILES START FLAGS (absolute paths),
# and CONF_ERROR when the directory holds several grammars and test.conf
# names none.
suite_conf() {
    local dir=$1 grammar="" lang="" start="" flags=""
    if [[ -f "$dir/test.conf" ]]; then
        # shellcheck disable=SC1091
        eval "$(cd "$dir" && { source ./test.conf; declare -p grammar lang start flags 2>/dev/null; })"
    fi
    CONF_ERROR=""
    if [[ -z "$grammar" ]]; then
        grammar=$(cd "$dir" && ls ./*.grammar 2>/dev/null)
        if [[ $grammar == *$'\n'* ]]; then
            CONF_ERROR="$dir holds several grammars; name one with grammar= in test.conf"
            grammar=""
        fi
    fi
    [[ -z "$lang" ]] && lang=$(cd "$dir" && ls ./*.zig 2>/dev/null | tr '\n' ' ')
    GRAMMAR=""
    [[ -n "$grammar" ]] && GRAMMAR=$(cd "$dir" && cd "$(dirname "$grammar")" && echo "$(pwd)/$(basename "$grammar")")
    LANG_FILES=()
    local f
    for f in $lang; do LANG_FILES+=("$(cd "$dir" && cd "$(dirname "$f")" && echo "$(pwd)/$(basename "$f")")"); done
    START=$start
    FLAGS=$flags
}

# with_timeout <seconds> <command...>: run the command in its own process
# group and kill the group after <seconds>, exiting 124 (GNU timeout's
# contract, in perl, which every supported system ships); otherwise exit
# with the command's status, or 128+N when signal N killed it.
with_timeout() {
    perl -e '
        my $secs = shift;
        my $pid = fork // die "fork: $!\n";
        if (!$pid) { setpgrp(0, 0); exec { $ARGV[0] } @ARGV; print STDERR "$ARGV[0]: $!\n"; exit 127 }
        my $stop = sub { kill "KILL", -$pid, $pid; waitpid $pid, 0; exit $_[0] };
        $SIG{ALRM} = sub { $stop->(124) };
        $SIG{$_} = sub { $stop->(130) } for qw(INT TERM HUP);
        alarm $secs;
        waitpid $pid, 0;
        exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
    ' "$@"
}

key_of() { local k=${1#test/}; k=${k#grammars/}; echo "${k//\//__}"; }

# directive <name> <file> → all values of `# name: value`
directive() { sed -n "s/^# $1:[[:space:]]*//p" "$2"; }

first_error() { # first_error <log>: the most useful line of a gen/compile log
    local line
    line=$(grep -m1 -E 'error:|panic' "$1" 2>/dev/null) || line=$(tail -1 "$1" 2>/dev/null)
    line=${line#*error: }
    echo "${line:0:160}"
}

# build_suite <dir>: generate + compile into $OUTROOT/build/<key>; writes
# $WORK/build/<key> = "<rc>\t<reason>" (atomically: waiters poll for it)
build_suite() {
    local dir=$1 key out rc reason=""
    key=$(key_of "$dir")
    out="$OUTROOT/build/$key"
    suite_conf "$dir"
    NEXUS_FLAGS=$FLAGS with_timeout "$TIMEOUT" "$LIB/build-grammar" "$NEXUS" "$GRAMMAR" "$out" ${LANG_FILES[@]+"${LANG_FILES[@]}"}
    rc=$?
    case $rc in
        0) ;;
        10) reason="generation failed: $(first_error "$out/gen.log")" ;;
        11) reason="compile failed: $(first_error "$out/compile.log")" ;;
        *) reason="build exited $rc" ;;
    esac
    printf '%s\t%s\n' "$rc" "$reason" >"$WORK/build/$key.tmp"
    mv "$WORK/build/$key.tmp" "$WORK/build/$key"
}

# lang_args: after suite_conf, sets LANG_ARGS to `--lang <file>` when the
# grammar has @lang = "<name>": the suite's lang file <name>.zig, and
# LANG_MODULE to <name>.zig.
lang_args() {
    local lang f
    lang=$(sed -n 's/^@lang[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$GRAMMAR")
    LANG_ARGS=() LANG_MODULE=""
    [[ -n $lang ]] || return 0
    LANG_MODULE=$lang.zig
    for f in ${LANG_FILES[@]+"${LANG_FILES[@]}"}; do
        [[ $(basename "$f") == "$LANG_MODULE" ]] && LANG_ARGS=(--lang "$f")
    done
    [[ ${#LANG_ARGS[@]} -gt 0 ]] || LANG_ARGS=(--lang "$LANG_MODULE")
}

# without_directives <grammar> <names...>: the grammar without the blocks
# of the directives named (`@lsp`), on standard output.
without_directives() {
    local g=$1
    shift
    awk -v names=" $* " '
        /^@[a-z]+/ { word = $1; skip = index(names, " " word " ") > 0; if (skip) next }
        skip && /^[^ \t#]/ { skip = 0 }
        !skip' "$g"
}

# build_server <variant dir>: `nexus --editor` the grammar of the suite
# that holds the variant into $OUTROOT/build/<key>, with the variant's
# hooks.zig (or the stub, if it has none), and `zig build` its server;
# writes $WORK/build/<key> like build_suite. A variant's `without` file
# names directives (`@lsp`) its server is built without.
build_server() {
    local vdir=$1 key out rc reason="" gdir
    key=$(key_of "$vdir")
    out="$OUTROOT/build/$key"
    suite_conf "$(dirname "$vdir")"
    lang_args
    mkdir -p "$out/server/src"
    rm -f "$out/server/src/hooks.zig"
    [[ -f $vdir/hooks.zig ]] && cp "$vdir/hooks.zig" "$out/server/src/hooks.zig"
    gdir=$(dirname "$GRAMMAR")
    if [[ -f $vdir/without ]]; then
        gdir="$out/grammar"
        mkdir -p "$gdir"
        # shellcheck disable=SC2046 # one directive a word
        without_directives "$GRAMMAR" $(cat "$vdir/without") >"$gdir/$(basename "$GRAMMAR")"
        cp ${LANG_FILES[@]+"${LANG_FILES[@]}"} "$gdir/" 2>/dev/null
    fi
    (cd "$gdir" && with_timeout "$TIMEOUT" "$NEXUS" --editor ${LANG_ARGS[@]+"${LANG_ARGS[@]}"} "$(basename "$GRAMMAR")" "$out") >"$out/gen.log" 2>&1
    rc=$?
    if [[ $rc -ne 0 ]]; then
        rc=10 reason="--editor failed: $(first_error "$out/gen.log")"
    elif ! (cd "$out/server" && with_timeout 600 zig build --cache-dir "$OUTROOT/zig") >"$out/compile.log" 2>&1; then
        rc=11 reason="the server does not build: $(first_error "$out/compile.log")"
    fi
    printf '%s\t%s\n' "$rc" "$reason" >"$WORK/build/$key.tmp"
    mv "$WORK/build/$key.tmp" "$WORK/build/$key"
}

# ensure_built <dir> [builder]: build the suite (or, with build_server,
# the variant's server) once per run. The first worker to ask builds it;
# the others wait for its result (at most the build's timeout).
ensure_built() {
    local key ticks=0
    key=$(key_of "$1")
    [[ -f "$WORK/build/$key" ]] && return 0
    if mkdir "$WORK/lock/$key" 2>/dev/null; then
        ("${2:-build_suite}" "$1")
        return 0
    fi
    while [[ ! -f "$WORK/build/$key" ]]; do
        [[ $ticks -gt $(((TIMEOUT + 30) * 10)) ]] && return 1
        sleep 0.1
        ticks=$((ticks + 1))
    done
}

# -----------------------------------------------------------------------------
# Checks. Each sets REASON and returns 0 on pass; details go to $LOG.
# -----------------------------------------------------------------------------

check_wasm32() { # check_wasm32 <suite dir>: the parser and driver build for 32-bit wasm
    local dir=$1
    check_built "$dir" || return 1
    local out="$OUTROOT/build/$(key_of "$dir")"
    if ! (cd "$out" && with_timeout 300 zig build-exe -target wasm32-wasi -fno-emit-bin driver.zig --cache-dir "$OUTROOT/zig") >>"$LOG" 2>&1; then
        REASON="does not build for wasm32-wasi"
        return 1
    fi
    return 0
}

check_built() { # check_built <suite dir> [builder]
    local key st why
    key=$(key_of "$1")
    ensure_built "$1" "${2:-}"
    IFS=$'\t' read -r st why <"$WORK/build/$key" || { REASON="suite was not built"; return 1; }
    if [[ $st -ne 0 ]]; then
        REASON=$why
        local out="$OUTROOT/build/$key"
        { echo "--- gen.log"; cat "$out/gen.log" 2>/dev/null; echo "--- compile.log"; head -30 "$out/compile.log" 2>/dev/null; } >>"$LOG"
        return 1
    fi
    return 0
}

# check_case <suite dir> <case file> <start> <tree file> <may-update>
check_case() {
    local dir=$1 file=$2 start=$3 tree=$4 may_update=$5
    check_built "$dir" || return 1
    local out="$OUTROOT/build/$(key_of "$dir")"
    local got="$WORK/out/$(key_of "$file").got" err="$WORK/out/$(key_of "$file").err"
    local args=()
    [[ -n "$start" ]] && args=(--start "$start")
    # Extra driver options for this case (doc examples: `--no-spans`).
    # shellcheck disable=SC2207
    [[ -f "${file%.*}.args" ]] && args+=($(<"${file%.*}.args"))
    with_timeout "$TIMEOUT" "$out/driver" ${args[@]+"${args[@]}"} "$file" >"$got" 2>"$err" </dev/null
    local rc=$?
    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    if [[ $rc -gt 1 ]]; then
        REASON="driver crashed (exit $rc): $(grep -m1 -E "$PANIC_RE|error" "$err" || head -1 "$err")"
        cat "$err" >>"$LOG"
        return 1
    fi
    if [[ -n "$UPDATE" && $may_update == 1 ]]; then
        cp "$got" "$tree"
        return 0
    fi
    if [[ ! -f "$tree" ]]; then REASON="missing $(basename "$tree") (run with --update)"; return 1; fi
    if ! diff "$tree" "$got" >"$got.diff" 2>&1; then
        REASON="tree differs from $(basename "$tree")"
        { echo "--- diff (expected vs actual)"; cat "$got.diff"; } >>"$LOG"
        return 1
    fi
    return 0
}

# check_rejects <grammar>: generation (and `nexus check`) fails with exit 1, writing nothing, a
# file:line:col diagnostic, every `# error:` text of the grammar, and none
# of its `# absent:` texts.
check_rejects() {
    local g=$1 out rc
    local tmp="$WORK/out/$(key_of "$g").zig"
    out=$(cd "$(dirname "$g")" && with_timeout "$TIMEOUT" "$NEXUS" "$(basename "$g")" "$tmp" 2>&1 </dev/null)
    rc=$?
    echo "$out" >>"$LOG"
    if [[ $rc -eq 124 ]]; then REASON="timed out"; return 1; fi
    if [[ $rc -gt 128 ]] || grep -qE "$PANIC_RE" <<<"$out"; then REASON="generator crashed"; return 1; fi
    if [[ -z "$(directive error "$g")" ]]; then REASON="no # error: directive"; return 1; fi
    local got
    got=$(grep -m1 'error:' <<<"$out" | sed 's/^[[:space:]]*//')
    if [[ $rc -ne 1 ]]; then REASON="exit status $rc (expected 1); said: ${got:-nothing}"; return 1; fi
    if [[ -e "$tmp" ]]; then REASON="the rejected grammar's output file was written"; return 1; fi
    local want
    while IFS= read -r want; do
        [[ -z "$want" ]] && continue
        if ! grep -qiF -- "$want" <<<"$out"; then
            REASON="output lacks \"$want\"; said: ${got:-nothing}"
            return 1
        fi
    done < <(directive error "$g")
    while IFS= read -r want; do
        [[ -z "$want" ]] && continue
        if grep -qiF -- "$want" <<<"$out"; then REASON="output contains \"$want\""; return 1; fi
    done < <(directive absent "$g")
    if ! grep -qE "$POS_RE" <<<"$out"; then REASON="no file:line:col: error: diagnostic"; return 1; fi
    # `nexus check` reports what generation reports.
    out=$(cd "$(dirname "$g")" && with_timeout "$TIMEOUT" "$NEXUS" check "$(basename "$g")" 2>&1 </dev/null)
    rc=$?
    echo "--- nexus check" >>"$LOG"; echo "$out" >>"$LOG"
    if [[ $rc -ne 1 ]] || ! grep -qE "$POS_RE" <<<"$out"; then REASON="nexus check exits $rc (expected 1 and a file:line:col: error:)"; return 1; fi
    return 0
}

# check_bug_suite <dir>: a self-contained bug test (test/known/<name>/ or
# test/regress/<name>/).
# With `# error:` directives its grammar must be rejected; otherwise it must
# generate cleanly (`# absent:` / `# generated-has:`), compile, and every
# case under cases/ must produce its tree.
check_bug_suite() {
    local dir=$1
    suite_conf "$dir"
    local g=$GRAMMAR
    if grep -qE '^# error:' "$g"; then check_rejects "$g"; return; fi
    if grep -qE '^# compile-error:' "$g"; then check_compile_error "$dir"; return; fi
    check_built "$dir" || return 1
    local out="$OUTROOT/build/$(key_of "$dir")" want
    cat "$out/gen.log" >>"$LOG"
    while IFS= read -r want; do
        [[ -z "$want" ]] && continue
        if grep -qiF -- "$want" "$out/gen.log"; then REASON="generator output contains \"$want\""; return 1; fi
    done < <(directive absent "$g")
    while IFS= read -r want; do
        [[ -z "$want" ]] && continue
        if ! grep -qF -- "$want" "$out/parser.zig"; then REASON="generated parser lacks \"$want\""; return 1; fi
    done < <(directive generated-has "$g")
    local file start tree
    while IFS=$'\x1f' read -r file start tree; do
        check_case "$dir" "$file" "$start" "$tree" 0 || { REASON="$(basename "$file"): $REASON"; return 1; }
    done < <(list_cases "$dir/cases")
    return 0
}

# check_compile_error <dir>: the grammar generates, but its parser must not
# build: the compile log has every `# compile-error:` text.
check_compile_error() {
    local dir=$1 key st why want
    key=$(key_of "$dir")
    ensure_built "$dir"
    IFS=$'\t' read -r st why <"$WORK/build/$key" || { REASON="suite was not built"; return 1; }
    local out="$OUTROOT/build/$key"
    cat "$out/gen.log" "$out/compile.log" >>"$LOG" 2>/dev/null
    case $st in
        0) REASON="the parser builds (expected a compile error)"; return 1 ;;
        11) ;;
        *) REASON=$why; return 1 ;;
    esac
    while IFS= read -r want; do
        [[ -z "$want" ]] && continue
        if ! grep -qF -- "$want" "$out/compile.log"; then REASON="compile errors lack \"$want\": $(first_error "$out/compile.log")"; return 1; fi
    done < <(directive compile-error "$GRAMMAR")
    return 0
}

# list_cases <cases dir> → "file␟start␟tree" lines (␟ = \x1f, so an empty
# start survives `read`). Files directly in
# the dir use the suite's start rule; files in a subdirectory <s>/ use
# parse<S> (or the subdirectory name itself if it starts with "parse").
list_cases() {
    local cdir=$1 f sub start
    [[ -d "$cdir" ]] || return 0
    for f in "$cdir"/*; do
        [[ -f "$f" ]] || continue
        case $f in *.tree|*.args|*.md|*/README*) continue ;; esac
        printf '%s\x1f%s\x1f%s\n' "$f" "$START" "${f%.*}.tree"
    done
    for sub in "$cdir"/*/; do
        [[ -d "$sub" ]] || continue
        start=$(basename "$sub")
        [[ $start == parse* ]] || start="parse$(tr '[:lower:]' '[:upper:]' <<<"${start:0:1}")${start:1}"
        for f in "$sub"*; do
            [[ -f "$f" ]] || continue
            case $f in *.tree|*.args|*.md|*/README*) continue ;; esac
            printf '%s\x1f%s\x1f%s\n' "$f" "$start" "${f%.*}.tree"
        done
    done
}

# golden <output> <golden file>: the output equals the golden file (with
# --update, replaces it). A missing golden fails.
golden() {
    if [[ -n "$UPDATE" ]]; then cp "$1" "$2"; return 0; fi
    if [[ ! -f "$2" ]]; then REASON="missing $2 (run with --update)"; return 1; fi
    if ! diff "$2" "$1" >"$1.diff" 2>&1; then
        REASON="$(grep -c '^[<>]' "$1.diff") lines differ from $2"
        head -60 "$1.diff" >>"$LOG"
        return 1
    fi
    return 0
}

check_golden_gen() { # check_golden_gen <suite dir> <name>: generated with the suite's flags
    local dir=$1 name=$2 tmp="$WORK/out/gen_$2.zig"
    suite_conf "$dir"
    # shellcheck disable=SC2086 # FLAGS: generator options, split on spaces
    (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" $FLAGS "$(basename "$GRAMMAR")" "$tmp") >>"$LOG" 2>&1
    local rc=$?
    if [[ $rc -ne 0 || ! -s "$tmp" ]]; then REASON="generation failed (exit $rc)"; return 1; fi
    golden "$tmp" "test/golden/$name.zig"
}

check_sexp() { # check_sexp <suite dir> <name>
    local dir=$1 name=$2 tmp="$WORK/out/sexp_$2.sexp"
    suite_conf "$dir"
    with_timeout "$TIMEOUT" "$NEXUS" --dump-sexp "$GRAMMAR" "$tmp" >>"$LOG" 2>&1
    local rc=$?
    if [[ $rc -ne 0 || ! -s "$tmp" ]]; then REASON="dump failed (exit $rc)"; return 1; fi
    golden "$tmp" "test/golden/$name.sexp"
}

check_describe() { # check_describe <suite dir> <name>: --describe equals the golden
    local dir=$1 name=$2 tmp="$WORK/out/describe_$2.json"
    suite_conf "$dir"
    (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" --describe "$(basename "$GRAMMAR")" "$tmp") >>"$LOG" 2>&1
    local rc=$?
    if [[ $rc -ne 0 || ! -s "$tmp" ]]; then REASON="--describe failed (exit $rc)"; return 1; fi
    golden "$tmp" "test/golden/$name.describe.json"
}

check_coverage() { # check_coverage <suite dir> <name>: `check --messages` equals the golden
    local dir=$1 name=$2 tmp="$WORK/out/coverage_$2.txt"
    suite_conf "$dir"
    (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" check --messages "$(basename "$GRAMMAR")" >"$tmp") 2>>"$LOG"
    local rc=$?
    if [[ $rc -ne 0 || ! -s "$tmp" ]]; then REASON="check --messages failed (exit $rc)"; return 1; fi
    golden "$tmp" "test/golden/$name.messages.txt"
}

# The golden of each editor file: test/golden/<name>.<suffix>.
hl_suffix() {
    case $1 in
        textmate) echo tmLanguage.json ;;
        language-configuration) echo language-configuration.json ;;
        highlightjs) echo hljs.js ;;
        vim) echo vim ;;
    esac
}

# check_highlight_all <suite dir> <name>: `--highlight all` writes the
# four editor files, and only them, each equal to its golden (and to
# `--highlight <target>` on standard output).
check_highlight_all() {
    local dir=$1 name=$2 out="$WORK/out/editors_$2" id t rel
    suite_conf "$dir"
    id=$(sed -n 's/^[[:space:]]*scope-name[[:space:]]*[a-z]*\.\([a-z0-9_.]*\).*/\1/p' "$GRAMMAR" | sed 's/.*\.//')
    (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" --highlight all "$(basename "$GRAMMAR")" "$out") >>"$LOG" 2>&1
    local rc=$?
    if [[ $rc -ne 0 ]]; then REASON="--highlight all failed (exit $rc)"; return 1; fi
    local want got
    want=$(printf '%s\n' "highlightjs/$id.js" "vim/syntax/$id.vim" "vscode/language-configuration.json" "vscode/syntaxes/$id.tmLanguage.json")
    got=$(cd "$out" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
    if [[ $got != "$want" ]]; then REASON="--highlight all wrote: $(tr '\n' ' ' <<<"$got")"; return 1; fi
    for t in textmate language-configuration highlightjs vim; do
        case $t in
            textmate) rel="vscode/syntaxes/$id.tmLanguage.json" ;;
            language-configuration) rel="vscode/language-configuration.json" ;;
            highlightjs) rel="highlightjs/$id.js" ;;
            vim) rel="vim/syntax/$id.vim" ;;
        esac
        (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" --highlight "$t" "$(basename "$GRAMMAR")" -) >"$out.$t" 2>>"$LOG"
        if ! cmp -s "$out.$t" "$out/$rel"; then REASON="--highlight $t differs from $rel of --highlight all"; return 1; fi
        golden "$out/$rel" "test/golden/$name.$(hl_suffix "$t")" || { REASON="$t: $REASON"; return 1; }
    done
    # @highlight changes nothing in the generated module.
    local gd stripped="$WORK/out/nohl_$2"
    gd=$(dirname "$GRAMMAR")
    mkdir -p "$stripped"
    awk '/^@highlight/ { skip = 1; next } skip && /^[^ \t#]/ { skip = 0 } !skip' "$GRAMMAR" >"$stripped/$(basename "$GRAMMAR")"
    cp ${LANG_FILES[@]+"${LANG_FILES[@]}"} "$stripped/" 2>/dev/null
    # shellcheck disable=SC2086 # FLAGS: generator options, split on spaces
    (cd "$gd" && with_timeout "$TIMEOUT" "$NEXUS" $FLAGS "$(basename "$GRAMMAR")" "$stripped/with.zig" &&
        cd "$stripped" && with_timeout "$TIMEOUT" "$NEXUS" $FLAGS "$(basename "$GRAMMAR")" "$stripped/without.zig") >>"$LOG" 2>&1
    if ! cmp -s "$stripped/with.zig" "$stripped/without.zig"; then REASON="the generated module differs without @highlight"; return 1; fi
    # Nor does @lsp.
    if grep -q '^@lsp' "$GRAMMAR"; then
        without_directives "$GRAMMAR" @lsp >"$stripped/$(basename "$GRAMMAR")"
        # shellcheck disable=SC2086 # FLAGS: generator options, split on spaces
        (cd "$stripped" && with_timeout "$TIMEOUT" "$NEXUS" $FLAGS "$(basename "$GRAMMAR")" "$stripped/without.zig") >>"$LOG" 2>&1
        if ! cmp -s "$stripped/with.zig" "$stripped/without.zig"; then REASON="the generated module differs without @lsp"; return 1; fi
    fi
    return 0
}

# check_editor_files <suite dir> <name>: `--editor` writes the files of
# `--highlight all`, the extension and the server, and nothing else but the
# lang module and its imports, copied verbatim. The highlight files are
# those of `--highlight all`, parser.zig the module `--spans` generates,
# lsp.zig src/lsp/server_template.zig under a header, and with @lsp
# scopes.zig src/lsp/scopes_template.zig; language.zig and
# package.json equal their goldens, and so (for the editor suite) do
# extension.js, identity.json, README.md, .vscodeignore, build.zig,
# main.zig and the stub hooks.zig; package.json's semantic token types
# agree with the server's legend (test/lib/vscode). A second run writes
# the same bytes and keeps a hooks.zig that was changed, and identity.json.
check_editor_files() {
    local dir=$1 name=$2 out="$WORK/out/editor_$2" id gd gn
    suite_conf "$dir"
    lang_args
    gd=$(dirname "$GRAMMAR") gn=$(basename "$GRAMMAR")
    id=$(sed -n 's/^[[:space:]]*scope-name[[:space:]]*[a-z]*\.\([a-z0-9_.]*\).*/\1/p' "$GRAMMAR" | sed 's/.*\.//')
    in_gd() { (cd "$gd" && with_timeout "$TIMEOUT" "$NEXUS" "$@") >>"$LOG" 2>&1; }
    in_gd --editor ${LANG_ARGS[@]+"${LANG_ARGS[@]}"} "$gn" "$out/a" || { REASON="--editor failed"; return 1; }
    local want got f extra=""
    want=$(printf '%s\n' "highlightjs/$id.js" server/.gitignore server/build.zig server/src/hooks.zig server/src/language.zig \
        server/src/lsp.zig server/src/main.zig server/src/parser.zig "vim/syntax/$id.vim" vscode/.gitignore vscode/.vscodeignore \
        vscode/README.md vscode/extension.js vscode/identity.json vscode/language-configuration.json vscode/package.json \
        "vscode/syntaxes/$id.tmLanguage.json")
    grep -q '^@lsp' "$GRAMMAR" && want=$(printf '%s\nserver/src/scopes.zig\n' "$want" | LC_ALL=C sort)
    got=$(cd "$out/a" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
    while IFS= read -r f; do
        grep -qxF "$f" <<<"$got" || { REASON="--editor did not write $f"; return 1; }
    done <<<"$want"
    while IFS= read -r f; do
        grep -qxF "$f" <<<"$want" && continue
        [[ $f == server/src/* ]] || { REASON="--editor wrote $f"; return 1; }
        extra="$extra ${f#server/src/}"
    done <<<"$got"
    local mdir
    for f in $extra; do
        if [[ $f == "$LANG_MODULE" ]]; then
            (cd "$gd" && cmp -s "${LANG_ARGS[1]}" "$out/a/server/src/$f") || { REASON="server/src/$f is not the lang module"; return 1; }
            continue
        fi
        mdir=$(cd "$gd" && cd "$(dirname "${LANG_ARGS[1]:-.}")" && pwd)
        cmp -s "$mdir/$f" "$out/a/server/src/$f" || { REASON="server/src/$f is not $mdir/$f"; return 1; }
    done
    [[ -z $LANG_MODULE || " $extra " == *" $LANG_MODULE "* ]] || { REASON="--editor did not write server/src/$LANG_MODULE"; return 1; }
    in_gd --highlight all "$gn" "$out/hl" || { REASON="--highlight all failed"; return 1; }
    for f in $(cd "$out/hl" && find . -type f | sed 's|^\./||'); do
        cmp -s "$out/hl/$f" "$out/a/$f" || { REASON="$f differs from that of --highlight all"; return 1; }
    done
    in_gd --spans "$gn" "$out/parser.zig" || { REASON="generation failed"; return 1; }
    cmp -s "$out/parser.zig" "$out/a/server/src/parser.zig" || { REASON="server/src/parser.zig is not the module --spans generates"; return 1; }
    local header
    header="//! Generated by nexus v$(sed -n 's/^pub const version = "\(.*\)";/\1/p' src/version.zig) — do not edit"
    [[ $(head -1 "$out/a/server/src/lsp.zig") == "$header" ]] || { REASON="server/src/lsp.zig does not start with \"$header\""; return 1; }
    tail -n +2 "$out/a/server/src/lsp.zig" | cmp -s - src/lsp/server_template.zig || { REASON="server/src/lsp.zig is not src/lsp/server_template.zig"; return 1; }
    if grep -q '^@lsp' "$GRAMMAR"; then
        [[ $(head -1 "$out/a/server/src/scopes.zig") == "$header" ]] || { REASON="server/src/scopes.zig does not start with \"$header\""; return 1; }
        tail -n +2 "$out/a/server/src/scopes.zig" | cmp -s - src/lsp/scopes_template.zig || { REASON="server/src/scopes.zig is not src/lsp/scopes_template.zig"; return 1; }
    fi
    golden "$out/a/server/src/language.zig" "test/golden/$name.language.zig" || return 1
    golden "$out/a/vscode/package.json" "test/golden/$name.package.json" || return 1
    command -v node >/dev/null || { REASON="node not found"; return 1; }
    local legend
    legend=$(node "$LIB/vscode" legend "$out/a/vscode/package.json" src/lsp/server_template.zig 2>&1) ||
        { REASON="package.json and the server's legend disagree: $(head -1 <<<"$legend")"; return 1; }
    if [[ $name == editor ]]; then
        golden "$out/a/vscode/extension.js" test/golden/editor.extension.js || return 1
        golden "$out/a/vscode/identity.json" test/golden/editor.identity.json || return 1
        golden "$out/a/vscode/README.md" test/golden/editor.readme.txt || return 1
        golden "$out/a/vscode/.vscodeignore" test/golden/editor.vscodeignore || return 1
        golden "$out/a/server/build.zig" test/golden/editor.build.zig || return 1
        golden "$out/a/server/src/main.zig" test/golden/editor.main.zig || return 1
        golden "$out/a/server/src/hooks.zig" test/golden/editor.hooks.zig || return 1
    fi
    cp -R "$out/a" "$out/b"
    echo "// changed" >>"$out/b/server/src/hooks.zig"
    in_gd --editor ${LANG_ARGS[@]+"${LANG_ARGS[@]}"} "$gn" "$out/b" || { REASON="the second --editor failed"; return 1; }
    grep -qF "Kept $out/b/server/src/hooks.zig" "$LOG" || { REASON="the second run does not say it kept hooks.zig"; return 1; }
    grep -qF "Kept $out/b/vscode/identity.json" "$LOG" || { REASON="the second run does not say it kept identity.json"; return 1; }
    [[ $(tail -1 "$out/b/server/src/hooks.zig") == "// changed" ]] || { REASON="the second run replaced a changed hooks.zig"; return 1; }
    echo "// changed" >>"$out/a/server/src/hooks.zig"
    diff -r "$out/a" "$out/b" >>"$LOG" 2>&1 || { REASON="the second run wrote different files"; return 1; }
    return 0
}

# check_editor_server <suite dir> <name>: the server `--editor` writes,
# with the stub hooks.zig, compiles.
check_editor_server() {
    local dir=$1 name=$2 out="$WORK/out/server_$2"
    suite_conf "$dir"
    lang_args
    (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" --editor ${LANG_ARGS[@]+"${LANG_ARGS[@]}"} "$(basename "$GRAMMAR")" "$out") >>"$LOG" 2>&1 ||
        { REASON="--editor failed"; return 1; }
    if ! (cd "$out/server" && with_timeout 600 zig build-exe -fno-emit-bin src/main.zig --cache-dir "$OUTROOT/zig") >>"$LOG" 2>&1; then
        REASON="the server does not compile: $(first_error "$LOG")"
        return 1
    fi
    return 0
}

# check_editor_session <variant dir> <session>: replayed against the
# variant's server (test/lib/lsp), with the suite's project/ as the root,
# the session prints <session>.out.
check_editor_session() {
    local vdir=$1 session=$2 got
    check_built "$vdir" build_server || return 1
    got="$WORK/out/$(key_of "$session").out"
    local server
    server=$(ls "$OUTROOT/build/$(key_of "$vdir")"/server/zig-out/bin/*-lsp)
    with_timeout "$TIMEOUT" python3 "$LIB/lsp" "$server" "$(dirname "$vdir")/project" "$session" >"$got" 2>>"$LOG" </dev/null
    local rc=$?
    if [[ $rc -ne 0 ]]; then
        REASON="the session failed (exit $rc): $(grep -m1 '^!! ' "$got" || tail -1 "$got")"
        tail -20 "$got" >>"$LOG"
        return 1
    fi
    golden "$got" "${session%.session}.out"
}

# check_editor_client <suite dir> <scenario>: the extension `--editor`
# writes (with <scenario>.identity.json as its identity.json, if there is
# one, and then package.json, README.md and .vscodeignore equal to
# <scenario>.package.json, .readme.txt and .vscodeignore), run under Node
# with stubs of VS Code (test/lib/vscode), prints <scenario>.out.
check_editor_client() {
    local dir=$1 scenario=$2 base out rc
    base=${scenario%.js}
    out="$WORK/out/client_$(basename "$base")"
    suite_conf "$dir"
    lang_args
    command -v node >/dev/null || { REASON="node not found"; return 1; }
    mkdir -p "$out/vscode"
    [[ -f $base.identity.json ]] && cp "$base.identity.json" "$out/vscode/identity.json"
    (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" --editor ${LANG_ARGS[@]+"${LANG_ARGS[@]}"} "$(basename "$GRAMMAR")" "$out") >>"$LOG" 2>&1 ||
        { REASON="--editor failed"; return 1; }
    if [[ -f $base.identity.json ]]; then
        golden "$out/vscode/package.json" "$base.package.json" || return 1
        golden "$out/vscode/README.md" "$base.readme.txt" || return 1
        golden "$out/vscode/.vscodeignore" "$base.vscodeignore" || return 1
    fi
    with_timeout "$TIMEOUT" node "$LIB/vscode" client "$out/vscode" "$scenario" >"$out.out" 2>>"$LOG"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        REASON="the scenario failed (exit $rc): $(grep -m1 '^!! ' "$out.out" || tail -1 "$out.out")"
        return 1
    fi
    golden "$out.out" "$base.out"
}

# check_highlight <suite dir> <sample>: the editor files colour the sample
# as <sample>.hl says (test/lib/highlight).
check_highlight() {
    local dir=$1 sample=$2 out
    out="$WORK/out/hl_$(key_of "$sample")"
    suite_conf "$dir"
    if ! command -v vim >/dev/null; then REASON="vim not found"; return 1; fi
    mkdir -p "$out"
    local t
    for t in textmate highlightjs vim; do
        (cd "$(dirname "$GRAMMAR")" && with_timeout "$TIMEOUT" "$NEXUS" --highlight "$t" "$(basename "$GRAMMAR")" "$out/$t") >>"$LOG" 2>&1 ||
            { REASON="--highlight $t failed"; return 1; }
    done
    local args=(docs/GRAMMAR.md "$out/textmate" "$out/highlightjs" "$out/vim" "$sample" "$sample.hl")
    [[ -n "$UPDATE" ]] && args=(--update "${args[@]}")
    local said
    said=$(with_timeout 300 python3 "$LIB/highlight" "${args[@]}" 2>&1)
    local rc=$?
    echo "$said" >>"$LOG"
    if [[ $rc -ne 0 ]]; then REASON=$(grep -m1 . <<<"$said"); return 1; fi
    return 0
}

check_determinism() { # check_determinism <suite dir> <name>: generated with the suite's flags
    local dir=$1 a="$WORK/out/det_$2_a.zig" b="$WORK/out/det_$2_b.zig"
    local sa="$WORK/out/det_$2_a.sexp" sb="$WORK/out/det_$2_b.sexp"
    suite_conf "$dir"
    local gd gn
    gd=$(dirname "$GRAMMAR") gn=$(basename "$GRAMMAR")
    # shellcheck disable=SC2086 # FLAGS: generator options, split on spaces
    (cd "$gd" && with_timeout "$TIMEOUT" "$NEXUS" $FLAGS "$gn" "$a" && with_timeout "$TIMEOUT" "$NEXUS" $FLAGS "$gn" "$b") >>"$LOG" 2>&1
    with_timeout "$TIMEOUT" "$NEXUS" --dump-sexp "$GRAMMAR" "$sa" >>"$LOG" 2>&1
    with_timeout "$TIMEOUT" "$NEXUS" --dump-sexp "$GRAMMAR" "$sb" >>"$LOG" 2>&1
    if [[ ! -s "$a" || ! -s "$b" ]]; then REASON="generation failed"; return 1; fi
    if [[ ! -s "$sa" || ! -s "$sb" ]]; then REASON="--dump-sexp failed"; return 1; fi
    if ! cmp -s "$a" "$b"; then REASON="two generations differ"; return 1; fi
    if ! cmp -s "$sa" "$sb"; then REASON="two --dump-sexp runs differ"; return 1; fi
    (cd "$gd" && with_timeout "$TIMEOUT" "$NEXUS" --describe "$gn" "$a.json" && with_timeout "$TIMEOUT" "$NEXUS" --describe "$gn" "$b.json") >>"$LOG" 2>&1
    if [[ ! -s "$a.json" ]] || ! cmp -s "$a.json" "$b.json"; then REASON="two --describe runs differ"; return 1; fi
    if grep -q '^@highlight' "$GRAMMAR"; then
        local t
        for t in textmate language-configuration highlightjs vim; do
            (cd "$gd" && with_timeout "$TIMEOUT" "$NEXUS" --highlight "$t" "$gn" "$a.$t" && with_timeout "$TIMEOUT" "$NEXUS" --highlight "$t" "$gn" "$b.$t") >>"$LOG" 2>&1
            if [[ ! -s "$a.$t" ]] || ! cmp -s "$a.$t" "$b.$t"; then REASON="two --highlight $t runs differ"; return 1; fi
        done
    fi
    return 0
}

check_bootstrap() {
    local fp=src/frontend/parser.zig tmp="$WORK/out/bootstrap.zig"
    with_timeout "$TIMEOUT" "$NEXUS" nexus.grammar "$tmp" >>"$LOG" 2>&1
    if [[ ! -s "$tmp" ]]; then REASON="regeneration failed"; return 1; fi
    if ! diff "$fp" "$tmp" >"$tmp.diff" 2>&1; then
        REASON="$fp is not a fixed point ($(grep -c '^[<>]' "$tmp.diff") lines drift; regenerate it with bin/nexus nexus.grammar $fp)"
        head -40 "$tmp.diff" >>"$LOG"
        return 1
    fi
    return 0
}

check_unit_lang() { # check_unit_lang <suite dir>: zig test each lang file with tests
    local dir=$1
    check_built "$dir" || return 1
    local out="$OUTROOT/build/$(key_of "$dir")" f
    suite_conf "$dir"
    for f in ${LANG_FILES[@]+"${LANG_FILES[@]}"}; do
        grep -qE '^test "' "$f" || continue
        if ! (cd "$out" && with_timeout 300 zig test "$(basename "$f")" --cache-dir "$OUTROOT/zig") >>"$LOG" 2>&1; then
            REASON="zig test $(basename "$f") failed"
            return 1
        fi
    done
    return 0
}

# check_scopes <suite dir>: the suite's compare-scopes (grammars/zig) finds
# no disagreement on its cases: every name the grammar's @lsp resolves is
# the one the compiler resolves.
check_scopes() {
    local dir=$1 out rc
    out=$(with_timeout 600 "$dir/compare-scopes" -O debug "$dir/cases" 2>&1)
    rc=$?
    echo "$out" >>"$LOG"
    if [[ $rc -ne 0 ]]; then REASON="compare-scopes exited $rc: $(grep -m1 -E 'renamed|unresolved|resolves|error' <<<"$out" || tail -1 <<<"$out")"; return 1; fi
    if ! grep -qE '^disagreements: 0$' <<<"$out"; then REASON="unexpected summary: $(tail -1 <<<"$out")"; return 1; fi
    return 0
}

check_diff_tool() { # test/diff agrees with itself on the MUMPS cases
    local out
    out=$(NO_COLOR=1 with_timeout 300 test/diff -O debug -j 4 --keep "$OUTROOT/diff" "$NEXUS" "$NEXUS" \
        grammars/mumps/mumps.grammar grammars/mumps/mumps.grammar --ext .m grammars/mumps/cases 2>&1)
    local rc=$?
    echo "$out" >>"$LOG"
    if [[ $rc -ne 0 ]]; then REASON="test/diff exited $rc: $(tail -1 <<<"$out")"; return 1; fi
    if ! grep -qE '^[0-9]+ files, [0-9]+ same, 0 differ' <<<"$out"; then REASON="unexpected summary: $(tail -1 <<<"$out")"; return 1; fi
    return 0
}

# check_cli: the command line — --version, --help, usage errors (exit 2),
# unreadable files (exit 1, no stack trace), and `check` (exit status of a
# full generation, nothing written).
check_cli() {
    local out rc want dir=${CLI_DIR:-$WORK/cli}
    want="nexus $(sed -n 's/^pub const version = "\(.*\)";/\1/p' src/version.zig)"
    expect() { # expect <status> <text> <args...>: exit status and output text
        local status=$1 text=$2
        shift 2
        out=$(cd "$dir" && with_timeout "$TIMEOUT" "$NEXUS" "$@" 2>&1 </dev/null)
        rc=$?
        echo "\$ nexus $* → $rc" >>"$LOG"
        echo "$out" >>"$LOG"
        if [[ $rc -ne $status ]]; then REASON="nexus $*: exit $rc, expected $status"; return 1; fi
        if ! grep -qF -- "$text" <<<"$out"; then REASON="nexus $*: output lacks \"$text\""; return 1; fi
        if grep -qE "$PANIC_RE|\.zig:[0-9]+:[0-9]+: 0x" <<<"$out"; then REASON="nexus $*: crash or stack trace"; return 1; fi
        return 0
    }
    mkdir -p "$dir"
    cp test/regress/no_lang/no_lang.grammar test/adverse/list_tail_conflict.grammar test/highlight/highlight.grammar test/cli/*.grammar test/cli/*.zig "$dir/"
    expect 0 "$want" --version || return 1
    # The progress output names an alternative that makes 32 rules or more.
    expect 0 "Expanded: rule 'item' (line 15): one alternative makes 32 rules" check wide.grammar || return 1
    if (cd "$dir" && "$NEXUS" check narrow.grammar 2>&1) | grep -q "Expanded:"; then REASON="check narrow.grammar names an alternative of 16 rules"; return 1; fi
    expect 0 "$want" -V || return 1
    [[ $(cd "$dir" && "$NEXUS" --version 2>/dev/null) == "$want" ]] || { REASON="--version does not print \"$want\" on stdout"; return 1; }
    expect 0 "Usage: nexus" --help || return 1
    (cd "$dir" && "$NEXUS" -h 2>/dev/null | grep -q "Usage: nexus") || { REASON="-h does not print the help on stdout"; return 1; }
    expect 2 "no grammar file given" || return 1
    expect 2 "unknown option '--bogus'" --bogus no_lang.grammar || return 1
    expect 2 "unexpected argument 'c'" a b c || return 1
    expect 1 "error: cannot read missing.grammar" missing.grammar out.zig || return 1
    expect 2 "no output file given" no_lang.grammar || return 1
    expect 2 "the output file './no_lang.grammar' is the grammar file" no_lang.grammar ./no_lang.grammar || return 1
    expect 2 "the output file 'no_lang.grammar' is the grammar file" --dump-sexp no_lang.grammar no_lang.grammar || return 1
    cmp -s test/regress/no_lang/no_lang.grammar "$dir/no_lang.grammar" || { REASON="the grammar file was overwritten"; return 1; }
    expect 1 "error: cannot write missing/out.zig" no_lang.grammar missing/out.zig || return 1
    expect 0 "no errors" check no_lang.grammar || return 1
    expect 2 "\`nexus check\` writes nothing; unexpected 'out.zig'" check no_lang.grammar out.zig || return 1
    expect 2 "--highlight needs a target" --highlight || return 1
    expect 2 "unknown --highlight target 'bogus'" --highlight bogus no_lang.grammar || return 1
    expect 1 "no_lang.grammar:1:1: error: the grammar has no @highlight, so it has no editor files" --highlight vim no_lang.grammar || return 1
    expect 2 "--spans has no effect on --describe" --describe --spans no_lang.grammar || return 1
    expect 2 "--describe and --dump-sexp are separate commands" --describe --dump-sexp no_lang.grammar || return 1
    expect 2 "--highlight and check are separate commands" check --highlight vim no_lang.grammar || return 1
    expect 2 "--highlight all writes a directory: nexus --highlight all" --highlight all highlight.grammar || return 1
    expect 2 "--highlight all writes a directory, not standard output" --highlight all highlight.grammar - || return 1
    expect 2 "the output file 'highlight.grammar' is the grammar file" --describe highlight.grammar highlight.grammar || return 1
    expect 1 "error: cannot create no_lang.grammar/sub" --highlight all highlight.grammar no_lang.grammar/sub || return 1
    expect 2 "--editor writes a directory: nexus --editor" --editor highlight.grammar || return 1
    expect 2 "--editor writes a directory, not standard output" --editor highlight.grammar - || return 1
    expect 2 "--spans has no effect on --editor" --editor --spans highlight.grammar ed || return 1
    expect 2 "--lang needs the lang module's file" --editor --lang || return 1
    expect 2 "--lang is an option of --editor" --lang pal.zig pal.grammar out.zig || return 1
    expect 2 "--messages is an option of check" --messages no_lang.grammar out.zig || return 1
    expect 0 "0 of 0 places have a message" check --messages lexer_only.grammar || return 1
    expect 1 "no_lang.grammar:1:1: error: the grammar has no @highlight, so it has no editor files" --editor no_lang.grammar ed || return 1
    expect 1 "lexer_only.grammar:1:1: error: the grammar has no parser rules, so it has no language server" --editor lexer_only.grammar ed || return 1
    expect 2 "the grammar has @lang = \"pal\": give its lang module with --lang <file>" --editor pal.grammar ed || return 1
    expect 2 "--lang pal.zig: the grammar has no @lang" --editor --lang pal.zig highlight.grammar ed || return 1
    expect 1 "error: cannot copy missing.zig into the server: it cannot be read" --editor --lang missing.zig pal.grammar ed || return 1
    expect 1 "error: cannot copy ../outside.zig into the server" --editor --lang escape.zig pal.grammar ed || return 1
    expect 1 "error: the server has its own hooks.zig; the lang module clash.zig cannot bring one" --editor --lang clash.zig pal.grammar ed || return 1
    expect 1 "error: cannot create no_lang.grammar/sub" --editor highlight.grammar no_lang.grammar/sub || return 1
    if [[ -n $(cd "$dir" && ls | grep -vE '\.(grammar|zig)$') ]]; then REASON="a refused or failed run, or check, wrote a file"; return 1; fi
    # With @lang, the lang module is copied as <name>.zig, with the files
    # it imports.
    expect 0 "Wrote ed/server/src/names.zig" --editor --lang pal.zig pal.grammar ed || return 1
    cmp -s test/cli/pal.zig "$dir/ed/server/src/pal.zig" && cmp -s test/cli/names.zig "$dir/ed/server/src/names.zig" || { REASON="--editor --lang did not copy the lang module and its import"; return 1; }
    rm -rf "$dir/ed"
    # A mistake in the extension's identity.json is a located error, and
    # the run writes nothing.
    identity() { # identity <json> <located error>
        rm -rf "$dir/id" && mkdir -p "$dir/id/vscode" && printf '%s\n' "$1" >"$dir/id/vscode/identity.json"
        expect 1 "id/vscode/identity.json:$2" --editor highlight.grammar id || return 1
        [[ $(cd "$dir/id" && find . -type f) == ./vscode/identity.json ]] || { REASON="a refused identity.json left files: $1"; return 1; }
    }
    identity '{"name": "x", "bogus": "y"}' '1:15: error: unknown key "bogus"; the keys are name, displayName, description, publisher, version, license, repository, settings, mode' || return 1
    identity '["name"]' '1:1: error: the identity is not a JSON object of strings' || return 1
    identity '{"name": "x",' '2:1: error: the identity is not valid JSON' || return 1
    identity '{"name": "x"} {}' '1:15: error: the identity is not valid JSON' || return 1
    identity '{"mode": "companion",
  "mode": "standalone"}' '2:3: error: "mode" is given twice' || return 1
    identity '{"version": 1}' '1:13: error: the value of "version" is not a string' || return 1
    identity '{"name": "Lamp"}' "1:10: error: \"name\": \"Lamp\" is not valid: it must be lowercase letters, digits and '-', starting with a letter or digit" || return 1
    identity '{"publisher": "-me"}' "1:15: error: \"publisher\": \"-me\" is not valid: it must be letters, digits and '-', starting with a letter or digit" || return 1
    identity '{"displayName": ""}' '1:17: error: "displayName": "" is not valid: it must not be empty' || return 1
    identity '{"license": ""}' '1:13: error: "license": "" is not valid: it must not be empty' || return 1
    identity '{"version": "1.0"}' '1:13: error: "version": "1.0" is not valid: it must be three numbers joined by dots, such as 0.1.0' || return 1
    identity '{"settings": "lamp..x"}' "1:14: error: \"settings\": \"lamp..x\" is not valid: it must be names of letters, digits, '_' and '-', joined by dots" || return 1
    identity '{"mode": "solo"}' '1:10: error: "mode": "solo" is not valid: it must be standalone or companion' || return 1
    rm -rf "$dir/id" && mkdir -p "$dir/id/vscode/identity.json"
    expect 1 "error: cannot read id/vscode/identity.json" --editor highlight.grammar id || return 1
    rm -rf "$dir/id"
    expect 0 '"format": 1' --describe no_lang.grammar || return 1
    expect 0 "Wrote the description to d.json" --describe no_lang.grammar d.json || return 1
    expect 0 "Wrote the vim file to h.vim" --highlight vim highlight.grammar h.vim || return 1
    expect 0 "Wrote editors/vim/syntax/lamp.vim" --highlight all highlight.grammar editors || return 1
    [[ -s $dir/d.json && -s $dir/h.vim && -s $dir/editors/highlightjs/lamp.js ]] || { REASON="--describe or --highlight wrote no file"; return 1; }
    rm -rf "$dir/d.json" "$dir/h.vim" "$dir/editors"
    out=$(cd "$dir" && "$NEXUS" no_lang.grammar - 2>/dev/null)
    [[ $out == "//! Generated by nexus"* && ! -e "$dir/-" ]] || { REASON="output file - does not write the module to stdout"; return 1; }
    expect 1 "undeclared conflict" check list_tail_conflict.grammar || return 1
    expect 0 "Generated: out.zig" --spans no_lang.grammar out.zig || return 1
    grep -q "pub const nodeStore = true" "$dir/out.zig" || { REASON="--spans did not turn on the node store"; return 1; }
    expect 0 "Lexer: 6 tokens, 5 rules, 6 DFA states" no_lang.grammar out.zig || return 1
    expect 0 "(section \`lexer\`)" --dump-sexp no_lang.grammar || return 1
    expect 2 "--dump-sexp and check are separate commands" check --dump-sexp no_lang.grammar || return 1
    expect 2 "--spans has no effect on --dump-sexp" --dump-sexp --spans no_lang.grammar || return 1
    expect 0 "Generated: /dev/null" no_lang.grammar /dev/null || return 1
    # Through a symlink, the file it names is replaced, and keeps its mode.
    (cd "$dir" && mkdir sub && echo old >sub/real.zig && chmod 600 sub/real.zig && ln -s sub/real.zig link.zig)
    expect 0 "Generated: link.zig" no_lang.grammar link.zig || return 1
    [[ -L $dir/link.zig && $(head -1 "$dir/sub/real.zig") == "//! Generated by nexus"* ]] || { REASON="output through a symlink did not replace the file it names"; return 1; }
    [[ $(ls -l "$dir/sub/real.zig" | cut -c1-10) == -rw------- ]] || { REASON="the replaced output file lost its mode"; return 1; }
    out=$(cd "$dir" && "$NEXUS" --help 2>&1 >&-)
    rc=$?
    echo "\$ nexus --help >&- → $rc" >>"$LOG"
    echo "$out" >>"$LOG"
    if [[ $rc -ne 1 ]] || ! grep -qF "cannot write standard output" <<<"$out" || grep -qE "$PANIC_RE|\.zig:[0-9]+:[0-9]+: 0x" <<<"$out"; then
        REASON="nexus --help with stdout closed: exit $rc, expected 1 with \"cannot write standard output\" and no trace"
        return 1
    fi
    return 0
}

# check_fmt: the `zig fmt --check` command of AGENTS.md passes (it is read
# from there, so the documented command is the one tested).
check_fmt() {
    local cmd out rc
    cmd=$(grep -m1 '^zig fmt --check ' AGENTS.md)
    if [[ -z "$cmd" ]]; then REASON="AGENTS.md has no zig fmt --check command"; return 1; fi
    out=$(eval "with_timeout $TIMEOUT $cmd" 2>&1)
    rc=$?
    printf '$ %s\n%s\n' "$cmd" "$out" >>"$LOG"
    if [[ $rc -ne 0 ]]; then REASON="zig fmt --check: $(head -1 <<<"$out")"; return 1; fi
    return 0
}

# check_lexfuzz: generated lexers agree with test/lexfuzz/fuzz.py's
# reference matcher on a fixed seed (a small run; larger ones are manual).
check_lexfuzz() {
    local fuzz=test/lexfuzz/fuzz.py args=(--seed 1 --specs 12 --inputs 100 -O debug --keep "$WORK/out/lexfuzz")
    if ! command -v python3 >/dev/null; then REASON="python3 not found"; return 1; fi
    if ! with_timeout 300 python3 "$fuzz" "${args[@]}" >>"$LOG" 2>&1 </dev/null; then
        REASON="$(grep -m1 -E 'MISMATCH|unexpected|error' "$LOG" || tail -1 "$LOG")"
        return 1
    fi
    return 0
}

# check_messages: every error and warning format in src/ is printed by
# `nexus check` on some test grammar or by the tools/cli commands, unless
# test/lib/messages.allow lists it (test/lib/messages).
check_messages() {
    local corpus="$WORK/out/messages.txt" srcs=() f
    {
        find grammars test "$DOCS_OUT" -name '*.grammar' ! -path 'test/golden/*'
        echo nexus.grammar
    } | LC_ALL=C sort | tr '\n' '\0' | with_timeout 300 xargs -0 -r -n 1 "$NEXUS" check >"$corpus" 2>&1
    (CLI_DIR="$WORK/out/messages-cli" LOG="$corpus.cli" check_cli) >/dev/null 2>&1
    cat "$corpus.cli" >>"$corpus"
    while IFS= read -r f; do srcs+=("$f"); done < <(
        find src -name '*.zig' ! -path src/frontend/parser.zig ! -path src/codegen/runtime_template.zig ! -path src/lr/tests.zig | LC_ALL=C sort
    )
    local out rc
    out=$("$LIB/messages" test/lib/messages.allow "$corpus" "${srcs[@]}" 2>>"$LOG")
    rc=$?
    echo "$out" >>"$LOG"
    if [[ $rc -ne 0 ]]; then REASON="$(wc -l <<<"$out" | tr -d ' ') problems; first: $(head -1 <<<"$out")"; return 1; fi
    return 0
}

# check_readme: docs/index.html shows README.md's tested example, and the
# README's validated-languages table matches the grammars (test/lib/readme).
check_readme() {
    local out rc
    out=$(with_timeout 300 "$LIB/readme" "$NEXUS" 2>&1)
    rc=$?
    echo "$out" >>"$LOG"
    if [[ $rc -ne 0 ]]; then REASON="$(head -1 <<<"$out")"; return 1; fi
    return 0
}

check_doc_fragment() { # check_doc_fragment <file>: a doc's grammar fragment parses
    local out rc
    out=$(with_timeout "$TIMEOUT" "$NEXUS" --dump-sexp "$1" "$WORK/out/$(key_of "$1").sexp" 2>&1 </dev/null)
    rc=$?
    echo "$out" >>"$LOG"
    if [[ $rc -ne 0 ]]; then REASON="does not parse: $(grep -m1 'error:' <<<"$out" | sed 's/^.*error: //')"; return 1; fi
    return 0
}

check_unit_nexus() {
    if ! with_timeout 600 zig build unit >>"$LOG" 2>&1; then REASON="zig build unit failed"; return 1; fi
    return 0
}

# -----------------------------------------------------------------------------
# Worker: one task line → one result file "<status>\t<id>\t<reason>".
# status: pass | fail | known | fixed
# -----------------------------------------------------------------------------

worker() {
    local id=$1 kind=$2 a=${3:-} b=${4:-} c=${5:-}
    local res="$RESULTS/${id//\//__}"
    LOG="$res.log"
    REASON=""
    : >"$LOG"
    local ok
    case $kind in
        case)        check_case "$a" "$b" "$c" "${6:-}" "$( [[ "$id" == */known/* ]] && echo 0 || echo 1)"; ok=$? ;;
        bug)         check_bug_suite "$a"; ok=$? ;;
        adverse)     check_rejects "$a"; ok=$? ;;
        gen)         check_golden_gen "$a" "$b"; ok=$? ;;
        sexp)        check_sexp "$a" "$b"; ok=$? ;;
        determinism) check_determinism "$a" "$b"; ok=$? ;;
        describe)    check_describe "$a" "$b"; ok=$? ;;
        coverage)    check_coverage "$a" "$b"; ok=$? ;;
        hl-all)      check_highlight_all "$a" "$b"; ok=$? ;;
        hl)          check_highlight "$a" "$b"; ok=$? ;;
        editor-files)  check_editor_files "$a" "$b"; ok=$? ;;
        editor-server) check_editor_server "$a" "$b"; ok=$? ;;
        session)     check_editor_session "$a" "$b"; ok=$? ;;
        client)      check_editor_client "$a" "$b"; ok=$? ;;
        bootstrap)   check_bootstrap; ok=$? ;;
        unit-lang)   check_unit_lang "$a"; ok=$? ;;
        wasm32)      check_wasm32 "$a"; ok=$? ;;
        unit-nexus)  check_unit_nexus; ok=$? ;;
        diff-tool)   check_diff_tool; ok=$? ;;
        scopes)      check_scopes "$a"; ok=$? ;;
        cli)         check_cli; ok=$? ;;
        doc-frag)    check_doc_fragment "$a"; ok=$? ;;
        fmt)         check_fmt; ok=$? ;;
        lexfuzz)     check_lexfuzz; ok=$? ;;
        messages)    check_messages; ok=$? ;;
        readme)      check_readme; ok=$? ;;
        bad)         REASON=$a; ok=1 ;;
        *)           REASON="unknown task kind $kind"; ok=1 ;;
    esac
    if [[ "$id" == known/* || "$id" == */known/* ]]; then
        if [[ $ok -eq 0 ]]; then
            local how
            case $id in
                known/*) how="git mv test/$id test/regress/" ;;
                adverse/known/*) how="git mv test/$id.grammar test/adverse/" ;;
                *) local d=grammars/${id%%/*}; [[ -d $d ]] || d=test/${id%%/*}
                   how="move $d/known/${id#*/known/}.* (input and .tree) to $d/cases/" ;;
            esac
            printf 'fixed\t%s\tpasses: %s\n' "$id" "$how" >"$res"
        else
            printf 'known\t%s\t%s\n' "$id" "$REASON" >"$res"
        fi
    elif [[ $ok -eq 0 ]]; then
        printf 'pass\t%s\t\n' "$id" >"$res"
    else
        printf 'fail\t%s\t%s\n' "$id" "$REASON" >"$res"
    fi
}

# --worker <tasks>: tasks separated by \x1e, each with its fields
# separated by \x1f.
if [[ "${1:-}" == "--worker" ]]; then
    IFS=$'\x1e' read -r -a TASKS <<<"$2"
    for task in "${TASKS[@]}"; do
        [[ -n "$task" ]] || continue
        IFS=$'\x1f' read -r -a F <<<"$task"
        case ${F[1]} in
            build) ensure_built "${F[2]}" ;;
            build-server) ensure_built "${F[2]}" build_server ;;
            *) (worker "${F[@]}") ;;
        esac
    done
    exit 0
fi

# -----------------------------------------------------------------------------
# Driver
# -----------------------------------------------------------------------------

UPDATE="" VERBOSE="" JOBS=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
FILTERS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --update) UPDATE=1 ;;
        -v) VERBOSE=1 ;;
        -j) JOBS=$2; shift ;;
        -h|--help) awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
        -*) echo "unknown option $1" >&2; exit 2 ;;
        *) FILTERS+=("$1") ;;
    esac
    shift
done

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    G=$'\033[32m' R=$'\033[31m' Y=$'\033[33m' D=$'\033[2m' B=$'\033[1m' X=$'\033[0m'
else
    G='' R='' Y='' D='' B='' X=''
fi

# One run per checkout at a time: runs share bin/nexus and the build and
# doc directories under .zig-cache/nexus-test. The lock is a symlink to
# the holder's pid: `ln -s` makes it, pid included, in one step, and fails
# when it exists. A lock whose holder is gone is removed (only if it still
# names that pid) and taken again.
mkdir -p "$OUTROOT"
LOCK="$OUTROOT/run.pid"
until ln -s "$$" "$LOCK" 2>/dev/null; do
    pid=$(readlink "$LOCK") || { [[ -e $LOCK ]] && { printf '%s%s is not a test/run lock%s\n' "$R" "$LOCK" "$X"; exit 2; }; continue; }
    if kill -0 "$pid" 2>/dev/null; then
        printf '%sanother test/run (pid %s) is running in this checkout%s\n' "$R" "$pid" "$X"
        exit 2
    fi
    [[ $(readlink "$LOCK") == "$pid" ]] && rm -f "$LOCK"
done
trap 'rm -f "$LOCK"' EXIT

START_T=$SECONDS
printf '%sbuilding nexus%s\n' "$D" "$X"
if ! zig build 2>&1; then
    printf '%sbuild failed%s\n' "$R" "$X"
    exit 1
fi

WORK=$(mktemp -d "${TMPDIR:-/tmp}/nexus-test.XXXXXX")
RESULTS="$WORK/results"
mkdir -p "$RESULTS" "$WORK/build" "$WORK/lock" "$WORK/out" "$OUTROOT/build"
trap 'rm -rf "$WORK"; rm -f "$LOCK"' EXIT
export ROOT NEXUS LIB OUTROOT DOCS_OUT PANIC_RE POS_RE TIMEOUT WORK RESULTS UPDATE

selected() {
    [[ ${#FILTERS[@]} -eq 0 ]] && return 0
    local f
    for f in "${FILTERS[@]}"; do [[ "$1" == *"$f"* ]] && return 0; done
    return 1
}

# One pool runs everything, in this order: the long tests, so that none of
# them is left running alone at the end; the suite builds (pseudo-tasks
# with no result); the tests that need no build, while the builds finish;
# and the tests that need one, four to a worker process. A test whose suite
# is not built yet builds it, or waits for the worker that is building it.
LONG="$WORK/long" BUILDS="$WORK/builds" EARLY="$WORK/early" LATE="$WORK/late"
: >"$LONG"
: >"$BUILDS"
: >"$EARLY"
: >"$LATE"
add() { # add <id> <kind> [args...]
    selected "$1" || return 1
    local IFS=$'\x1f' to=$EARLY
    case $2 in
        unit-nexus|unit-lang|diff-tool|lexfuzz|messages|editor-server|scopes) to=$LONG ;;
        case|bug|hl|session) to=$LATE ;;
    esac
    printf '%s\n' "$*" >>"$to"
}
need_build() { # need_build <dir> [build-server]
    local line
    line="build/$1"$'\x1f'"${2:-build}"$'\x1f'"$1"
    grep -qxF "$line" "$BUILDS" || echo "$line" >>"$BUILDS"
}

# Grammar suites: grammars/<name>/, the real languages, and test/<name>/
# with a grammar (test/known/ is separate).
SEXP_SEEN=""
for dir in grammars/*/ test/*/; do
    dir=${dir%/}
    name=$(basename "$dir")
    case $name in golden|adverse|known|regress|lib|bench|lexfuzz|cli) continue ;; esac
    suite_conf "$dir"
    if [[ -n "$CONF_ERROR" || -z "$GRAMMAR" ]]; then add "$name" bad "${CONF_ERROR:-$dir holds no grammar}"; continue; fi
    for sub in cases known; do
        while IFS=$'\x1f' read -r file start tree; do
            rel=${file#"$dir/$sub/"}
            id="$name/$( [[ $sub == known ]] && echo known/)${rel%.*}"
            add "$id" case "$dir" "$file" "$start" "$tree" && need_build "$dir"
        done < <(list_cases "$dir/$sub")
    done
    # Goldens: the generated parser of every suite (the nexus suite's is
    # src/frontend/parser.zig, which bootstrap checks), and the frontend
    # tree of every grammar file, once, under the first suite that uses it.
    [[ $name != nexus ]] && add "gen/$name" gen "$dir" "$name"
    # The --describe golden of every grammar file, once; the editor files
    # of one with @highlight, and the colouring of its samples.
    case $SEXP_SEEN in *"|$GRAMMAR|"*) ;; *)
        add "sexp/$name" sexp "$dir" "$name"
        add "describe/$name" describe "$dir" "$name"
        grep -q '^@messages' "$GRAMMAR" && add "messages/$name" coverage "$dir" "$name"
        if grep -q '^@highlight' "$GRAMMAR"; then
            add "highlight/$name/files" hl-all "$dir" "$name"
            add "editor/$name/files" editor-files "$dir" "$name"
            add "editor/$name/server" editor-server "$dir" "$name"
        fi
        ;;
    esac
    # Language-server sessions: each subdirectory holding *.session files
    # is a server, built with its hooks.zig (or the stub).
    for sub in "$dir"/*/; do
        sub=${sub%/}
        for f in "$sub"/*.session; do
            [[ -f $f ]] || continue
            rel=$(basename "$f")
            add "$name/$(basename "$sub")/${rel%.session}" session "$sub" "$f" && need_build "$sub" build-server
        done
    done
    # The VS Code client: each scenario of client/, run under Node.
    for f in "$dir"/client/*.js; do
        [[ -f $f ]] || continue
        rel=$(basename "$f")
        add "$name/client/${rel%.js}" client "$dir" "$f"
    done
    SEXP_SEEN="$SEXP_SEEN|$GRAMMAR|"
    for f in "$dir"/highlight/*; do
        [[ -f $f && $f != *.hl ]] || continue
        rel=$(basename "$f")
        add "highlight/$name/${rel%.*}" hl "$dir" "$f"
    done
    add "determinism/$name" determinism "$dir" "$name"
    [[ -x $dir/compare-scopes ]] && add "$name/scopes" scopes "$dir"
    add "wasm32/$name" wasm32 "$dir" && need_build "$dir"
    if grep -qE '^test "' ${LANG_FILES[@]+"${LANG_FILES[@]}"} /dev/null 2>/dev/null; then
        add "unit/$name" unit-lang "$dir" && need_build "$dir"
    fi
done

# Bug tests: test/known/<name>/ (failing) and test/regress/<name>/
# (fixed; they stay as regression tests).
for dir in test/known/*/ test/regress/*/; do
    dir=${dir%/}
    [[ -d "$dir" ]] || continue
    id="$(basename "$(dirname "$dir")")/$(basename "$dir")"
    selected "$id" || continue
    suite_conf "$dir"
    if [[ -n "$CONF_ERROR" || -z "$GRAMMAR" ]]; then add "$id" bad "${CONF_ERROR:-$dir holds no grammar}"; continue; fi
    add "$id" bug "$dir"
    grep -qE '^# error:' "$GRAMMAR" || need_build "$dir"
done

for g in test/adverse/*.grammar test/adverse/known/*.grammar; do
    [[ -e "$g" ]] || continue
    rel=${g#test/adverse/}
    add "adverse/${rel%.grammar}" adverse "$g"
done

add bootstrap bootstrap
add unit/nexus unit-nexus
add tools/diff diff-tool
add tools/cli cli
add tools/fmt fmt
add tools/lexfuzz lexfuzz
add tools/messages messages
add tools/readme readme

# Doc tests: the examples of the Markdown docs, extracted into suites
# (test/lib/doctest; see test/README.md).
# Every Markdown file git tracks (every one in the tree, outside a git
# checkout).
DOC_FILES=()
while IFS= read -r f; do DOC_FILES+=("$f"); done < <(
    git ls-files '*.md' 2>/dev/null ||
        find . -name '*.md' ! -path './.zig-cache/*' ! -path './.git/*' | sed 's|^\./||' | LC_ALL=C sort
)
if ! "$LIB/doctest" "$DOCS_OUT" "${DOC_FILES[@]}" >"$WORK/docs.tasks"; then
    printf '%sdoc extraction failed%s\n' "$R" "$X"
    exit 1
fi
while IFS=$'\t' read -r kind id arg; do
    case $kind in
        suite)
            for f in "$arg"/highlight/*; do
                [[ -f $f && $f != *.hl ]] || continue
                rel=$(basename "$f")
                add "$id/highlight/${rel%.*}" hl "$arg" "$f"
            done
            add "$id" bug "$arg" || continue
            suite_conf "$arg"
            grep -qE '^# error:' "$GRAMMAR" || need_build "$arg" ;;
        ztest) add "$id" unit-lang "$arg" && need_build "$arg" ;;
        frag) add "$id" doc-frag "$arg" ;;
        bad) add "$id" bad "$arg" ;;
    esac
done <"$WORK/docs.tasks"

LIST="$WORK/list"
cat "$LONG" "$EARLY" "$LATE" >"$LIST"
TOTAL=$(wc -l <"$LIST" | tr -d ' ')
if [[ $TOTAL -eq 0 ]]; then
    printf '%sno test id contains %s%s\n' "$R" "${FILTERS[*]}" "$X"
    exit 2
fi
NB=$(wc -l <"$BUILDS" | tr -d ' ')
printf '%sbuilding %s grammars, running %s tests (-j %s)%s\n' "$D" "$NB" "$TOTAL" "$JOBS" "$X"

{
    cat "$LONG" "$BUILDS"
    cat "$EARLY" "$LATE" | paste -d $'\x1e' - - - -
} | tr '\n' '\0' | xargs -0 -r -n 1 -P "$JOBS" "$0" --worker

# -----------------------------------------------------------------------------
# Report
# -----------------------------------------------------------------------------

ALL="$WORK/all"
cat "$RESULTS"/* 2>/dev/null | grep -E '^(pass|fail|known|fixed)'$'\t' | sort -t$'\t' -k2 >"$ALL"

show_log() {
    local log="$RESULTS/${1//\//__}.log"
    [[ -s "$log" ]] && head -40 "$log" | sed 's/^/        /'
}

if [[ -n "$VERBOSE" ]]; then
    while IFS=$'\t' read -r st id why; do
        case $st in
            pass)  printf '  %spass%s   %s\n' "$G" "$X" "$id" ;;
            known) printf '  %sknown%s  %s %s— %s%s\n' "$Y" "$X" "$id" "$D" "$why" "$X" ;;
        esac
    done <"$ALL"
fi

FAILED=0
while IFS=$'\t' read -r st id why; do
    case $st in
        fail)
            FAILED=1
            printf '\n  %sFAIL%s   %s — %s\n' "$R" "$X" "$id" "$why"
            show_log "$id" ;;
        fixed)
            FAILED=1
            printf '\n  %sFIXED%s  %s — %s\n' "$Y" "$X" "$id" "$why" ;;
    esac
done <"$ALL"

# Per-group table: the grammar for cases, else the check kind.
printf '\n%s%-16s %6s %6s %6s%s\n' "$B" "group" "pass" "fail" "known" "$X"
awk -F'\t' '
    {
        split($2, p, "/")
        key = p[1]
        if ($1 == "pass") pass[key]++
        else if ($1 == "known") known[key]++
        else fail[key]++
        keys[key] = 1
    }
    END { for (k in keys) printf "%-16s %6d %6d %6d\n", k, pass[k], fail[k], known[k] }
' "$ALL" | sort

PASS=$(grep -c '^pass' "$ALL")
FAIL=$(grep -cE '^(fail|fixed)' "$ALL")
KNOWN=$(grep -c '^known' "$ALL")
MISSING=$((TOTAL - PASS - FAIL - KNOWN))
if [[ $MISSING -gt 0 ]]; then
    FAILED=1
    FAIL=$((FAIL + MISSING))
    printf '\n  %sFAIL%s   %d tests produced no result (worker crashed?)\n' "$R" "$X" "$MISSING"
fi
ELAPSED=$((SECONDS - START_T))
if [[ $FAILED -eq 0 ]]; then
    printf '\n%s%d passed%s, 0 failed, %s%d known%s  %s(%ds)%s\n' "$G" "$PASS" "$X" "$Y" "$KNOWN" "$X" "$D" "$ELAPSED" "$X"
else
    printf '\n%d passed, %s%d failed%s, %s%d known%s  %s(%ds)%s\n' "$PASS" "$R" "$FAIL" "$X" "$Y" "$KNOWN" "$X" "$D" "$ELAPSED" "$X"
    exit 1
fi
