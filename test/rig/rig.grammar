# ==============================================================================
# rig.grammar — Rig lexer and parser grammar
# ==============================================================================
#
# Processed by Nexus into src/parser.zig (`zig build parser`).
#
# The generated BaseLexer only splits the source into raw tokens. The lexer
# rewriter in src/rig.zig then:
#
#   * turns indentation into INDENT / OUTDENT / NEWLINE, and joins lines
#     inside ( ) and [ ] (a newline there is plain whitespace), except in
#     a closure body that starts below its bar list, which is laid out in
#     blocks as anywhere else;
#   * classifies keywords (every keyword is reserved);
#   * classifies the characters whose meaning depends on spacing. The rule
#     is the same for all of them: a character that touches its operand and
#     not the preceding value is a prefix; otherwise it is an infix
#     operator or a suffix.
#
#       <x +x ?x !x *x ~x @x -x      ownership sigils / negation
#       |+a, b|  ||  *|a|            closure bar list (vs bitwise `|`)
#       f(x) a[i]                    call / index (vs `f (x)`, `f [1, 2]`,
#                                    which pass a new operand to `f`)
#       .red                         enum literal (vs member access a.b)
#       T? T! x!                     type / propagation suffixes
#       a if c else b                ternary vs postfix guard `stmt if c`
#
# The grammar has no LALR conflicts; see docs/INTERNALS.md (Conflicts policy).
# ==============================================================================

@lang = "rig"

@lexer

tokens
    # Literals
    ident           # identifier
    integer         # 0, 42, 0xff, 0b1010, 0o17
    real            # 3.14, .5, 1.0e10, 2e-3
    string_sq       # 'single'
    string_dq       # "double"

    # Keywords (classified by the rewriter; every keyword is reserved)
    true
    false
    and
    as
    break
    catch
    continue
    defer
    drop
    else
    enum
    errdefer
    error
    extern
    for
    fun
    if
    in
    match
    new             # a keyword only at statement start (`new x = ...`)
    not
    or
    pre
    pub
    raw
    return
    struct
    sub
    test
    try
    type
    use
    while
    zig

    # Operators
    plus            # +
    minus           # -  infix
    minus_prefix    # -x negation
    star            # *
    slash           # /
    percent         # %
    power           # ** (not a Rig operator; lexed so it can be rejected)
    eq              # ==
    ne              # !=
    lt              # <
    gt              # >
    le              # <=
    ge              # >=
    and_sym         # && (not a Rig operator; the rewriter rejects it)
    or_sym          # || (not a Rig operator; the rewriter rejects it)
    not_sym         # !
    question        # ?
    nullish         # ??
    bar             # |  bitwise or
    ampersand       # &
    caret           # ^
    tilde           # ~
    lshift          # <<
    rshift          # >>
    at              # @
    assign          # =
    fixed_assign    # =!
    move_assign     # <-
    plus_assign     # +=
    minus_assign    # -=
    star_assign     # *=
    slash_assign    # /=
    percent_assign  # %=
    amp_assign      # &=
    bar_assign      # |=
    caret_assign    # ^=
    lshift_assign   # <<=
    rshift_assign   # >>=

    # Punctuation
    lparen          # (  grouping, parameter list, or a new operand
    rparen          # )
    lbrace          # {  (not used by Rig)
    rbrace          # }  (not used by Rig)
    lbracket        # [  array literal or slice/array type
    rbracket        # ]
    comma           # ,
    colon           # :
    arrow           # ->
    fat_arrow       # =>
    dot             # .  member access
    dotdot          # ..

    # Layout (produced by the rewriter)
    indent
    outdent
    newline

    # Rewriter-classified tokens
    lparen_call     # (  touching the preceding value: call / generic args
    lbracket_index  # [  touching the preceding value: index
    post_if         # if  postfix guard: `stmt if cond`
    ternary_if      # if  inline ternary: `a if cond else b`
    bar_capture     # |   closure bar list delimiter: `|+a, b|`
    bar_empty       # ||  an empty closure bar list: `|| print(1)`
    dot_lit         # .   enum literal: `.red`
    kwarg_name      # name directly followed by `:` inside ( )
    move_pfx        # <x  move
    clone_pfx       # +x  clone
    pin_pfx         # @x  pin (reserved)
    read_pfx        # ?x  read borrow, ?T read-borrowed type
    write_pfx       # !x  write borrow, !T write-borrowed type
    share_pfx       # *x  share, *T shared type
    drop_stmt       # -x  drop, as a whole statement
    suffix_q        # T?  optional type
    suffix_bang     # T!  fallible type, x! propagate failure

    # Misc
    comment
    eof
    err

# ==============================================================================
# LEXER RULES
# ==============================================================================

'#' [^\n]*                                  → comment

"\\\n"                                      → skip         # line continuation
"\r\n"                                      → newline
'\n'                                        → newline
'\r'                                        → newline

'"' ([^"\\$\n] | '\\' . | '$')* '"'         → string_dq
"'" ([^'\n] | "''")* "'"                    → string_sq

'0' [xX] [0-9a-fA-F]+                       → integer
'0' [bB] [01]+                              → integer
'0' [oO] [0-7]+                             → integer
[0-9]* '.' [0-9]+ ([Ee] [+-]? [0-9]+)?      → real
[0-9]+ [Ee] [+-]? [0-9]+                    → real
[0-9]+                                      → integer

"<<="                                       → lshift_assign
">>="                                       → rshift_assign
"**"                                        → power
"=="                                        → eq
"!="                                        → ne
"<="                                        → le
">="                                        → ge
"&&"                                        → and_sym
"||"                                        → or_sym
"=!"                                        → fixed_assign
"<-"                                        → move_assign
"+="                                        → plus_assign
"-="                                        → minus_assign
"*="                                        → star_assign
"/="                                        → slash_assign
"%="                                        → percent_assign
"&="                                        → amp_assign
"|="                                        → bar_assign
"^="                                        → caret_assign
"->"                                        → arrow
"=>"                                        → fat_arrow
"??"                                        → nullish
".."                                        → dotdot
"<<"                                        → lshift
">>"                                        → rshift

'+'                                         → plus
'-'                                         → minus
'*'                                         → star
'/'                                         → slash
'%'                                         → percent
'<'                                         → lt
'>'                                         → gt
'!'                                         → not_sym
'?'                                         → question
'|'                                         → bar
'&'                                         → ampersand
'^'                                         → caret
'~'                                         → tilde
'@'                                         → at
'='                                         → assign
'('                                         → lparen
')'                                         → rparen
'{'                                         → lbrace
'}'                                         → rbrace
'['                                         → lbracket
']'                                         → rbracket
','                                         → comma
':'                                         → colon
'.'                                         → dot

[a-zA-Z_][a-zA-Z0-9_]*                      → ident

.                                           → err

# ==============================================================================
# PARSER
# ==============================================================================

@parser

@conflicts = 0

# ==============================================================================
# PROGRAM STRUCTURE
# ==============================================================================

name     = IDENT

program! = body                             → (module ...1)

body     = stmt                             → (1)
         | body NEWLINE stmt                → (...1 3)
         | body NEWLINE                     → 1

block    = INDENT body OUTDENT              → (block ...2)
         | INDENT      OUTDENT              → (block)

stmt     = use
         | decl
         | extvar
         | ext_fun
         | ext_sub
         | zig
         | ":" name stmt                    → (labeled 2 3)
         | simple
         | guarded POST_IF value            → (if 3 1)

guarded  = simple                           → (block 1)

# A simple statement: an expression, a paren-free call, a binding, or a
# flow statement. Only these take a postfix guard (`return x if done`).
simple   = tail
         | postfix "="  tail                → (set _      1 _ 3)
         | postfix "+=" tail                → (set +=     1 _ 3)
         | postfix "-=" tail                → (set -=     1 _ 3)
         | postfix "*=" tail                → (set *=     1 _ 3)
         | postfix "/=" tail                → (set /=     1 _ 3)
         | postfix "%=" tail                → (set %=     1 _ 3)
         | postfix "&=" tail                → (set &=     1 _ 3)
         | postfix "|=" tail                → (set |=     1 _ 3)
         | postfix "^=" tail                → (set ^=     1 _ 3)
         | postfix "<<=" tail               → (set <<=    1 _ 3)
         | postfix ">>=" tail               → (set >>=    1 _ 3)
         | postfix "=!" tail                → (set fixed  1 _ 3)
         | postfix "<-" tail                → (set move   1 _ 3)
         | name ":" type "="  tail          → (set _      1 3 5)
         | name ":" type "=!" tail          → (set fixed  1 3 5)
         | NEW name "=" tail                → (set shadow 2 _ 4)
         | DROP_STMT name                   → (drop 2)
         | RETURN tail                      → (return 2)
         | RETURN                           → (return)
         | BREAK ":" name tail              → (break 4 3)
         | BREAK ":" name                   → (break _ 3)
         | BREAK tail                       → (break 2)
         | BREAK                            → (break)
         | CONTINUE ":" name                → (continue 3)
         | CONTINUE                         → (continue)
         | DEFER block                      → (defer 2)
         | DEFER simple                     → (defer 2)
         | ERRDEFER block                   → (errdefer 2)
         | ERRDEFER simple                  → (errdefer 2)
         | PRE block                        → (pre_block 2)
         | RAW block                        → (raw_block 2)

# ==============================================================================
# DECLARATIONS
# ==============================================================================

decl     = defn
         | PUB defn                         → (pub 2)

defn     = fun | sub | enum | struct | errors | typedef | test

use      = USE name                         → (use 2)

fun      = FUN name params returns block    → (fun 2 3 4 5)
         | FUN name params         block    → (fun 2 3 _ 4)
         | FUN name        returns block    → (fun 2 _ 3 4)
         | FUN name                block    → (fun 2 _ _ 3)

sub      = SUB name params block            → (sub 2 3 _ 4)
         | SUB name        block            → (sub 2 _ _ 3)

returns  = "->" type                        → 2

params   = lparen L(field) ")"              → (...2)
         | lparen          ")"              → ()

lparen   = LPAREN_CALL | "("

# Parameters, struct fields, and enum variants share one shape.
field    = fname                            → 1
         | fname ":" type                   → (: 1 3)
         | fname ":" type "=" expr          → (default 1 3 5)
         | PRE fname ":" type               → (pre_param 2 4)
         | READ_PFX  fname                  → (read 2)        # `?self`
         | WRITE_PFX fname                  → (write 2)       # `!self`

# Inside ( ) the rewriter turns a name followed by `:` into KWARG_NAME.
fname    = name                             → 1
         | KWARG_NAME                       → 1

enum     = ENUM   name        INDENT members OUTDENT → (enum 2 ...4)
         | ENUM   name params INDENT members OUTDENT → (generic_enum 2 3 ...5)
errors   = ERROR  name        INDENT members OUTDENT → (errors 2 ...4)
struct   = STRUCT name        INDENT members OUTDENT → (struct 2 ...4)

typedef  = TYPE name "=" type                          → (type 2 4)
         | TYPE name params INDENT members OUTDENT     → (generic_type 2 3 ...5)
         | TYPE name        INDENT members OUTDENT     → (generic_type 2 _ ...4)

members  = member                           → (1)
         | members NEWLINE member           → (...1 3)
         | members NEWLINE                  → 1

member   = field
         | name "=" expr                    → (valued 1 3)    # enum value: `ok = 200`
         | name params                      → (variant 1 2)   # payload variant: `circle(r: Int)`
         | fun
         | sub
         | DROP dparams block               → (drop_decl 2 3) # `drop self: !Self`

# Sema requires exactly one: `self: !Self`.
dparams  = L(field)                         → (...1)

test     = TEST STRING_DQ block             → (test 2 3)

extvar   = EXTERN name ":" type             → (extern _ 2 4)

ext_fun  = EXTERN FUN name params returns   → (extern_fun 3 4 5)
         | EXTERN FUN name        returns   → (extern_fun 3 _ 4)
         | EXTERN FUN name params           → (extern_fun 3 4 _)
         | EXTERN FUN name                  → (extern_fun 3 _ _)

ext_sub  = EXTERN SUB name params           → (extern_sub 3 4)
         | EXTERN SUB name                  → (extern_sub 3 _)

zig      = ZIG STRING_DQ                    → (zig 2)
         | ZIG STRING_SQ                    → (zig 2)

# ==============================================================================
# TYPES
# ==============================================================================
#
# Suffixes bind tighter than prefixes: `*User?` is a shared optional User;
# an optional shared handle is written `(*User)?`.

type     = READ_PFX  type                   → (borrow_read 2)
         | WRITE_PFX type                   → (borrow_write 2)
         | SHARE_PFX type                   → (shared 2)
         | "~"       type                   → (weak 2)
         | "[" "]" type                     → (slice 3)
         | "[" INTEGER "]" type             → (array_type 2 4)
         | FUN "(" L(type) ")" type         → (fun_type 3 5)   # `fun(Int) Int`
         | FUN "(" ")" type                 → (fun_type _ 4)
         | SUB "(" L(type) ")"              → (fun_type 3)     # `sub(Int)`
         | SUB "(" ")"                      → (fun_type)
         | tsuffix

tsuffix  = tsuffix SUFFIX_Q                 → (optional 1)
         | tsuffix SUFFIX_BANG              → (error_union 1)
         | tatom

tatom    = name
         | name "." name                    → (member 1 3)  # `geo.Point`
         | TYPE                             → 1  # `pre T: type`
         | name LPAREN_CALL L(type) ")"     → (generic_inst 1 ...3)
         | name LPAREN_CALL ")"             → (generic_inst 1)
         | "(" type ")"                     → 2

# ==============================================================================
# EXPRESSIONS
# ==============================================================================
#
#   tail    an expression, a paren-free call, or a closure whose body is one.
#           Allowed where nothing can follow on the line: a statement, the
#           right side of a binding, `return`, a match arm, the last
#           argument of a call.
#   expr    anything that yields a value, including block forms.
#   value   an expression without a block or closure: conditions, operands,
#           ternary branches.

tail     = expr
         | cmd
         | cclosure

expr     = value
         | if
         | while
         | for
         | match
         | try_block
         | logic CATCH BAR_CAPTURE name BAR_CAPTURE block → (catch 1 4 6)
         | closure
         | PRE value                        → (pre 2)

value    = logic TERNARY_IF logic ELSE value → (if 3 1 5)
         | logic CATCH BAR_CAPTURE name BAR_CAPTURE value → (catch 1 4 6)
         | logic CATCH value                 → (catch 1 _ 3)
         | logic

logic    = logic OR conj                    → (or 1 3)
         | conj
conj     = conj AND neg                     → (and 1 3)
         | neg
neg      = NOT neg                          → (not 2)
         | @infix

cond     = value
         | cmd

# --- Paren-free calls ---------------------------------------------------------
#
# `print p.x` is print(p.x); `send encode <packet` is send(encode(<packet)).
# A nested paren-free call can only be the last argument.

cmd      = postfix cmdargs                  → (call 1 ...2)

# These argument lists are written out rather than `L(expr)`: Nexus lists
# are greedy, so `L(expr) "," cmdtail` could never reach its cmdtail.
cmdargs  = exprs                            → 1
         | exprs "," cmdtail                → (...1 3)
         | cmdtail                          → (1)

exprs    = expr                             → (1)
         | exprs "," expr                   → (...1 3)

cmdtail  = cmd
         | cclosure

# --- Control flow -------------------------------------------------------------

# `if e as name` / `while e as name`: `e` is an optional; the body runs
# with `name` bound to the value inside it.
ifcond   = cond
         | value AS name                    → (as 1 3)

if       = IF ifcond block ELSE if          → (if 2 3 5)
         | IF ifcond block ELSE block       → (if 2 3 5)
         | IF ifcond block                  → (if 2 3)

while    = WHILE ifcond            block ELSE block → (while 2 _ 3 else:5)
         | WHILE ifcond ":" simple block ELSE block → (while 2 4 5 else:7)
         | WHILE ifcond            block            → (while 2 _ 3)
         | WHILE ifcond ":" simple block            → (while 2 4 5)

# (for <mode> binding index-or-_ source body else?); the Parser wrapper
# moves a `?xs` / `!xs` / `<xs` source sigil into the mode slot.
for      = FOR SHARE_PFX name          IN cond block ELSE block → (for ptr  3 _ 5 6 else:8)
         | FOR SHARE_PFX name "," name IN cond block ELSE block → (for ptr  3 5 7 8 else:10)
         | FOR           name          IN cond block ELSE block → (for iter 2 _ 4 5 else:7)
         | FOR           name "," name IN cond block ELSE block → (for iter 2 4 6 7 else:9)
         | FOR SHARE_PFX name          IN cond block            → (for ptr  3 _ 5 6)
         | FOR SHARE_PFX name "," name IN cond block            → (for ptr  3 5 7 8)
         | FOR           name          IN cond block            → (for iter 2 _ 4 5)
         | FOR           name "," name IN cond block            → (for iter 2 4 6 7)

match    = MATCH cond INDENT arms OUTDENT   → (match 2 ...4)

arms     = arm                              → (1)
         | arms NEWLINE arm                 → (...1 3)
         | arms NEWLINE                     → 1

arm      = pattern "=>" simple              → (arm 1 3)
         | pattern block                    → (arm 1 2)

pattern  = patatom
         | patatom ".." patatom             → (range_pattern 1 3)

patatom  = name
         | ELSE                             → 1  # default arm
         | INTEGER
         | MINUS_PREFIX INTEGER             → (neg 2)
         | REAL
         | STRING_SQ
         | STRING_DQ
         | TRUE
         | FALSE
         | DOT_LIT name                     → (enum_lit 2)
         | DOT_LIT name LPAREN_CALL L(name) ")" → (variant_pattern 2 ...4)
         | DOT_LIT name LPAREN_CALL ")"     → (variant_pattern 2)

# The value-yielding try block is reserved; sema rejects it.
try_block  = TRY block catch_part           → (try_block 2 3)
           | TRY block                      → (try_block 2)

catch_part = CATCH BAR_CAPTURE name BAR_CAPTURE block → (catch_block 3 5)

# --- Closures -----------------------------------------------------------------
#
# A closure starts with its bar list. An entry with a sigil is a capture;
# a bare name is a parameter, optionally typed:
#   |+x| clone (a copy, for a Copy value)   |<x| move   |~x| weak
#   |a, b| a + b      |+v, a: Int| v.set(a)      || print("tick")
# `*` before the bars makes an owned closure: `*|+v, a| v.set(a)`. The
# parser splits the entries into (captures ...) and the parameter list.

closure  = lambda
         | SHARE_PFX lambda                 → (share 2)

lambda   = bars block                       → (lambda 1 _ _ 2)
         | bars ebody                       → (lambda 1 _ _ 2)

# A closure whose inline body is a paren-free call.
cclosure = clambda
         | SHARE_PFX clambda                → (share 2)

clambda  = bars cbody                       → (lambda 1 _ _ 2)

bars     = BAR_CAPTURE L(barent) BAR_CAPTURE → (...2)
         | BAR_EMPTY                        → ()

barent   = fname                            → 1
         | fname ":" type                   → (: 1 3)
         | CLONE_PFX name                   → (cap_clone 2)
         | MOVE_PFX  name                   → (cap_move 2)
         | "~"       name                   → (cap_weak 2)

# An inline body is wrapped in a block, like an indented one.
ebody    = expr                             → (block 1)
cbody    = cmd                              → (block 1)

# ==============================================================================
# OPERANDS
# ==============================================================================

unary    = MINUS_PREFIX unary               → (neg 2)
         | MOVE_PFX  unary                  → (move 2)
         | CLONE_PFX unary                  → (clone 2)
         | READ_PFX  unary                  → (read 2)
         | WRITE_PFX unary                  → (write 2)
         | SHARE_PFX unary                  → (share 2)
         | "~"       unary                  → (weak 2)
         | PIN_PFX   unary                  → (pin 2)
         | postfix

postfix  = postfix "." name                 → (member 1 3)
         | postfix LBRACKET_INDEX expr "]"  → (index 1 3)
         | postfix LPAREN_CALL args ")"     → (call 1 ...3)
         | postfix SUFFIX_BANG              → (propagate 1)
         | atom

args     = callargs                         → 1
         | callargs "," cmdtail             → (...1 3)
         | cmdtail                          → (1)
         |                                  → ()

callargs = callarg                          → (1)
         | callargs "," callarg             → (...1 3)

callarg  = KWARG_NAME ":" expr              → (kwarg 1 3)
         | expr

atom     = name
         | INTEGER
         | REAL
         | STRING_SQ
         | STRING_DQ
         | TRUE
         | FALSE
         | DOT_LIT name                     → (enum_lit 2)
         | "@" name LPAREN_CALL args ")"    → (builtin 2 ...4)
         | "[" elems "]"                    → (array ...2)
         | "(" tail ")"                     → 2

elems    = L(expr)                          → (...1)
         |                                  → ()

# ==============================================================================
# INFIX OPERATORS (lowest precedence first; operands are `unary`)
# ==============================================================================

@infix unary
    "==" none, "!=" none, "<" none, ">" none, "<=" none, ">=" none
    "??" right
    ".." none
    "|"  left
    "^"  left
    "&"  left
    "<<" left, ">>" left
    "+"  left, "-"  left
    "*"  left, "/"  left, "%"  left
