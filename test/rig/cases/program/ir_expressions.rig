  g = 1.5
  h = "double"
  i = 'single'
  j = true
  k = false
  p = Point(x: 1, y: 2)
  print(scale(?p, 3))
  print(p.x)
  q = Point.new
  v: Vec[Int] = Vec(capacity: 4)
  !v.push(1)
  w = Vec[Int]()
  m = Pair[Int, String].make(1, "x")
  print(check[.strict](5), xs[0], grid[1][2])
  show[3]()
  check[.lax](7)
  print(h[1..3], h[2..], h[..2], h[..], ?xs[a == b..])
