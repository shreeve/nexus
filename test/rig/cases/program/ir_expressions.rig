# Operators, literals, calls, member access, indexing, slices (an open
# side of a range is `_`), and bracket lists of compile-time arguments
# (the grammar builds `index` for one argument and `inst` for more; sema
# tells an index from compile-time arguments).

struct Point
  x: Int
  y: Int

fun scale(p: ?Point, by: Int) -> Int
  p.x * by + p.y * by

