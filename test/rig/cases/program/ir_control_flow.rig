# Statement and expression control flow.

enum Shape
  circle(radius: Int)
  rect(w: Int, h: Int)
  point

fun sign(x: Int) -> Int
  if x > 0
    1
  else if x < 0
    -1
  else
    0

fun area(s: ?Shape) -> Int
  match s
    .circle(r) => return 3 * r * r
    .rect(w, h) => return w * h
    .point => return 0

sub main()
  i = 0
  while i < 3
    i = i + 1
    if i == 2
      continue
    print i

  for n in ?items
    if n > 10
      break
    print n

  size = 5
  match size
    1..3 => print "small"
    4..6 => print "medium"
    else => print "large"

  label = if size > 3
    "big"
  else
    "small"
  word = match size
    5 => "five"
    else => "other"

  if size > 0
    return

sub optionals(m: Int?, v: !Vec(Int))
  if m as x
    print x
  while v.pop() as y
    print y
