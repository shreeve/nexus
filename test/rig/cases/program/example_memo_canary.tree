        (set _ `_` _ (call (member (member `self` `listeners`) `replace`) (move `listeners`)))))
    (fun
      `map`
      ((: `self` (borrow_read `IntSource`)) (: `f` (shared (fun_type (`Int`) `Int`))))
      (shared `IntSource`)
      (block
