      (call `print` (call (member `doubled` `get`)) (call (member `squared` `get`)))
      (call (member `count` `set`) `3`)
      (call (member `count` `set`) `5`)
      (call `print` (call (member `doubled` `get`)) (call (member `squared` `get`))))))
