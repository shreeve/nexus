# A write borrow cannot be taken while a read borrow of the same value
# is live: used later.

struct User
  name: String

sub rename(u: !User)
  print("rename")

sub main()
  user = User(name: "Steve")
  r = ?user
  rename !user
  print(r.name)

# error: cannot write-borrow `user` while a read borrow is live
