# Closures over a shared counter. A stack closure lives in its scope; an
# owned closure (`*|...|`) is a shared handle that can be stored, passed,
# and returned. `|+count|` clones the counter's handle into the closure,
# and dropping the closure's last handle releases it.

fun make_counter(start: Int) -> *fun(Int) Int
  count: *Cell(Int) = *Cell(value: start)
  *|+count, step|
    count.set(count.get() + step)
    count.get()

sub main()
  count: *Cell(Int) = *Cell(value: 0)
  bump = |+count| count.set(count.get() + 1)
  bump()
  bump()
  print(count.get())

  next = make_counter(100)
  print(next(1), next(10))

# expect:
# 2
# 101 111
