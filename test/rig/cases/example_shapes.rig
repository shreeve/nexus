# Data modeling: payload enums, exhaustive `match`, methods, and a generic type.

enum Shape
  circle(radius: Int)
  rect(w: Int, h: Int)
  point

fun area(s: ?Shape) -> Int
  match s
    .circle(r) => return 3 * r * r
    .rect(w, h) => return w * h
    .point => return 0

struct Canvas
  width: Int
  height: Int

  fun fits(?self, s: ?Shape) -> Bool
    area(s) <= self.width * self.height

type Pair(T)
  left: T
  right: T

sub main()
  shapes: Pair(Shape) = Pair(left: .circle(radius: 2), right: .rect(w: 3, h: 5))
  print(area(?shapes.left))
  print(area(?shapes.right))

  canvas = Canvas(width: 4, height: 3)
  print(canvas.fits(?shapes.left))
  print(canvas.fits(?shapes.right))

# expect:
# 12
# 15
# true
# false
