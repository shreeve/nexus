# `pop` removes a Vec's last element and hands it over: the caller owns
# the handle, bound by `as` or to a name (and dropped there), or discarded
# with `_ =`.

struct B
  n: Int

  drop self: !B
    print("drop", self.n)

sub main()
  v: Vec(*B) = Vec()
  for i in 0..4
    (!v).push(*B(n: i))
  x = (!v).pop()
  print(x == none)
  if (!v).pop() as y
    print("y", y.n)
  _ = (!v).pop()
  while (!v).pop() as z
    print("z", z.n)
  print("end", v.length())

# expect:
# false
# y 2
# drop 2
# drop 1
# z 0
# drop 0
# end 0
# drop 3
