(module
  (use `lib`)
  (sub
    `main`
    ()
    _
    (block
      (set _ `x` _ (call (member `lib` `make`) `1`))
      (set _ `w` _ (weak `x`))
      (set _ `s` _ (call (member `lib` `slot`) `2`))
