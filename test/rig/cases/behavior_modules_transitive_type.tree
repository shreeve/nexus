        (arm (enum_lit `empty`) (call `print` `"empty"`)))
      (set _ `p` _ (call (member `lib` `plain`) `3`))
      (set _ `q` _ (move `p`))
      (call `print` (call (member `x` `get`)) (member `q` `n`)))))
