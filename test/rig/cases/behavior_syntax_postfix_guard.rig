# `stmt if cond` runs the statement only when `cond` holds. Any simple
# statement takes a guard: a paren-free call, a call, `return`, `break`.

fun first_big(limit: Int) -> Int
  i = 0
  while i < 100
    i += 1
    break if i > limit
  return i

sub main()
  x = 5
  print x if x > 3
  print(99) if x > 9
  print first_big(3)

# expect:
# 5
# 4
