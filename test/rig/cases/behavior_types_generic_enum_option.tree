(module
  (generic_enum `Option` (`T`) (variant `some` ((: `value` `T`))) `none`)
  (sub
    `main`
    ()
    _
    (block
      (set _ `o` (generic_inst `Option` `Int`) (call (enum_lit `some`) (kwarg `value` `5`)))
      (match
        `o`
        (arm (variant_pattern `some` `v`) (call `print` `v`))
        (arm (enum_lit `none`) (call `print` `"nothing"`))))))
