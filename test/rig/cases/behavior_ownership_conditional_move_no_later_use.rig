# A value moved on one path and not used afterwards is fine; the
# auto-drop guard releases it only on the path where it was not moved.

struct Wrap
  payload: Int

  drop(!self)
    print("drop")

sub eat(rc: *Wrap)
  print(rc.payload)

sub go(c: Bool)
  rc = *Wrap(payload: 1)
  if c
    eat(<rc)
  print("after")

sub main()
  go(true)
  go(false)

# expect:
# 1
# drop
# after
# after
# drop
