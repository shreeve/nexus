# deep_tree with a node store (--spans): every list of the chain is a node,
# and `writeFacts` walks the tree a million levels deep, as `Sexp.write`
# does, with its stack on the heap.
#
# The case file holds N; the lang module's Parser builds the input
# `x+x+...+x`, parses it, walks the tree, and returns a summary string.

@lexer
tokens
    ident
    plus
    eof
    err
'+'                                         → plus
[a-z]+                                      → ident
.                                           → err

@parser
@lang = "deep_tree_spans"

prog! = sum                                 → (prog 1)
sum   = sum "+" IDENT                       → (1 3)
      | IDENT
