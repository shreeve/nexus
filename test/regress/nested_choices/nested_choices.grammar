# A choice inside a [...] group or inside another choice becomes a
# synthesized rule, like a repeated choice: its value is the chosen
# alternative's value.

@lexer
tokens
    ident
    integer
    eq
    colon
    plus
    eof
    err
# (spaces and tabs are consumed by the lexer as leading whitespace)
'='                                         → eq
':'                                         → colon
'+'                                         → plus
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@lang = "nested_choices"

program! = IDENT ["+" (IDENT | INTEGER)]    → (p 1 3)
         | "=" (IDENT | (INTEGER | ":"))    → (q 2)
         | ":" [(IDENT | INTEGER)]          → (r 2)
