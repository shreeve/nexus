# A parser literal names the lexer rule that matches exactly its text:
# escapes decoded as in patterns ("\x41" is 'A'), and at any length.

@lexer
tokens
    upper
    long
    ident
    eof
    err
'A'                                         → upper
'' → long
[a-z]+                                      → ident
.                                           → err

@parser
s! = "\x41" "" IDENT → (s 1 2 3)
