# An `X "c"` hint names the terminal the lexer produces for "c", even when
# the grammar spells that terminal as a token (LPAREN for '('): a "("
# touching a name opens a call, a spaced one starts a new expression.

@lexer
tokens
    ident
    lparen
    rparen
    eof
    err
'\n'                                        → skip, skip
'('                                         → lparen
')'                                         → rparen
[a-z]+                                      → ident
.                                           → err

@parser

exprs! = expr+                              → (exprs ...1)

expr   = IDENT X "("                        → (var 1)
       | IDENT LPAREN expr RPAREN           → (call 1 3)
       | LPAREN expr RPAREN                 → 2
