# compile-error: STOPP
#
# With `@as IDENT = [kw]` and a @lang module, an uppercase terminal that is
# not a lexer token reaches the parser only as a member of the group's Id
# enum (`KwId`). A terminal no group can produce (here the misspelled
# STOPP; KwId has STOP) makes the generated parser fail to build with a
# message naming it (or generation fails naming it).

@lexer
tokens
    ident
    eof
    err
[a-z]+                                      → ident
.                                           → err

@parser
@lang = "as_unknown_keyword"
@as IDENT = [kw]

prog! = item+                               → (prog ...1)
item  = STOPP                               → (stop 1)
      | GO                                  → (go 1)
      | IDENT
