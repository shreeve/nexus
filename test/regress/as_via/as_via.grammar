# generated-has: lang.lookupKeyword(text)
#
# `@as TOKEN via fn` names the lang lookup function explicitly: identifiers
# are promoted through `lookupKeyword` (not the `<group>As` convention), and
# the ordinal it returns becomes the keyword's src.id.
# (SPEC §8.6)

@lexer
tokens
    ident
    integer
    newline
    eof
    err
'\n'                                        → newline
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser
@lang = "as_via"

@as IDENT = [kw via lookupKeyword]

program! = lines                            → (program ...1)
lines    = line                             → (1)
         | lines NEWLINE line               → (...1 3)
         | lines NEWLINE                    → 1
line     = GO INTEGER                       → (go 1 2)
         | STOP                             → (stop 1)
         | IDENT                            → (name 1)
