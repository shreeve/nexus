# An `X "c"` hint takes the `@op` mapping of "c" as a parser literal "c"
# would: no lexer rule's pattern is exactly "(", and `@op` makes it the
# token lparen, so the hint names LPAREN.

@op = [ "(" → "lparen" ]

@lexer
tokens
    ident
    lparen
    rparen
    eof
    err
'\n'                                        → skip, skip
[(]+                                        → lparen
')'                                         → rparen
[a-z]+                                      → ident
.                                           → err

@parser

exprs! = expr+                              → (exprs ...1)

expr   = IDENT X "("                        → (var 1)
       | IDENT LPAREN expr RPAREN           → (call 1 3)
       | LPAREN expr RPAREN                 → 2
