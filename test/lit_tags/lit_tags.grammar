# lit_tags.grammar — literal Tag values at action child positions.
#
#   1. A letter-start child Tag literal (`fixed`, `move`) is emitted as
#      `.{ .tag = .@"fixed" }` in its child slot.
#
#   2. An operator-name child Tag literal (`+=`) is validated as a tag name
#      and emitted without any `key:val` annotation leaking into the name.
#
# The grammar has no @lang, so the Tag enum is collected from the actions,
# child-position Tag literals included.

@lexer

tokens
    ident
    integer
    assign
    plus_assign
    arrow
    newline
    eof
    err

'+='                                        → plus_assign
'='                                         → assign
'->'                                        → arrow
'\n'                                        → newline
[0-9]+                                      → integer
[a-zA-Z_][a-zA-Z0-9_]*                      → ident
.                                           → err

@parser


program! = body                             → (module ...1)

body     = stmt                             → (1)
         | body NEWLINE stmt                → (...1 3)
         | body NEWLINE                     → 1

# Letter-start child Tag literals route through the simple-case emit path.
# Operator-name child Tag literal routes through the complex-case path
# (because the dispatcher classifies `+=` as `hasOther`, forcing complex).
stmt     = IDENT "=" INTEGER                → (set fixed 1 _ 3)
         | IDENT "->" INTEGER               → (set move 1 _ 3)
         | IDENT "+=" INTEGER               → (set += 1 _ 3)
