# lists.grammar — the synthesized lists `X*`, `X+`, `L(X)`, `L(X, sep)`
# and `L(X?)` without a schema: one item per element, nils included
# (a list printed whole keeps its trailing nils), and memory linear in
# the list's length (lists.zig).

@lexer

tokens
    ident
    star
    plus
    comma
    slash
    query
    equals
    minus
    semi
    eof
    err

'*'                                         → star
'+'                                         → plus
','                                         → comma
'/'                                         → slash
'?'                                         → query
'='                                         → equals
'-'                                         → minus
';'                                         → semi
'\n'                                        → skip, skip
[a-z]+                                      → ident
.                                           → err

@parser

@lang = "lists"

top!  = form*                               → (top ...1)

form  = "*" IDENT* ";"                      → (star 2)
      | "+" IDENT+ ";"                      → (plus 2)
      | "," L(IDENT) ";"                    → (list 2)
      | "/" L(IDENT, "/") ";"               → (sep 2)
      | "?" L(IDENT?) ";"                   → (opt 2)
      | "=" (IDENT | !"-")* ";"             → (nils 2)
