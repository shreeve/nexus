(routine
  (label `ALIAS`)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` ` _ (do _ (call (ref `START` _ `TEST`) ((expr (str `"compliance/locals/ALIAS"`))))))
  (` `)
  (` `)
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"alias mutation visible"`))
          (expr (str `"mutated"`))
          (expr (str `"$$BASIC^ALIAS()"`))))))
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"alias preserves value if no write"`))
          (expr (num `42`))
          (expr (str `"$$READONLY^ALIAS()"`))))))
  (` `)
  (` `)
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"by-value: caller unchanged"`))
          (expr (str `"orig"`))
          (expr (str `"$$BYVAL^ALIAS()"`))))))
  (` `)
  (` `)
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"alias subtree mutation"`))
          (expr (num `1`))
          (expr (str `"$$SUBTREE^ALIAS()"`))))))
  (` `)
  (` `)
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"two aliases swap"`)) (expr (num `1`)) (expr (str `"$$DOSWAP^ALIAS()"`))))))
  (` `)
  (` `)
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"alias multi-write"`)) (expr (num `6`)) (expr (str `"$$MULTI^ALIAS()"`))))))
  (` `)
  (` `)
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"alias read"`)) (expr (num `100`)) (expr (str `"$$READ^ALIAS()"`))))))
  (` `)
  (` ` _ (do _ (call (ref `END` _ `TEST`) ((expr (str `"compliance/locals/ALIAS"`))))))
  (` ` _ (quit))
  (` `)
  (label
    `BASIC`
    _
    ((new _ `x`)
      (set _ (= (lvar `x`) (expr (str `"orig"`))))
      (do _ (call (ref `MUT`) ((byref `x`))))))
  (` ` _ (quit _ (expr (lvar `x`))))
  (label `MUT` (`p`) ((set _ (= (lvar `p`) (expr (str `"mutated"`))))))
  (` ` _ (quit))
  (` `)
  (label
    `READONLY`
    _
    ((new _ `x`) (set _ (= (lvar `x`) (expr (num `42`)))) (do _ (call (ref `NOMUT`) ((byref `x`))))))
  (` ` _ (quit _ (expr (lvar `x`))))
  (label `NOMUT` (`p`) ((new _ `v`) (set _ (= (lvar `v`) (expr (lvar `p`))))))
  (` ` _ (quit))
  (` `)
  (label
    `BYVAL`
    _
    ((new _ `x`)
      (set _ (= (lvar `x`) (expr (str `"orig"`))))
      (do _ (call (ref `MUT2`) ((expr (lvar `x`)))))))
  (` ` _ (quit _ (expr (lvar `x`))))
  (label `MUT2` (`p`) ((set _ (= (lvar `p`) (expr (str `"mutated"`))))))
  (` ` _ (quit))
  (` `)
  (label
    `SUBTREE`
    _
    ((new _ `x`)
      (set _ (= (lvar `x` ((expr (str `"a"`)))) (expr (num `0`))))
      (do _ (call (ref `INCSUB`) ((byref `x`))))))
  (` ` _ (quit _ (expr (lvar `x` ((expr (str `"a"`)))))))
  (label
    `INCSUB`
    (`p`)
    ((set
       _
       (= (lvar `p` ((expr (str `"a"`)))) (expr (lvar `p` ((expr (str `"a"`)))) (`+` (num `1`)))))))
  (` ` _ (quit))
  (` `)
  (label
    `DOSWAP`
    _
    ((new _ `a` `b`)
      (set _ (= (lvar `a`) (expr (num `1`))) (= (lvar `b`) (expr (num `2`))))
      (do _ (call (ref `DSWAP`) ((byref `a`) (byref `b`))))))
  (` `)
  (` ` _ (quit _ (expr (lvar `b`))))
  (label
    `DSWAP`
    (`p` `q`)
    ((new _ `t`)
      (set
        _
        (= (lvar `t`) (expr (lvar `p`)))
        (= (lvar `p`) (expr (lvar `q`)))
        (= (lvar `q`) (expr (lvar `t`))))))
  (` ` _ (quit))
  (` `)
  (label
    `MULTI`
    _
    ((new _ `a` `b` `c`) (do _ (call (ref `ASSIGN3`) ((byref `a`) (byref `b`) (byref `c`))))))
  (` ` _ (quit _ (expr (lvar `a`) (`+` (lvar `b`)) (`+` (lvar `c`)))))
  (label
    `ASSIGN3`
    (`p` `q` `r`)
    ((set
       _
       (= (lvar `p`) (expr (num `1`)))
       (= (lvar `q`) (expr (num `2`)))
       (= (lvar `r`) (expr (num `3`))))))
  (` ` _ (quit))
  (` `)
  (label
    `READ`
    _
    ((new _ `x`)
      (set _ (= (lvar `x`) (expr (num `100`))))
      (new _ `r`)
      (do _ (call (ref `READIT`) ((byref `x`) (byref `r`))))))
  (` ` _ (quit _ (expr (lvar `r`))))
  (label `READIT` (`src` `out`) ((set _ (= (lvar `out`) (expr (lvar `src`))))))
  (` ` _ (quit)))
