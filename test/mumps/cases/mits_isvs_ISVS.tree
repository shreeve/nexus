  (` ` _ (quit))
  (` `)
  (label `TT` _ ((if (expr (num `1`))) (quit _ (expr (intrinsic `T`#221)))))
  (` ` _ (quit _ (expr (`-` (num `1`)))))
  (` `)
  (label `TF` _ ((if (expr (num `0`)))))
  (` ` _ (quit _ (expr (intrinsic `T`#221))))
  (` `)
  (label `TP` _ ((new _ `x`) (if (expr (num `1`))) (set _ (= (lvar `x`) (expr (num `1`))))))
