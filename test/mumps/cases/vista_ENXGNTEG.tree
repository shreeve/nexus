(routine
  (label `ENXGNTEG`)
  (` `)
  (` `)
  (` `
    _
    (set _ (= (lvar `XT4`) (expr (str `"I 1"`))) (= (lvar `X`) (expr (text _ (expr (num `3`))))))
    (write
      _
      (posformat `!` `!`)
      (expr (str `"Checksum routine created on "`))
      (expr (intrinsic `P`#212 ((expr (lvar `X`)) (expr (str `";"`)) (expr (num `4`)))))
      (expr (str `" by KERNEL V"`))
      (expr (intrinsic `P`#212 ((expr (lvar `X`)) (expr (str `";"`)) (expr (num `3`)))))
      (posformat `!`)))
  (label
    `CONT`
    _
    ((for (lvar `XT1`) (range (expr (num `1`)) (expr (num `1`))))
      (set _ (= (lvar `XT2`) (expr (text `ROU` (expr (lvar `XT1`))))))
      (quit (postcond (expr (lvar `XT2`) (`=` (str `""`)))))
      (set
        _
        (=
          (lvar `X`)
          (expr (intrinsic `P`#212 ((expr (lvar `XT2`)) (expr (str `" "`)) (expr (num `1`))))))
        (=
          (lvar `XT3`)
          (expr (intrinsic `P`#212 ((expr (lvar `XT2`)) (expr (str `";"`)) (expr (num `3`)))))))
      (xecute _ ((expr (lvar `XT4`))))
      (if (expr (intrinsic `T`#221)))
      (write _ (posformat `!`) (expr (lvar `X`)))
      (xecute _ ((expr (gvar `%ZOSF` ((expr (str `"TEST"`)))))))
      (set (postcond (expr (`'` (intrinsic `T`#221)))) (= (lvar `XT3`) (expr (num `0`))))
      (xecute (postcond (expr (lvar `XT3`))) ((expr (gvar `%ZOSF` ((expr (str `"RSUM"`)))))))
      (write
        _
        (? (expr (num `10`)))
        (expr
          (select
            ((expr (`'` (lvar `XT3`))) (expr (str `"Routine not in UCI"`)))
            ((expr (lvar `XT3`) (`'=` (lvar `Y`)))
              (expr
                (str `"Calculated "`)
                (`_` (intrinsic `C`#201 ((expr (num `7`)))))
                (`_` (lvar `Y`))
                (`_` (str `", off by "`))
                (`_` (expr (lvar `Y`) (`-` (lvar `XT3`))))))
            ((expr (num `1`)) (expr (str `"ok"`))))))))
  (` `)
  (` `
    _
    (kill
      _
      (lvar `%1`)
      (lvar `%2`)
      (lvar `%3`)
      (lvar `X`)
      (lvar `Y`)
      (lvar `XT1`)
      (lvar `XT2`)
      (lvar `XT3`)
      (lvar `XT4`))
    (quit))
  (label
    `ONE`
    _
    ((set
       _
       (= (lvar `XT4`) (expr (str `"I $D(^UTILITY($J,X))"`)))
       (= (lvar `X`) (expr (text _ (expr (num `3`))))))
      (write
        _
        (posformat `!` `!`)
        (expr (str `"Checksum routine created on "`))
        (expr (intrinsic `P`#212 ((expr (lvar `X`)) (expr (str `";"`)) (expr (num `4`)))))
        (expr (str `" by KERNEL V"`))
        (expr (intrinsic `P`#212 ((expr (lvar `X`)) (expr (str `";"`)) (expr (num `3`)))))
        (posformat `!`))))
  (` `
    _
    (write _ (posformat `!`) (expr (str `"Check a subset of routines:"`)))
    (kill _ (gvar `UTILITY` ((expr (intrinsic `J`#208)))))
    (xecute _ ((expr (gvar `%ZOSF` ((expr (str `"RSEL"`))))))))
  (` ` _ (write _ (posformat `!`)) (goto _ ((ref `CONT`))))
  (label `ROU`)
  (label `ENEQ1`)
  (label `ENEQ2`)
  (label `ENEQ3`)
