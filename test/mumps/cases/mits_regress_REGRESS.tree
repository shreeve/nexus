  (` ` _ (quit _ (expr (str `"ok"`))))
  (` `)
  (label `NESTSTRESS` _ ((new _ `r` `A` `C`)))
  (` `)
  (` ` _ (set _ (= (lvar `C`) (expr (str `"$$INNER2^REGRESS()"`)))))
  (` ` _ (xecute _ ((expr (str `"S A="`) (`_` (lvar `C`))))))
  (` ` _ (quit _ (expr (lvar `A`))))
  (` `)
  (label `INNER2` _ ((new _ `i` `x`)))
  (` `
    _
