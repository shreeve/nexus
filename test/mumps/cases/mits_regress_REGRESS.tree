(routine
  (label `REGRESS`)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` ` _ (do _ (call (ref `START` _ `TEST`) ((expr (str `"compliance/regress/REGRESS"`))))))
  (` `)
  (` `)
  (` `)
  (` `)
  (` `)
  (` `
    _
    (do
      _
      (call
        (ref `RUN` _ `TEST`)
        ((expr (str `"ac8b68a indir UAF: 50x repeated XECUTE"`))
