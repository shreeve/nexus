    (xecute _ ((expr (str `"S x="`) (`_` (lvar `i`))))))
  (` ` _ (quit _ (expr (str `"ok"`))))
  (` `)
  (label `LITLOOP` _ ((new _ `i` `s`) (set _ (= (lvar `s`) (expr (num `0`))))))
  (` `
    _
    (for (lvar `i`) (range (expr (num `1`)) (expr (num `1`)) (expr (num `1000000`))))
    (set _ (= (lvar `s`) (expr (lvar `s`) (`+` (num `1`))))))
  (` ` _ (quit _ (expr (lvar `s`))))
  (` `)
  (label `FORHOT` _ ((new _ `i` `c`) (set _ (= (lvar `c`) (expr (num `0`))))))
  (` `
    _
    (for (lvar `i`) (range (expr (num `1`)) (expr (num `1`)) (expr (num `100000`))))
    (set _ (= (lvar `c`) (expr (lvar `c`) (`+` (num `1`))))))
  (` ` _ (quit _ (expr (lvar `c`)))))
