  (` `)
  (` ` _ (do _ (call (ref `END` _ `TEST`) ((expr (str `"compliance/regress/REGRESS"`))))))
  (` ` _ (quit))
  (` `)
  (label `INDIRUAF` _ ((new _ `i` `result`) (set _ (= (lvar `result`) (expr (num `0`))))))
  (` ` _ (new _ `c`) (set _ (= (lvar `c`) (expr (str `"S y=42"`)))))
  (` `)
  (` `
    _
    (for (lvar `i`) (range (expr (num `1`)) (expr (num `1`)) (expr (num `50`))))
    (xecute _ ((expr (lvar `c`))))
    (set _ (= (lvar `result`) (expr (lvar `result`) (`+` (num `1`))))))
  (` ` _ (quit _ (expr (lvar `result`))))
  (` `)
  (label `INCRET` _ ((new _ `x`)))
  (` ` _ (quit _ (expr (intrinsic `I`#207 ((expr (lvar `x`)))))))
  (` `)
  (label
    `INCMUT`
    _
    ((new _ `x`) (set _ (= (lvar `r`) (expr (intrinsic `I`#207 ((expr (lvar `x`)))))))))
  (` ` _ (quit _ (expr (lvar `x`))))
  (` `)
  (label `CACHEHOLD` _ ((new _ `r` `A` `C`)))
  (` `)
  (` ` _ (set _ (= (lvar `C`) (expr (str `"$$INNER1^REGRESS()"`)))))
  (` ` _ (xecute _ ((expr (str `"S A="`) (`_` (lvar `C`))))))
  (` ` _ (quit _ (expr (lvar `A`))))
  (` `)
  (label `INNER1` _ ((new _ `i` `x`)))
  (` `
    _
    (for (lvar `i`) (range (expr (num `1`)) (expr (num `1`)) (expr (num `10000`))))
