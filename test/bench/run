#!/bin/bash
# Nexus benchmarks: generation time per grammar, and lexing / lexing+parsing
# throughput of generated parsers on large inputs. Record results in
# test/bench/BASELINE.md.
#
# Usage:
#   test/bench/run [-O mode] [-n rounds] [--nexus BIN] [gen|parse]...
#
#   -O mode     optimize mode for nexus and the parsers (default ReleaseFast)
#   -n rounds   generation runs per grammar / throughput rounds (default 20 / 5)
#   --nexus BIN benchmark this generator instead of building the checkout;
#               `legacy` = Nexus 0.10.3 (test/lib/legacy-nexus)
#   gen|parse   run only that part (default both)
#
# Inputs (MUMPS_CORPUS and RIG_CORPUS override the defaults):
#   MUMPS  every .m file under ~/Data/Code/em/misc/vista (VistA, ~90 MB),
#          else test/mumps/cases
#   Rig    a synthetic file of Rig's behavior tests and examples concatenated
#          to ~4 MB (~/Data/Code/rig), else test/rig/cases
# Parsers are generated by the benchmarked nexus. Timings are the best of
# the rounds, single-threaded.

set -uo pipefail
cd "$(dirname "$0")/../.."
ROOT=$(pwd)
LIB="$ROOT/test/lib"
OUT="$ROOT/.zig-cache/nexus-test/bench"
MODE=ReleaseFast GEN_N=20 PARSE_N=5 NEXUS_ARG="" PARTS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -O) MODE=$2; shift ;;
        -n) GEN_N=$2; PARSE_N=$2; shift ;;
        --nexus) NEXUS_ARG=$2; shift ;;
        gen|parse) PARTS+=("$1") ;;
        -h|--help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done
[[ ${#PARTS[@]} -eq 0 ]] && PARTS=(gen parse)
want() { local p; for p in "${PARTS[@]}"; do [[ $p == "$1" ]] && return 0; done; return 1; }
mkdir -p "$OUT"

# --- The generator -----------------------------------------------------------
if [[ -z "$NEXUS_ARG" ]]; then
    echo "building nexus -O $MODE" >&2
    rm -rf "$OUT/nexus"
    zig build -Doptimize="$MODE" --prefix "$OUT/nexus/zig-out" >&2 || exit 1
    NEXUS="$OUT/nexus/bin/nexus"
elif [[ $NEXUS_ARG == legacy ]]; then
    NEXUS=$("$LIB/legacy-nexus") || exit 1
else
    NEXUS=$(cd "$(dirname "$NEXUS_ARG")" && echo "$(pwd)/$(basename "$NEXUS_ARG")")
fi

echo "# $(date '+%Y-%m-%d') · $(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -m) · zig $(zig version) · -O $MODE"
echo "# nexus: $NEXUS ($(cd "$ROOT" && git rev-parse --short HEAD))"

# --- Generation time ---------------------------------------------------------
# grammar name → path (relative to the checkout)
GRAMMARS=(
    "mumps test/mumps/mumps.grammar"
    "ruby test/ruby/ruby.grammar"
    "rig test/rig/rig.grammar"
    "zag test/zag/zag.grammar"
    "slash test/slash/slash.grammar"
    "nexis test/nexis/nexis.grammar"
    "nexus nexus.grammar"
    "features test/features/features.grammar"
    "basic test/basic/basic.grammar"
    "lit_tags test/lit_tags/lit_tags.grammar"
)

if want gen; then
    echo
    echo "## Generation time ($GEN_N runs each, wall clock including process start)"
    echo
    echo "| grammar | mean ms | min ms | output lines | output KB |"
    echo "|---|---:|---:|---:|---:|"
    for entry in "${GRAMMARS[@]}"; do
        read -r name path <<<"$entry"
        dir=$(dirname "$path") file=$(basename "$path")
        tmp="$OUT/gen_$name.zig"
        (cd "$dir" && "$NEXUS" "$file" "$tmp") >/dev/null 2>&1
        [[ -s "$tmp" ]] || { echo "| $name | generation failed | | | |"; continue; }
        perl -MTime::HiRes=time -e '
            my ($n, $dir, $nexus, $file, $tmp) = @ARGV;
            chdir $dir or die;
            my ($sum, $min) = (0, 1e9);
            for (1..$n) {
                my $t = time;
                system("$nexus \Q$file\E \Q$tmp\E >/dev/null 2>&1");
                my $d = (time - $t) * 1000;
                $sum += $d; $min = $d if $d < $min;
            }
            printf "%.1f %.1f\n", $sum / $n, $min;
        ' "$GEN_N" "$dir" "$NEXUS" "$file" "$tmp" | {
            read -r mean min
            printf '| %s | %s | %s | %d | %d |\n' "$name" "$mean" "$min" "$(wc -l <"$tmp")" "$(( $(wc -c <"$tmp") / 1024 ))"
        }
    done
fi

# --- Throughput --------------------------------------------------------------
build_parser() { # build_parser <name> <grammar> [lang files...]
    local name=$1 grammar=$2
    shift 2
    if ! "$LIB/build-grammar" "$NEXUS" "$grammar" "$OUT/$name" -O "$MODE" "$@"; then
        echo "cannot build the $name parser (see $OUT/$name/*.log)" >&2
        return 1
    fi
}

throughput() { # throughput <name> <start> <list>
    local name=$1 start=$2 list=$3 r
    r=$("$OUT/$name/driver" --start "$start" --bench "$PARSE_N" --list "$list") || return 1
    local files ok bytes tokens lex_ms lex_mb_s parse_ms parse_mb_s mtok_s
    eval "$r" # files= ok= bytes= tokens= lex_ms= lex_mb_s= parse_ms= parse_mb_s= mtok_s=
    printf '| %s | %s | %.1f | %s | %s | %s | %s | %s | %s |\n' "$name" "$files" \
        "$(awk -v b="$bytes" 'BEGIN{print b/1048576}')" "$tokens" "$lex_ms" "$lex_mb_s" "$parse_ms" "$parse_mb_s" "$ok"
}

if want parse; then
    MUMPS_CORPUS=${MUMPS_CORPUS:-$HOME/Data/Code/em/misc/vista}
    RIG_CORPUS=${RIG_CORPUS:-$HOME/Data/Code/rig}

    # MUMPS list
    if [[ -d "$MUMPS_CORPUS" ]]; then
        find "$MUMPS_CORPUS" -type f -name '*.m' | LC_ALL=C sort >"$OUT/mumps.list"
    else
        ls "$ROOT"/test/mumps/cases/*.m >"$OUT/mumps.list"
    fi

    # Synthetic Rig file: behavior tests + examples, repeated to ~4 MB.
    big="$OUT/big.rig"
    if [[ -d "$RIG_CORPUS/test/behavior" ]]; then
        find "$RIG_CORPUS/test/behavior" "$RIG_CORPUS/examples" -name '*.rig' | LC_ALL=C sort >"$OUT/rig.src"
    else
        ls "$ROOT"/test/rig/cases/*.rig >"$OUT/rig.src"
    fi

    build_parser mumps test/mumps/mumps.grammar test/mumps/mumps.zig || exit 1
    build_parser rig test/rig/rig.grammar test/rig/rig.zig test/rig/ir.zig test/rig/diag.zig || exit 1

    # Keep only the Rig sources that parse on their own, then repeat them.
    "$OUT/rig/driver" --start parseTree --hash --list "$OUT/rig.src" 2>/dev/null |
        awk -F'\t' '$2 == "ok" { print $1 }' >"$OUT/rig.ok"
    : >"$big"
    while [[ $(wc -c <"$big") -lt 4000000 ]]; do
        while read -r f; do cat "$f"; echo; done <"$OUT/rig.ok" >>"$big"
    done
    echo "$big" >"$OUT/big.list"
    if ! "$OUT/rig/driver" --start parseTree --hash "$big" 2>/dev/null | grep -q $'\tok\t'; then
        echo "note: the synthetic Rig file does not parse; its parse numbers stop at the error" >&2
    fi

    echo
    echo "## Lexing and parsing throughput (best of $PARSE_N, one thread, input in memory)"
    echo
    echo "lex = lang Lexer wrapper over the generated BaseLexer, every token; parse = lex + parse + tree build."
    echo
    echo "| input | files | MB | tokens | lex ms | lex MB/s | parse ms | parse MB/s | parsed ok |"
    echo "|---|---:|---:|---:|---:|---:|---:|---:|---:|"
    throughput mumps parseRoutine "$OUT/mumps.list"
    throughput rig parseTree "$OUT/big.list"
fi
