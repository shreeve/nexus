(grammar
  (rule (start `program`) (alt _ ((ref `body`)) (node `module` (spread `1`))))
  (rule (start `expr`) (alt _ ((ref `expr`)) (pos `1`)))
  (rule (name `name`) (alt _ ((tok `IDENT`))))
  (rule
    (name `body`)
    (alt _ ((ref `stmt`)) (list (pos `1`)))
    (alt _ ((ref `body`) (tok `NEWLINE`) (ref `stmt`)) (list (spread `1`) (pos `3`)))
    (alt _ ((ref `body`) (tok `NEWLINE`)) (pos `1`))
    (alt _ () (list)))
  (rule
    (name `stmt`)
    (alt _ ((ref `expr`)))
    (alt _ ((lit `"return"`) (ref `expr`)) (node `return` (pos `2`)))))
